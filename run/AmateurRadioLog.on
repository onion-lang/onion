import {
  java.util.LinkedHashMap
}

// ── Enumerations ─────────────────────────────────────────────────────────────

enum Band {
  BAND_160M, BAND_80M, BAND_40M, BAND_20M, BAND_15M, BAND_10M, BAND_6M, BAND_2M
  public:
    def displayName(): String = select this {
      case Band::BAND_160M: "160m"
      case Band::BAND_80M:  "80m"
      case Band::BAND_40M:  "40m"
      case Band::BAND_20M:  "20m"
      case Band::BAND_15M:  "15m"
      case Band::BAND_10M:  "10m"
      case Band::BAND_6M:   "6m"
      case Band::BAND_2M:   "2m"
      else:                  "?"
    }
    def frequencyMHz(): Double = select this {
      case Band::BAND_160M: 1.8
      case Band::BAND_80M:  3.5
      case Band::BAND_40M:  7.0
      case Band::BAND_20M:  14.0
      case Band::BAND_15M:  21.0
      case Band::BAND_10M:  28.0
      case Band::BAND_6M:   50.0
      case Band::BAND_2M:   144.0
      else:                  0.0
    }
    def isHF(): Boolean = select this {
      case Band::BAND_6M:  false
      case Band::BAND_2M:  false
      else:                true
    }
}

enum Mode {
  CW, SSB, FT8, RTTY, PSK31, AM, FM
  public:
    def isDigital(): Boolean = select this {
      case Mode::FT8:   true
      case Mode::RTTY:  true
      case Mode::PSK31: true
      else:             false
    }
    def typicalRST(): Int = select this {
      case Mode::CW:  599
      case Mode::FT8: 599
      else:           59
    }
}

enum Continent {
  NA, SA, EU, AF, AS, OC, AN
  public:
    def fullName(): String = select this {
      case Continent::NA: "North America"
      case Continent::SA: "South America"
      case Continent::EU: "Europe"
      case Continent::AF: "Africa"
      case Continent::AS: "Asia"
      case Continent::OC: "Oceania"
      case Continent::AN: "Antarctica"
      else:               "Unknown"
    }
}

// ── Records ───────────────────────────────────────────────────────────────────

record QSO(callsign: String, band: Band, mode: Mode, date: String, rstSent: Int, rstRecv: Int, entity: String, continent: Continent) {
  public:
    def display(): String = "#{date} #{callsign} #{band.displayName()} #{mode} #{entity}"
    def bandModeKey(): String = band.displayName() + "/" + mode
    def isHFContact(): Boolean = band.isHF()
    def isDigitalContact(): Boolean = mode.isDigital()
}

record DXEntity(prefix: String, name: String, continent: Continent, cqZone: Int) {
  public:
    def display(): String = "#{prefix} - #{name} (#{continent.fullName()}, CQ#{cqZone})"
}

record AwardProgress(awardName: String, needed: Int, confirmed: Int) {
  public:
    def pct(): Int = if needed == 0 { 0 } else { (confirmed * 100) / needed }
    def display(): String = "#{awardName}: #{confirmed}/#{needed} (#{pct()}%)"
    def isComplete(): Boolean = confirmed >= needed
}

// ── Helper functions ──────────────────────────────────────────────────────────

def countByKey(qsos: List[QSO], keyFn: QSO -> String): Map[String, Int] {
  val result: Map[String, Int] = [:]
  foreach q: QSO in qsos {
    val key: String = keyFn(q)
    val cur: Int? = result[key] as Int?
    if cur == null { result.put(key, 1) } else { result.put(key, cur + 1) }
  }
  return result
}

def uniqueCount(qsos: List[QSO], keyFn: QSO -> String): Int {
  val seen: Map[String, Int] = [:]
  foreach q: QSO in qsos {
    seen.put(keyFn(q), 1)
  }
  return seen.size()
}

def continentsWorked(qsos: List[QSO]): Int {
  val seen: Map[String, Int] = [:]
  foreach q: QSO in qsos {
    seen.put(q.continent().fullName(), 1)
  }
  return seen.size()
}

def hfOnlyQSOs(qsos: List[QSO]): List[QSO] =
  qsos.filter { q -> q.isHFContact() }

def digitalQSOs(qsos: List[QSO]): List[QSO] =
  qsos.filter { q -> q.isDigitalContact() }

def joinStrings(items: List[String], sep: String): String =
  items.fold("") { acc, s -> if acc == "" { s } else { acc + sep + s } }

// ── DX entity reference ───────────────────────────────────────────────────────

val entityTable: List[DXEntity] = [
