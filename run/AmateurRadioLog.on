// ── Analysis ──────────────────────────────────────────────────────────────────

IO::println("=== Amateur Radio Station Log ===")
IO::println("Total QSOs : " + allQSOs.size)
IO::println("HF QSOs    : " + hfOnlyQSOs(allQSOs).size)
IO::println("Digital    : " + digitalQSOs(allQSOs).size)
IO::println("")

IO::println("── Band Breakdown ─")
val bandMap: Map[String, Int] = countByKey(allQSOs, { q -> q.band().displayName() })
foreach (band, cnt) in bandMap {
  IO::println("  #{band}: #{cnt}")
}
IO::println("")

IO::println("── Mode Breakdown ─")
val modeMap: Map[String, Int] = countByKey(allQSOs, { q -> "" + q.mode() })
foreach (m, cnt) in modeMap {
  IO::println("  #{m}: #{cnt}")
}
IO::println("")

IO::println("── Continent Breakdown ─")
val contMap: Map[String, Int] = countByKey(allQSOs, { q -> q.continent().fullName() })
foreach (cont, cnt) in contMap {
  IO::println("  #{cont}: #{cnt}")
}
IO::println("")

IO::println("── Entity Breakdown ─")
val entityMap: Map[String, Int] = countByKey(allQSOs, { q -> q.entity() })
foreach (ent, cnt) in entityMap {
  IO::println("  #{ent}: #{cnt}")
}
IO::println("")

IO::println("── Award Progress ─")
val dxccWorked: Int  = uniqueCount(allQSOs, { q -> q.entity() })
val waWorked: Int    = continentsWorked(allQSOs)
val dxcc: AwardProgress = new AwardProgress("DXCC (entities)", 100, dxccWorked)
val wac:  AwardProgress = new AwardProgress("WAC (continents)",  7, waWorked)
val was:  AwardProgress = new AwardProgress("WAS (US states)",  50, 3)
IO::println("  " + dxcc.display())
IO::println("  " + wac.display())
IO::println("  " + was.display())
IO::println("")

IO::println("── CW-Only Stats ─")
val cwQSOs: List[QSO] = allQSOs.filter { q -> q.mode() == Mode::CW }
val cwEntities: Int    = uniqueCount(cwQSOs, { q -> q.entity() })
val cwConts: Int       = continentsWorked(cwQSOs)
IO::println("  CW QSOs      : " + cwQSOs.size)
IO::println("  CW entities  : " + cwEntities)
IO::println("  CW continents: " + cwConts)
IO::println("")

IO::println("── Average RST Received ─")
val totalRST: Int = allQSOs.fold(0) { acc, q -> acc + q.rstRecv() }
val avgRST: Int   = totalRST / allQSOs.size
IO::println("  Average: " + avgRST + " (over " + allQSOs.size + " QSOs)")
IO::println("")

IO::println("── Band/Mode Combinations ─")
val bmMap: Map[String, Int] = countByKey(allQSOs, { q -> q.bandModeKey() })
foreach (bm, cnt) in bmMap {
  IO::println("  #{bm}: #{cnt}")
}
IO::println("")

IO::println("── First 5 QSO Band Summary ─")
val firstFiveBands: List[String] = []
var i: Int = 0
foreach q: QSO in allQSOs {
  if i < 5 {
    firstFiveBands.add(q.band().displayName())
  }
  i++
}
val bandSummary: String = firstFiveBands |> joinStrings(", ")
IO::println("  " + bandSummary)
IO::println("")

IO::println("── DX Entity Reference ─")
foreach e: DXEntity in entityTable {
  IO::println("  " + e.display())
}
IO::println("")

IO::println("── HF Band Frequencies ─")
val hfBands: List[Band] = [Band::BAND_160M, Band::BAND_80M, Band::BAND_40M, Band::BAND_20M, Band::BAND_15M, Band::BAND_10M]
foreach b: Band in hfBands {
  IO::println("  #{b.displayName()}: #{b.frequencyMHz()} MHz")
}
IO::println("")

IO::println("── Recent QSOs (Feb 2024) ─")
foreach q: QSO in allQSOs {
  if q.date().startsWith("2024-02") {
    IO::println("  " + q.display())
  }
}
