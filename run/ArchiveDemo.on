// ArchiveDemo.on — onion.Archive: zip and gzip
// Exercises: Archive::zip, Archive::zipDir, Archive::entries, Archive::unzip,
// Archive::gzip/gunzip, Files::mkdirs/writeText/readText, foreach over List,
// String interpolation.

val workDir = System::getProperty("java.io.tmpdir") + "/onion-archive-demo-" + Rand::uuid()
Files::mkdirs(workDir + "/site/css")
Files::writeText(workDir + "/site/index.html", "<h1>Hello, Onion</h1>")
Files::writeText(workDir + "/site/css/main.css", "body { margin: 0 }")
Files::writeText(workDir + "/README.txt", "generated by ArchiveDemo.on")

IO::println("── zipping a directory tree ──")
val siteZip = workDir + "/site.zip"
Archive::zipDir(siteZip, workDir + "/site")
foreach name: String in Archive::entries(siteZip) {
  IO::println("  " + name)
}

IO::println("\n── zipping a handful of files ──")
val bundleZip = workDir + "/bundle.zip"
Archive::zip(bundleZip, [workDir + "/README.txt", workDir + "/site/index.html"])
foreach name: String in Archive::entries(bundleZip) {
  IO::println("  " + name)
}

IO::println("\n── round-tripping through unzip ──")
val extractDir = workDir + "/extracted"
val written = Archive::unzip(siteZip, extractDir)
val restoredHtml = Files::readText(extractDir + "/index.html")
val restoredCss = Files::readText(extractDir + "/css/main.css")
val roundTripOk = restoredHtml == "<h1>Hello, Onion</h1>" && restoredCss == "body { margin: 0 }"
IO::println("  extracted " + written.size + " file(s), byte-for-byte match: " + roundTripOk)

IO::println("\n── gzip round-trip on raw bytes ──")
val original = Strings::repeat("the quick brown fox jumps over the lazy dog. ", 40)
val compressed = Archive::gzip(original.getBytes())
val restored = new String(Archive::gunzip(compressed))
IO::println("  " + original.length() + " bytes -> " + compressed.length + " bytes gzipped")
IO::println("  decompressed matches original: " + (restored == original))

IO::println("\nDone.")
