// BasketballStats.on — NBA-style basketball analytics with advanced metrics.
//
// Exercises: records (with methods and example clauses), data-carrying enums,
// ADT case-enum with exhaustive pattern matching, generic record (Ranked[T]),
// extension methods on Int and Double, collection pipelines (map/filter/fold/
// sortedBy/groupBy/distinct/find/partition/zip/reduce/any/count), foreach over
// map (k,v), nullable types, closures, string interpolation, try/catch,
// recursion, while and foreach with ranges, operator overloading.

import { java.lang.Math }

// ─── Extensions ──────────────────────────────────────────────────────────────

extension Double {
  def round1(): Double {
    val shifted: Double = self * 10.0
    val truncated: Int = shifted as Int
    return truncated.doubleValue() / 10.0
  }
  def pct(): String = "#{(self * 100.0).round1()}%"
  def fmt(): String {
    val s: String = "" + self.round1()
    val dot: Int = s.indexOf(".")
    if dot < 0 { return s + ".0" }
    return s
  }
}

extension Int {
  def padL(w: Int): String {
    var s: String = "" + self
    while s.length() < w { s = " " + s }
    return s
  }
}

extension String {
  def padR(w: Int): String {
    var s: String = self
    while s.length() < w { s = s + " " }
    return s
  }
  def trunc(w: Int): String {
    if self.length() <= w { return self }
    return self.substring(0, w - 1) + "."
  }
}

// ─── Position enum (plain, data-carrying) ────────────────────────────────────

enum Position(abbr: String, fullName: String) {
  PG("PG", "Point Guard"),
  SG("SG", "Shooting Guard"),
  SF("SF", "Small Forward"),
  PF("PF", "Power Forward"),
  C("C",  "Center")
public:
  def label(): String = abbr()
  def desc(): String = fullName()
}

// ─── Season award ADT ────────────────────────────────────────────────────────

enum Award {
  case MVP
  case DPOY
  case AllStar
  case RookieOfYear
  case SixthMan
  case MostImproved
public:
  def label(): String = select this {
    case a is MVP:          "Most Valuable Player"
    case a is DPOY:         "Defensive Player of Year"
    case a is AllStar:      "All-Star Selection"
    case a is RookieOfYear: "Rookie of the Year"
    case a is SixthMan:     "Sixth Man of the Year"
    case a is MostImproved: "Most Improved Player"
  }
  def short(): String = select this {
    case a is MVP:          "MVP"
    case a is DPOY:         "DPOY"
    case a is AllStar:      "AS"
    case a is RookieOfYear: "ROY"
    case a is SixthMan:     "6MAN"
    case a is MostImproved: "MIP"
  }
}

// ─── Player record ────────────────────────────────────────────────────────────

record Player(
  name: String,
  team: String,
  pos: Position,
  age: Int,
  games: Int,
  minutes: Int,
  points: Int,
  rebounds: Int,
  assists: Int,
  steals: Int,
  blocks: Int,
  turnovers: Int,
  fga: Int,
  fgm: Int,
  tpa: Int,
  tpm: Int,
  fta: Int,
  ftm: Int
)
  example { new Player("T", "X", Position::PG, 25, 82, 3000, 2000, 400, 600, 100, 50, 250, 1500, 750, 500, 200, 400, 330).ppg() > 20.0 }
{
public:
  def ppg(): Double  = if games() == 0 { 0.0 } else { points().doubleValue() / games().doubleValue() }
  def rpg(): Double  = if games() == 0 { 0.0 } else { rebounds().doubleValue() / games().doubleValue() }
  def apg(): Double  = if games() == 0 { 0.0 } else { assists().doubleValue() / games().doubleValue() }
  def spg(): Double  = if games() == 0 { 0.0 } else { steals().doubleValue() / games().doubleValue() }
  def bpg(): Double  = if games() == 0 { 0.0 } else { blocks().doubleValue() / games().doubleValue() }
  def topg(): Double = if games() == 0 { 0.0 } else { turnovers().doubleValue() / games().doubleValue() }
  def mpg(): Double  = if games() == 0 { 0.0 } else { minutes().doubleValue() / games().doubleValue() }

  def fgPct(): Double = if fga() == 0 { 0.0 } else { fgm().doubleValue() / fga().doubleValue() }
  def tpPct(): Double = if tpa() == 0 { 0.0 } else { tpm().doubleValue() / tpa().doubleValue() }
  def ftPct(): Double = if fta() == 0 { 0.0 } else { ftm().doubleValue() / fta().doubleValue() }

  // True Shooting % = PTS / (2 * (FGA + 0.44*FTA))
  def tsPct(): Double {
    val denom: Double = 2.0 * (fga().doubleValue() + 0.44 * fta().doubleValue())
    if denom == 0.0 { return 0.0 }
    return points().doubleValue() / denom
  }

  // Assist-to-Turnover ratio
  def atr(): Double = if turnovers() == 0 { 999.0 } else { assists().doubleValue() / turnovers().doubleValue() }

  // Simple efficiency: (PTS + REB + AST + STL + BLK - TO) / GP
  def eff(): Double {
    if games() == 0 { return 0.0 }
    val raw: Int = points() + rebounds() + assists() + steals() + blocks() - turnovers()
    return raw.doubleValue() / games().doubleValue()
  }

  def statLine(): String = "#{ppg().fmt()} / #{rpg().fmt()} / #{apg().fmt()}"
}

// ─── Ranked generic wrapper ───────────────────────────────────────────────────

record Ranked[T](rank: Int, value: T, score: Double)

// ─── Stat category for leaderboard selection ─────────────────────────────────

enum StatCat {
  case Scoring
  case Rebounding
  case Playmaking
  case Defense
  case Efficiency
public:
  def extract(p: Player): Double = select this {
    case s is Scoring:    p.ppg()
    case r is Rebounding: p.rpg()
    case m is Playmaking: p.apg()
    case d is Defense:    p.spg() + p.bpg()
    case e is Efficiency: p.eff()
  }
  def label(): String = select this {
    case s is Scoring:    "Points"
    case r is Rebounding: "Rebounds"
    case m is Playmaking: "Assists"
    case d is Defense:    "Stl+Blk"
    case e is Efficiency: "EFF"
  }
}

// ─── Helper: rank players by a stat category ─────────────────────────────────

def rankBy(players: List[Player], cat: StatCat, n: Int): List[Ranked[Player]] {
  val sorted: List[Player] = players.sortedBy { p -> 0.0 - cat.extract(p) }
  val result: List[Ranked[Player]] = []
  var i: Int = 0
  foreach p: Player in sorted {
    if i >= n { break }
    result.add(new Ranked[Player](i + 1, p, cat.extract(p)))
    i++
  }
  return result
}

// ─── Recursive: find player by name in a list ────────────────────────────────

def findPlayer(players: List[Player], name: String, idx: Int): Player? {
  if idx >= players.size { return null }
  val p: Player = players.get(idx)
  if p.name() == name { return p }
  return findPlayer(players, name, idx + 1)
}

// ─── Print a leaderboard section ─────────────────────────────────────────────

def printLeaderboard(title: String, ranked: List[Ranked[Player]]): void {
  IO::println("\n── #{title} ──")
  foreach r: Ranked[Player] in ranked {
    val p: Player = r.value()
    IO::println("  #{r.rank().padL(2)}. #{p.name().padR(18)} #{p.team().padR(4)} #{r.score().fmt()}")
  }
}

// ─── Team summary ─────────────────────────────────────────────────────────────

def teamReport(players: List[Player]): void {
  IO::println("\n── Team Totals ──")
  val byTeam: Map[String, List[Player]] = players.groupBy { p -> p.team() }
  foreach (team, members) in byTeam {
    val avgPpg: Double = members.map { p -> p.ppg() }
                               .fold(0.0) { acc, v -> (acc as Double) + (v as Double) }
    IO::println("  #{team.padR(12)} #{members.size} players  avg PPG: #{(avgPpg / members.size.doubleValue()).fmt()}")
  }
}

// ─── Position breakdown ───────────────────────────────────────────────────────

def positionBreakdown(players: List[Player]): void {
  IO::println("\n── By Position ──")
  val byPos: Map[String, List[Player]] = players.groupBy { p -> p.pos().label() }
  val posOrder: List[String] = ["PG", "SG", "SF", "PF", "C"]
  foreach pos: String in posOrder {
    val group: List[Player]? = byPos.get(pos) as List[Player]?
    if group == null { continue }
    val avgEff: Double = group.map { p -> p.eff() }
                              .fold(0.0) { acc, v -> (acc as Double) + (v as Double) }
    IO::println("  #{pos}  #{group.size} players  avg EFF: #{(avgEff / group.size.doubleValue()).fmt()}")
  }
}

// ─── Award projections ────────────────────────────────────────────────────────

def projectAwards(players: List[Player]): void {
  IO::println("\n── Projected Awards ──")

  val byPpg: List[Player] = players.sortedBy { p -> 0.0 - p.ppg() }
  if !byPpg.isEmpty {
    val topScorer: Player = byPpg.get(0)
    IO::println("  #{(new MVP).label()}: #{topScorer.name()} (#{topScorer.ppg().fmt()} PPG)")
  }

  val byDef: List[Player] = players.sortedBy { p -> 0.0 - (p.spg() + p.bpg()) }
  if !byDef.isEmpty {
    val topDefender: Player = byDef.get(0)
    val spgbpg: Double = topDefender.spg() + topDefender.bpg()
    IO::println("  #{(new DPOY).label()}: #{topDefender.name()} (#{spgbpg.fmt()} Stl+Blk/g)")
  }

  // All-Stars: top 5 by efficiency overall
  IO::println("  #{(new AllStar).label()}s:")
  val allStars: List[Ranked[Player]] = rankBy(players, new Efficiency, 5)
  foreach r: Ranked[Player] in allStars {
    val p: Player = r.value()
    IO::println("    #{p.name()} (#{p.team()}, #{p.eff().fmt()} EFF)")
  }
}

// ─── Shooting efficiency report ───────────────────────────────────────────────

def shootingReport(players: List[Player]): void {
  IO::println("\n── Shooting Efficiency (min 300 FGA) ──")
  val shooters: List[Player] = players.filter { p -> p.fga() >= 300 }
                                      .sortedBy { p -> 0.0 - p.tsPct() }
  foreach p: Player in shooters {
    val line: String = "#{p.name().padR(18)} FG:#{p.fgPct().pct()} 3P:#{p.tpPct().pct()} FT:#{p.ftPct().pct()} TS:#{p.tsPct().pct()}"
    IO::println("  #{line}")
  }
}

// ─── Statistical extremes ─────────────────────────────────────────────────────

def statExtremes(players: List[Player]): void {
  IO::println("\n── Statistical Extremes ──")

  val cats: List[StatCat] = [new Scoring, new Rebounding, new Playmaking, new Defense, new Efficiency]
  foreach cat: StatCat in cats {
    val asc: List[Player]  = players.sortedBy { p -> cat.extract(p) }
    val desc: List[Player] = players.sortedBy { p -> 0.0 - cat.extract(p) }
    if !asc.isEmpty && !desc.isEmpty {
      val best: Player  = desc.get(0)
      val worst: Player = asc.get(0)
      IO::println("  #{cat.label().padR(10)} best: #{best.name().padR(14)} #{cat.extract(best).fmt()}" +
                  "   worst: #{worst.name().padR(14)} #{cat.extract(worst).fmt()}")
    }
  }
}

// ─── Partition: starters vs. bench ───────────────────────────────────────────

def startersBenchSplit(players: List[Player]): void {
  IO::println("\n── Starters vs. Bench (cutoff: 30 mpg) ──")
  val parts = players.partition { p -> p.mpg() >= 30.0 }
  val starters: List[Object] = parts[0] as List[Object]
  val bench: List[Object]    = parts[1] as List[Object]

  val avgStar: Double  = starters.fold(0.0) { acc, p -> (acc as Double) + (p as Player).ppg() }
  val avgBench: Double = bench.fold(0.0)    { acc, p -> (acc as Double) + (p as Player).ppg() }

  val sppg: Double = if starters.isEmpty { 0.0 } else { avgStar / starters.size.doubleValue() }
  val bppg: Double = if bench.isEmpty    { 0.0 } else { avgBench / bench.size.doubleValue() }

  IO::println("  Starters (#{starters.size}): avg #{sppg.fmt()} PPG")
  IO::println("  Bench    (#{bench.size}): avg #{bppg.fmt()} PPG")
}

// ─── Zip demo: pair players by scoring rank for a hypothetical matchup ────────

def scoringDuel(players: List[Player]): void {
  IO::println("\n── Scoring Duel (Top-6 vs. Bottom-6) ──")
  val sorted: List[Player] = players.sortedBy { p -> 0.0 - p.ppg() }
  val topSix: List[Player] = []
  val botSix: List[Player] = []
  var i: Int = 0
  foreach p: Player in sorted {
    if i < 6 { topSix.add(p) } else if i < 12 { botSix.add(p) }
    i++
  }
  val pairs: List[Object] = topSix.zip(botSix) as List[Object]
  foreach pair: Object in pairs {
    val a: Player = (pair as List[Object]).get(0) as Player
    val b: Player = (pair as List[Object]).get(1) as Player
    IO::println("  #{a.name().padR(16)} #{a.ppg().fmt().padR(5)} vs #{b.ppg().fmt().padR(5)} #{b.name()}")
  }
}

// ─── do[Option] demo: compute a player's combined score safely ────────────────

def combinedScore(players: List[Player], nameA: String, nameB: String): String {
  val a: Player? = findPlayer(players, nameA, 0)
  val b: Player? = findPlayer(players, nameB, 0)
  if a == null || b == null { return "one or more players not found" }
  val combined: Double = a.eff() + b.eff()
  return "#{nameA} + #{nameB} combined EFF: #{combined.fmt()}"
}

