// ─── Main ─────────────────────────────────────────────────────────────────────

IO::println("═══════════════════════════════════════")
IO::println("     NBA Analytics Dashboard 2024")
IO::println("═══════════════════════════════════════")

// Top-5 leaderboards
printLeaderboard("Top Scorers",    rankBy(players, new Scoring,    5))
printLeaderboard("Top Rebounders", rankBy(players, new Rebounding, 5))
printLeaderboard("Top Playmakers", rankBy(players, new Playmaking, 5))
printLeaderboard("Top Defenders",  rankBy(players, new Defense,    5))
printLeaderboard("Top Efficiency", rankBy(players, new Efficiency, 5))

// Team summary
teamReport(players)

// Position breakdown
positionBreakdown(players)

// Shooting efficiency
shootingReport(players)

// Statistical extremes
statExtremes(players)

// Starters vs. bench
startersBenchSplit(players)

// Scoring duel (zip demo)
scoringDuel(players)

// Award projections
projectAwards(players)

// do[Option] demo
IO::println("\n── Combined Efficiency ──")
IO::println("  " + combinedScore(players, "LeBron James", "Stephen Curry"))
IO::println("  " + combinedScore(players, "Unknown", "Joel Embiid"))

// Distinct teams
val teams: List[String] = players.map { p -> p.team() }.distinct()
IO::println("\n── Teams in dataset (#{teams.size}) ──")
IO::println("  " + teams.fold("") { acc, t -> if (acc as String) == "" { t as String } else { (acc as String) + ", " + (t as String) } })

// Try/catch: safe division demo
IO::println("\n── Safe Division Demo ──")
try {
  val ratio: Double = 1.0 / 0.0
  IO::println("  1.0/0.0 = #{ratio}")
} catch e: Exception {
  IO::println("  caught: #{e.message()}")
}
IO::println("  (Doubles don't throw on /0 in Java — produces Infinity)")

IO::println("\n═══════════════════════════════════════")
