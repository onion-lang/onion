// ChemLab.on — Periodic table explorer, compound analyzer, and reaction calculator
// Exercises: homogeneous enums with methods, records with methods, class hierarchy,
// collection pipelines (map/filter/groupBy/sortedBy/reduce/find/partition),
// select/pattern matching, string interpolation, closures, foreach (map k,v),
// nullable checks, statistics, while loops, extension methods.

import {
  java.util.*
}

// ─── Element Categories ──────────────────────────────────────────────────────

enum ElemCategory {
  ALKALI_METAL, ALKALINE_EARTH, TRANSITION_METAL, POST_TRANSITION,
  METALLOID, NONMETAL, NOBLE_GAS, HALOGEN, LANTHANIDE, ACTINIDE
public:
  def label(): String = select this {
    case ElemCategory::ALKALI_METAL:     "Alkali Metal"
    case ElemCategory::ALKALINE_EARTH:   "Alkaline Earth"
    case ElemCategory::TRANSITION_METAL: "Transition Metal"
    case ElemCategory::POST_TRANSITION:  "Post-transition Metal"
    case ElemCategory::METALLOID:        "Metalloid"
    case ElemCategory::NONMETAL:         "Nonmetal"
    case ElemCategory::NOBLE_GAS:        "Noble Gas"
    case ElemCategory::HALOGEN:          "Halogen"
    case ElemCategory::LANTHANIDE:       "Lanthanide"
    case ElemCategory::ACTINIDE:         "Actinide"
  }
  def isMetal(): Boolean = select this {
    case ElemCategory::ALKALI_METAL:     true
    case ElemCategory::ALKALINE_EARTH:   true
    case ElemCategory::TRANSITION_METAL: true
    case ElemCategory::POST_TRANSITION:  true
    case ElemCategory::LANTHANIDE:       true
    case ElemCategory::ACTINIDE:         true
    else:                                false
  }
}

// ─── Element Record ──────────────────────────────────────────────────────────

record Element(
  number: Int,
  symbol: String,
  name:   String,
  mass:   Double,
  period: Int,
  group:  Int,
  category: ElemCategory
) {
public:
  def display(): String =
    "[#{number()}] #{symbol()} #{name()} #{mass()} g/mol — #{category().label()}"
  def isMetal(): Boolean = category().isMetal()
  def isGas(): Boolean   = category() == ElemCategory::NOBLE_GAS || category() == ElemCategory::HALOGEN
}

// ─── Extension on Double ─────────────────────────────────────────────────────

extension Double {
  def rounded2(): Double = (self * 100.0d + 0.5d) as Long as Double / 100.0d
}

// ─── Element Table ───────────────────────────────────────────────────────────

val ELEMENTS: List[Element] = [
  new Element(1,  "H",  "Hydrogen",    1.008,  1, 1,  ElemCategory::NONMETAL),
