// ColorMixer.on — RGB colour algebra, palette generation, and blending.
// Domain: digital colour toolkit with named palettes and blend operations.
// Exercises: records with methods; plain enum; generics (ArrayList);
// extension Int / Double; collection pipelines (filter/sort/foreach);
// foreach on ranges; select / pattern matching; closures; string interpolation;
// nullable; while loops; helper functions.

import {
  java.lang.Math
  java.util.ArrayList
  java.util.Collections
  java.util.Comparator
}

// ── Utility extensions ─────────────────────────────────────────────────────────

extension Int {
  def clamp(lo: Int, hi: Int): Int =
    if self < lo { lo } else if self > hi { hi } else { self }

  def hexByte(): String {
    val s = Integer::toHexString(self.clamp(0, 255))
    return if s.length() == 1 { "0" + s } else { s }
  }
}

extension Double {
  def clamp01(): Double = if self < 0.0 { 0.0 } else if self > 1.0 { 1.0 } else { self }
  def pct(): String = "" + (self * 100.0 as Int) + "%"
}

// ── Colour temperature ─────────────────────────────────────────────────────────

enum Warmth { Warm, Cool, Neutral }

// ── Blend mode (plain enum) ────────────────────────────────────────────────────

enum BlendMode { Normal, Multiply, Screen, Overlay }

// ── RGB colour record ─────────────────────────────────────────────────────────

record Color(r: Int, g: Int, b: Int) {
  example { new Color(255, 0, 0).r() == 255 }
  example { new Color(0, 255, 0).g() == 255 }
  example { new Color(0, 0, 255).b() == 255 }
public:
  def hex(): String = "#" + r.hexByte() + g.hexByte() + b.hexByte()

  def luminance(): Double =
    (0.299 * r + 0.587 * g + 0.114 * b) / 255.0

  def warmth(): Warmth {
    val warm = r + (g / 2)
    val cool = b + (g / 2)
    return if warm > cool + 30 { Warmth::Warm }
           else if cool > warm + 30 { Warmth::Cool }
           else { Warmth::Neutral }
  }

  def toGray(): Color {
    val v: Int = (0.299 * r + 0.587 * g + 0.114 * b) as Int
    return new Color(v, v, v)
  }

  def invert(): Color = new Color(255 - r, 255 - g, 255 - b)

  def lighten(amount: Double): Color {
    val a = amount.clamp01()
    return new Color(
      (r + (255 - r) * a) as Int,
      (g + (255 - g) * a) as Int,
      (b + (255 - b) * a) as Int
    )
  }

  def darken(amount: Double): Color {
    val a = amount.clamp01()
    return new Color(
      (r * (1.0 - a)) as Int,
      (g * (1.0 - a)) as Int,
      (b * (1.0 - a)) as Int
    )
  }

  def lerp(other: Color, t: Double): Color {
    val tc = t.clamp01()
    return new Color(
      (r + (other.r() - r) * tc) as Int,
      (g + (other.g() - g) * tc) as Int,
      (b + (other.b() - b) * tc) as Int
    )
  }

  def blendNormal(other: Color): Color = lerp(other, 0.5)

  def blendMultiply(other: Color): Color =
    new Color(
      (r * other.r() / 255) as Int,
      (g * other.g() / 255) as Int,
      (b * other.b() / 255) as Int
    )

  def blendScreen(other: Color): Color {
    val rr = (255 - (255 - r) * (255 - other.r()) / 255) as Int
    val gg = (255 - (255 - g) * (255 - other.g()) / 255) as Int
    val bb = (255 - (255 - b) * (255 - other.b()) / 255) as Int
    return new Color(rr, gg, bb)
  }

  def blendOverlay(other: Color): Color {
    val rr = if r < 128 { (2 * r * other.r() / 255) as Int }
             else { (255 - 2 * (255 - r) * (255 - other.r()) / 255) as Int }
    val gg = if g < 128 { (2 * g * other.g() / 255) as Int }
             else { (255 - 2 * (255 - g) * (255 - other.g()) / 255) as Int }
    val bb = if b < 128 { (2 * b * other.b() / 255) as Int }
             else { (255 - 2 * (255 - b) * (255 - other.b()) / 255) as Int }
    return new Color(rr, gg, bb)
  }

  def blend(other: Color, mode: BlendMode): Color =
    select mode {
      case BlendMode::Normal:   blendNormal(other)
      case BlendMode::Multiply: blendMultiply(other)
      case BlendMode::Screen:   blendScreen(other)
      case BlendMode::Overlay:  blendOverlay(other)
    }

  def distanceTo(other: Color): Double {
    val dr: Double = (r - other.r()) as Double
    val dg: Double = (g - other.g()) as Double
    val db: Double = (b - other.b()) as Double
    return Math::sqrt(dr * dr + dg * dg + db * db)
  }

  def warmthLabel(): String =
    select warmth() {
      case Warmth::Warm:    "warm"
      case Warmth::Cool:    "cool"
      case Warmth::Neutral: "neutral"
    }

  def summary(): String =
    "#{hex()} lum=#{luminance().pct()} [#{warmthLabel()}]"
}

// ── Named Colour Palette ───────────────────────────────────────────────────────

record Palette(name: String, colors: ArrayList[Color]) {
public:
  def add(c: Color): void { colors.add(c) }

  def size(): Int = colors.size

  def dominant(): Color? {
    if colors.isEmpty() { return null }
    var best: Color = colors[0]
    var bestLum: Double = best.luminance()
    foreach c: Color in colors {
      val lum = c.luminance()
      if lum > bestLum { best = c; bestLum = lum }
    }
    return best
  }

  def darkest(): Color? {
    if colors.isEmpty() { return null }
    var best: Color = colors[0]
    var bestLum: Double = best.luminance()
    foreach c: Color in colors {
      val lum = c.luminance()
      if lum < bestLum { best = c; bestLum = lum }
    }
    return best
  }

  def averageColor(): Color {
    if colors.isEmpty() { return new Color(128, 128, 128) }
    var rSum: Int = 0
    var gSum: Int = 0
    var bSum: Int = 0
    foreach c: Color in colors {
      rSum = rSum + c.r()
      gSum = gSum + c.g()
      bSum = bSum + c.b()
    }
    val n = colors.size
    return new Color(rSum / n, gSum / n, bSum / n)
  }

  def warmColors(): ArrayList[Color] {
    val result = new ArrayList[Color]()
    foreach c: Color in colors {
      if c.warmth() == Warmth::Warm { result.add(c) }
    }
    return result
  }

  def coolColors(): ArrayList[Color] {
    val result = new ArrayList[Color]()
    foreach c: Color in colors {
      if c.warmth() == Warmth::Cool { result.add(c) }
    }
    return result
  }

  def sortedByLuminance(): ArrayList[Color] {
    val copy = new ArrayList[Color](colors)
    copy.sort { a: Color, b: Color ->
      val d = a.luminance() - b.luminance()
      if d < 0.0 { -1 } else if d > 0.0 { 1 } else { 0 }
    }
    return copy
  }

  def printAll(): void {
    IO::println("=== Palette: #{name} (#{size()} colours) ===")
    foreach c: Color in colors { IO::println("  " + c.summary()) }
  }
}

// ── Gradient generator ────────────────────────────────────────────────────────

def linearGradient(from: Color, to: Color, steps: Int): ArrayList[Color] {
  val result = new ArrayList[Color]()
  if steps <= 0 { return result }
  if steps == 1 { result.add(from); return result }
  foreach i: Int in 0..<steps {
    val t: Double = (i as Double) / ((steps - 1) as Double)
    result.add(from.lerp(to, t))
  }
  return result
}

// ── Colour statistics ──────────────────────────────────────────────────────────

record ColorStats(
  count: Int,
  avgLuminance: Double,
  warmCount: Int,
  coolCount: Int,
  neutralCount: Int
) {
public:
  def summary(): String =
    "n=#{count} avgLum=#{avgLuminance.pct()} warm=#{warmCount} cool=#{coolCount} neutral=#{neutralCount}"
}

def computeStats(colors: ArrayList[Color]): ColorStats {
  var lumSum: Double = 0.0
  var warm: Int = 0
  var cool: Int = 0
  var neutral: Int = 0
  foreach c: Color in colors {
    lumSum = lumSum + c.luminance()
    select c.warmth() {
      case Warmth::Warm:    warm = warm + 1
      case Warmth::Cool:    cool = cool + 1
      case Warmth::Neutral: neutral = neutral + 1
    }
  }
  val n = colors.size
  val avg: Double = if n == 0 { 0.0 } else { lumSum / (n as Double) }
  return new ColorStats(n, avg, warm, cool, neutral)
}

// ── Harmony palette builders ───────────────────────────────────────────────────

def triadicPalette(base: Color): Palette {
  val p = new Palette("Triadic", new ArrayList[Color]())
  p.add(base)
  p.add(new Color(base.g(), base.b(), base.r()))
  p.add(new Color(base.b(), base.r(), base.g()))
  return p
}

def splitComplementaryPalette(base: Color): Palette {
  val comp = base.invert()
  val p = new Palette("Split-Complementary", new ArrayList[Color]())
  p.add(base)
  p.add(comp.lighten(0.2))
  p.add(comp.darken(0.2))
  return p
}

// ── Find nearest colour ────────────────────────────────────────────────────────

def nearestColor(target: Color, palette: Palette): Color? {
  if palette.size() == 0 { return null }
  var best: Color = palette.colors[0]
  var bestDist: Double = target.distanceTo(best)
  foreach c: Color in palette.colors {
    val d = target.distanceTo(c)
    if d < bestDist { best = c; bestDist = d }
  }
  return best
}

// ── Demo entrypoint ───────────────────────────────────────────────────────────

def main(): void {
  val black  = new Color(0,   0,   0)
  val white  = new Color(255, 255, 255)
  val red    = new Color(220, 50,  50)
  val green  = new Color(50,  180, 80)
  val blue   = new Color(50,  80,  220)
  val yellow = new Color(255, 210, 0)
  val orange = new Color(255, 130, 0)
  val purple = new Color(150, 0,   200)
  val teal   = new Color(0,   180, 180)
  val coral  = new Color(255, 100, 90)

  IO::println("=== Colour Properties ===")
  foreach c: Color in [black, white, red, green, blue, yellow, orange, purple, teal, coral] {
    IO::println("  " + c.summary())
  }

  IO::println("")
  IO::println("=== Blend Modes (red x blue) ===")
  foreach mode: BlendMode in [BlendMode::Normal, BlendMode::Multiply, BlendMode::Screen, BlendMode::Overlay] {
    val result = red.blend(blue, mode)
    val label: String = select mode {
      case BlendMode::Normal:   "Normal  "
      case BlendMode::Multiply: "Multiply"
      case BlendMode::Screen:   "Screen  "
      case BlendMode::Overlay:  "Overlay "
    }
    IO::println("  #{label}: #{result.hex()}")
  }

  IO::println("")
  IO::println("=== Gradient: red → blue (7 steps) ===")
  val grad = linearGradient(red, blue, 7)
  foreach c: Color in grad { IO::println("  " + c.hex()) }

  IO::println("")
  val tri = triadicPalette(orange)
  tri.printAll()

  IO::println("")
  val sc = splitComplementaryPalette(teal)
  sc.printAll()

  val mainPalette = new Palette("Main", new ArrayList[Color]())
  foreach c: Color in [black, white, red, green, blue, yellow, orange, purple, teal, coral] {
    mainPalette.add(c)
  }

  IO::println("")
  IO::println("=== Sorted by Luminance ===")
  val sorted = mainPalette.sortedByLuminance()
  foreach c: Color in sorted { IO::println("  " + c.summary()) }

  IO::println("")
  val stats = computeStats(mainPalette.colors)
  IO::println("=== Stats: " + stats.summary() + " ===")

  IO::println("")
  IO::println("=== Warm colours ===")
  foreach c: Color in mainPalette.warmColors() { IO::println("  " + c.hex()) }
  IO::println("=== Cool colours ===")
  foreach c: Color in mainPalette.coolColors() { IO::println("  " + c.hex()) }

  IO::println("")
  val dom: Color? = mainPalette.dominant()
  val drk: Color? = mainPalette.darkest()
  if dom != null { IO::println("Brightest: #{dom.hex()} lum=#{dom.luminance().pct()}") }
  if drk != null { IO::println("Darkest:   #{drk.hex()} lum=#{drk.luminance().pct()}") }
  val avg = mainPalette.averageColor()
  IO::println("Average:   #{avg.hex()}")

  IO::println("")
  IO::println("=== Colour Distances ===")
  IO::println("  red<->blue:  " + String::format("%.1f", red.distanceTo(blue)))
  IO::println("  red<->green: " + String::format("%.1f", red.distanceTo(green)))
  IO::println("  blue<->green:" + String::format("%.1f", blue.distanceTo(green)))

  IO::println("")
  IO::println("=== Lighten/Darken ladder (red, steps 0.0..0.8) ===")
  foreach i: Int in 0..4 {
    val t: Double = (i as Double) * 0.2
    IO::println(
      "  t=" + String::format("%.1f", t) +
      "  light=" + red.lighten(t).hex() +
      "  dark="  + red.darken(t).hex()
    )
  }

  IO::println("")
  IO::println("=== Nearest to orange in main palette (excl. orange) ===")
  val probe = new Palette("Probe", new ArrayList[Color]())
  foreach c: Color in [black, white, red, green, blue, yellow, purple, teal, coral] {
    probe.add(c)
  }
  val nearest: Color? = nearestColor(orange, probe)
  if nearest != null { IO::println("  nearest: #{nearest.hex()}") }

  IO::println("")
  IO::println("=== Gray-scale conversion ===")
  foreach c: Color in [red, green, blue, orange, purple] {
    IO::println("  #{c.hex()} -> #{c.toGray().hex()}")
  }

  IO::println("")
  IO::println("=== Invert ===")
  foreach c: Color in [red, white, black, teal] {
    IO::println("  #{c.hex()} -> #{c.invert().hex()}")
  }
}
