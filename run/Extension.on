// Extension.on — Extension methods on every primitive type plus String and List.
// A focused tour: how to augment existing types without subclassing, and how
// extension methods chain, compose, and participate in collection pipelines.
//
// Exercises: extension Int / Long / Double / Boolean / String / List[T],
// operator methods, chained calls, closures, foreach with ranges, do[Option],
// records with law/example clauses, and data-carrying enums.

import {
  java.lang.Math
}

// ─── extension Int ────────────────────────────────────────────────────────────

extension Int {
  def abs(): Int     = if self < 0 { -self } else { self }
  def sign(): Int    = if self < 0 { -1 } else if self > 0 { 1 } else { 0 }
  def squared(): Int = self * self
  def cubed(): Int   = self * self * self

  def clamp(lo: Int, hi: Int): Int =
    if self < lo { lo } else if self > hi { hi } else { self }

  def isEven(): Boolean = self % 2 == 0
  def isOdd():  Boolean = self % 2 != 0
  def isPrime(): Boolean {
    if self < 2 { return false }
    if self == 2 { return true }
    if self % 2 == 0 { return false }
    var d: Int = 3
    while d * d <= self {
      if self % d == 0 { return false }
      d = d + 2
    }
    return true
  }

  def gcd(b: Int): Int {
    var a: Int = self.abs()
    var n: Int = b.abs()
    while n != 0 {
      val t: Int = n
      n = a % n
      a = t
    }
    return a
  }

  def lcm(b: Int): Int = (self.abs() / self.gcd(b)) * b.abs()

  def pow(exp: Int): Int {
    var result: Int = 1
    var e: Int = exp
    var base: Int = self
    while e > 0 {
      if e % 2 == 1 { result = result * base }
      base = base * base
      e = e / 2
    }
    return result
  }

  def digitCount(): Int {
    if self == 0 { return 1 }
    var n: Int = self.abs()
    var count: Int = 0
    while n > 0 { n = n / 10; count++ }
    return count
  }

  def sumDigits(): Int {
    var n: Int = self.abs()
    var s: Int = 0
    while n > 0 { s = s + n % 10; n = n / 10 }
    return s
  }

  def lpad(width: Int): String {
    var s: String = "" + self
    while s.length() < width { s = " " + s }
    return s
  }
}

// ─── extension Long ───────────────────────────────────────────────────────────

extension Long {
  def abs(): Long = if self < 0L { -self } else { self }

  def toHex(): String {
    if self == 0L { return "0" }
    val chars: String = "0123456789abcdef"
    var n: Long = self.abs()
    var s: String = ""
    while n > 0L {
      val digit: Int = (n % 16L) as Int
      s = chars.charAt(digit) + s
      n = n / 16L
    }
    if self < 0L { s = "-" + s }
    return s
  }

  def toBinary(): String {
    if self == 0L { return "0" }
    var n: Long = self.abs()
    var s: String = ""
    while n > 0L {
      s = (n % 2L) + s
      n = n / 2L
    }
    if self < 0L { s = "-" + s }
    return s
  }

  def humanBytes(): String {
    val kb: Long = 1024L
    val mb: Long = 1024L * 1024L
    val gb: Long = 1024L * 1024L * 1024L
    if self >= gb { return (self / gb) + "." + ((self % gb) * 10L / gb) + " GB" }
    if self >= mb { return (self / mb) + "." + ((self % mb) * 10L / mb) + " MB" }
    if self >= kb { return (self / kb) + " KB" }
    return self + " B"
  }
}

// ─── extension Double ─────────────────────────────────────────────────────────

extension Double {
  def abs(): Double = if self < 0.0 { -self } else { self }

  def round(places: Int): Double {
    val factor: Double = 10.0.pow(places)
    return (Math::round(self * factor) as Double) / factor
  }

  def clamp(lo: Double, hi: Double): Double =
    if self < lo { lo } else if self > hi { hi } else { self }

  def lerp(to: Double, t: Double): Double = self + (to - self) * t

  def pow(exp: Double): Double = Math::pow(self, exp)

  def percent(of: Double): Double = if of == 0.0 { 0.0 } else { (self / of * 100.0).round(1) }

  def between(lo: Double, hi: Double): Boolean = self >= lo && self <= hi
}

// ─── extension Boolean ────────────────────────────────────────────────────────

extension Boolean {
  def toInt(): Int    = if self { 1 } else { 0 }
  def toYesNo(): String = if self { "yes" } else { "no" }
  def toggle(): Boolean = !self
}

// ─── extension String ─────────────────────────────────────────────────────────

extension String {
  def lpad(width: Int): String {
    var s: String = self
    while s.length() < width { s = " " + s }
    return s
  }
  def rpad(width: Int): String {
    var s: String = self
    while s.length() < width { s = s + " " }
    return s
  }

  def repeat(n: Int): String {
    var s: String = ""
    var i: Int = 0
    while i < n { s = s + self; i++ }
    return s
  }

  def shout(): String = self.toUpperCase() + "!"

  def countChar(ch: String): Int {
    var count: Int = 0
    var i: Int = 0
    while i < self.length() {
      if self.substring(i, i + 1) == ch { count++ }
      i++
    }
    return count
  }

  def isPalindrome(): Boolean {
    var lo: Int = 0
    var hi: Int = self.length() - 1
    while lo < hi {
      if self.charAt(lo) != self.charAt(hi) { return false }
      lo++
      hi--
    }
    return true
  }

  def words(): List[String] {
    val parts: List[String] = []
    var start: Int = 0
    var i: Int = 0
    while i <= self.length() {
      val atEnd: Boolean = i == self.length()
      val isSpace: Boolean = !atEnd && self.substring(i, i + 1) == " "
      if (atEnd || isSpace) && i > start {
        parts.add(self.substring(start, i))
        start = i + 1
      } else if isSpace {
        start = i + 1
      }
      i++
    }
    return parts
  }
}

// ─── extension List[T] ────────────────────────────────────────────────────────
// Generic extension for any List — only methods that work on the element type
// via its toString/equals are placed here; numeric stats live in the demo below.

extension List[String] {
  def joinWith(sep: String): String {
    var s: String = ""
    var first: Boolean = true
    foreach item: String in self {
      if !first { s = s + sep }
      s = s + item
      first = false
    }
    return s
  }

  def longestLength(): Int {
    var max: Int = 0
    foreach item: String in self {
      if item.length() > max { max = item.length() }
    }
    return max
  }
}

// ─── Records and enums that lean on these extensions ─────────────────────────

record IntRange(lo: Int, hi: Int) {
  example { new IntRange(1, 10).lo() == 1 }
  example { new IntRange(1, 10).size() == 10 }

public:
  def size(): Int = (hi() - lo() + 1).abs()
  def contains(n: Int): Boolean = n >= lo() && n <= hi()
  def midpoint(): Double = (lo() + hi()).doubleValue() / 2.0
}

record DescriptiveStats(count: Int, sum: Double, min: Double, max: Double) {
  example { new DescriptiveStats(2, 3.0, 1.0, 2.0).mean() == 1.5 }
public:
  def mean(): Double  = if count() == 0 { 0.0 } else { (sum() / count().doubleValue()).round(4) }
  def range(): Double = (max() - min()).round(4)
}

// ─── Helper: stats over a List[Double] ───────────────────────────────────────

class StatsHelper {
public:
  static def compute(vals: List[Double]): DescriptiveStats {
    if vals.size == 0 { return new DescriptiveStats(0, 0.0, 0.0, 0.0) }
    var s: Double = 0.0
    var lo: Double = vals[0] as Double
    var hi: Double = vals[0] as Double
    foreach v: Double in vals {
      s = s + v
      if v < lo { lo = v }
      if v > hi { hi = v }
    }
    return new DescriptiveStats(vals.size, s, lo, hi)
  }

  static def median(vals: List[Double]): Double {
    if vals.size == 0 { return 0.0 }
    val sorted: List[Double] = vals.sortedBy { v -> v as Double }
    val n: Int = sorted.size
    if n % 2 == 1 {
      return (sorted[n / 2] as Double).round(4)
    }
    val a: Double = sorted[n / 2 - 1] as Double
    val b: Double = sorted[n / 2] as Double
    return ((a + b) / 2.0).round(4)
  }
}

// ─── Demo ─────────────────────────────────────────────────────────────────────

IO::println("=== Int extensions ===")
IO::println((-7).abs())                // 7
IO::println((-3).sign())               // -1
IO::println(0.sign())                  // 0
IO::println(5.sign())                  // 1
IO::println(4.squared())               // 16
IO::println(3.cubed())                 // 27
IO::println(17.clamp(0, 10))           // 10
IO::println((-5).clamp(-3, 3))         // -3
IO::println(6.isEven().toYesNo())      // yes
IO::println(7.isOdd().toYesNo())       // yes
IO::println(13.isPrime().toYesNo())    // yes
IO::println(9.isPrime().toYesNo())     // no
IO::println(12.gcd(8))                 // 4
IO::println(4.lcm(6))                  // 12
IO::println(2.pow(10))                 // 1024
IO::println(123.digitCount())          // 3
IO::println(493.sumDigits())           // 16
IO::println(42.lpad(6))               //     42

IO::println("")
IO::println("=== Long extensions ===")
IO::println(255L.toHex())             // ff
IO::println(10L.toBinary())           // 1010
IO::println(1536L.humanBytes())       // 1 KB
IO::println((2L * 1024L * 1024L + 512L * 1024L).humanBytes())  // 2.5 MB
IO::println((-128L).abs())            // 128

IO::println("")
IO::println("=== Double extensions ===")
IO::println(3.14159.round(2))         // 3.14
IO::println((-1.7).abs().round(1))    // 1.7
IO::println(2.5.clamp(1.0, 2.0))     // 2.0
IO::println(0.0.lerp(10.0, 0.25))    // 2.5
IO::println(75.0.percent(200.0))      // 37.5
IO::println(5.5.between(3.0, 7.0).toYesNo())  // yes

IO::println("")
IO::println("=== Boolean extensions ===")
IO::println(true.toInt())             // 1
IO::println(false.toYesNo())          // no
IO::println(false.toggle())           // true

IO::println("")
IO::println("=== String extensions ===")
IO::println("hi".repeat(3))           // hihihi
IO::println("hello".shout())          // HELLO!
IO::println("racecar".isPalindrome().toYesNo())  // yes
IO::println("world".isPalindrome().toYesNo())    // no
IO::println("banana".countChar("a"))  // 3
IO::println("left".lpad(8))          //     left
IO::println("right".rpad(8) + "|")   // right   |

val ws: List[String] = "the quick brown fox".words()
IO::println(ws.size)                  // 4
IO::println(ws.joinWith(", "))        // the, quick, brown, fox
IO::println(ws.longestLength())       // 5

IO::println("")
IO::println("=== Chaining extensions ===")
val score: Int = 47
val pct: Double = score.doubleValue().percent(60.0)
IO::println("score #{score}/60 = #{pct}%")  // score 47/60 = 78.3%

IO::println(((8 % 2 == 0) && 8.isPrime().toggle()).toYesNo())  // yes: even AND not-prime

IO::println("")
IO::println("=== Extensions inside pipelines ===")
val nums: List[Int] = [3, -7, 2, 9, -1, 5, 4, 6]
val positives: List[Int] = nums.filter { n -> (n as Int) > 0 }
val primes: List[Int]    = nums.filter { n -> (n as Int).abs().isPrime() }
val squares: List[Int]   = positives.map { n -> (n as Int).squared() }
IO::println("positives: " + positives.size)   // 6
IO::println("primes (abs): " + primes.size)   // 4
IO::println("squares of positives: " + squares.map { s -> "" + s }.joinWith(" "))

IO::println("")
IO::println("=== Record and stats demo ===")
val r: IntRange = new IntRange(5, 15)
IO::println("range #{r.lo()}..#{r.hi()} size=#{r.size()} mid=#{r.midpoint()}")
IO::println("contains 10: " + r.contains(10).toYesNo())
IO::println("contains  3: " + r.contains(3).toYesNo())

val samples: List[Double] = [2.5, 4.0, 3.7, 1.1, 5.2, 3.3, 2.8, 4.6]
val ds: DescriptiveStats = StatsHelper::compute(samples)
IO::println("n=#{ds.count()} sum=#{ds.sum().round(2)} mean=#{ds.mean()}")
IO::println("min=#{ds.min()} max=#{ds.max()} range=#{ds.range()}")
IO::println("median=#{StatsHelper::median(samples)}")

IO::println("")
IO::println("=== Primes table (extensions in loops) ===")
var line: String = ""
foreach n: Int in 2..<50 {
  if n.isPrime() { line = line + n.lpad(3) }
}
IO::println(line.trim())
