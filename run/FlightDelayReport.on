    new Flight("AA104", "AmericanAir",  "MIA", "LAX",  780,  782,   2),
    new Flight("AA105", "AmericanAir",  "LAX", "SEA",  900,   -1,  -1),
    new Flight("UA201", "UnitedAir",    "SFO", "JFK",  420,  440,  20),
    new Flight("UA202", "UnitedAir",    "JFK", "LAX",  540,  595,  55),
    new Flight("UA203", "UnitedAir",    "LAX", "ORD",  660,  663,   3),
    new Flight("UA204", "UnitedAir",    "ORD", "DFW",  840,   -1,  -1),
    new Flight("UA205", "UnitedAir",    "DFW", "SFO", 1020, 1028,   8),
    new Flight("DL301", "DeltaAir",     "ATL", "JFK",  510,  515,   5),
    new Flight("DL302", "DeltaAir",     "JFK", "LAX",  600,  690,  90),
