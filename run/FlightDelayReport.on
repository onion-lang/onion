// FlightDelayReport.on — Airline flight delay analysis and reporting.
// Exercises: records, data-carrying ADT enum, classes with interface,
// collection pipelines (groupBy/sortedBy/filter/map/fold/find/distinct),
// extension Int/Double, foreach (k,v) on maps, nullable, string
// interpolation, select/is patterns on ADT (including singleton cases).

// ── Records ───────────────────────────────────────────────────────────────────

record Flight(
  id: String,
  airline: String,
  origin: String,
  destination: String,
  scheduledMin: Int,
  actualMin: Int,
  delayMin: Int
)

record AirlineStats(
  name: String,
  total: Int,
  cancelled: Int,
  onTime: Int,
  minorDelay: Int,
  majorDelay: Int,
  avgDelay: Double,
  maxDelay: Int
)

// ── ADT enum: delay severity ──────────────────────────────────────────────────

enum DelayCategory {
  case OnTime
  case Minor(minutes: Int)
  case Major(minutes: Int)
  case Cancelled
public:
  def label(): String = select this {
    case o is OnTime:    "ON TIME   "
    case d is Minor:     "MINOR #{d.minutes()} min"
    case d is Major:     "MAJOR #{d.minutes()} min"
    case c is Cancelled: "CANCELLED "
  }
  def minutesLate(): Int = select this {
    case o is OnTime:    0
    case d is Minor:     d.minutes()
    case d is Major:     d.minutes()
    case c is Cancelled: 9999
  }
}

// ── Interface ─────────────────────────────────────────────────────────────────

interface Reportable {
  def printSummary(): void
  def title(): String
}

// ── Extension methods ─────────────────────────────────────────────────────────

extension Int {
  def toHHMM(): String {
    if self < 0 { return "--:--" }
    val h: Int = self / 60
    val m: Int = self % 60
    val hh: String = if h < 10 { "0" + h } else { "" + h }
    val mm: String = if m < 10 { "0" + m } else { "" + m }
    return hh + ":" + mm
  }
  def classify(): DelayCategory {
    if self < 0   { return new Cancelled()  }
    if self <= 5  { return new OnTime()     }
    if self <= 30 { return new Minor(self)  }
    return new Major(self)
  }
}

extension Double {
  def fmt1(): String {
    val scaled: Int = (self * 10.0) as Int
    val whole: Int  = scaled / 10
    val frac: Int   = scaled % 10
    return "#{whole}.#{frac}"
  }
}

// ── Helpers ───────────────────────────────────────────────────────────────────

def padRight(s: String, n: Int): String {
  var result: String = s
  while result.length() < n { result = result + " " }
  return result
}

def padLeft(s: String, n: Int): String {
  var result: String = s
  while result.length() < n { result = " " + result }
  return result
}

def pct(n: Int, total: Int): String {
  if total == 0 { return "0" }
  return "" + ((n * 100) / total)
}

// ── Sample data ───────────────────────────────────────────────────────────────

def loadFlights(): List[Flight] {
  return [
    new Flight("AA101", "AmericanAir",  "LAX", "JFK",  360,  365,   5),
