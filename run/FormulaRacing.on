val pitStops: List[PitStop] = [
  new PitStop("Hamilton",   4, 2800, "MEDIUM"),
  new PitStop("Verstappen", 3, 2700, "MEDIUM"),
  new PitStop("Leclerc",    5, 3100, "HARD"),
  new PitStop("Perez",      4, 2900, "HARD"),
  new PitStop("Sainz",      5, 3200, "MEDIUM")
]

val events: List[RaceEvent] = [
  new SafetyCar(2, "debris on track"),
  new FastestLap("Verstappen", 10, 92900),
  new PenaltyTime("Leclerc", 5, "track limits violation"),
  new Retirement("Sainz", 9, "engine failure")
]

// ─── Analysis helpers ─────────────────────────────────────────────────────────

def fastestLapMs(laps: List[LapTime]): Int {
  var best: Int = 999999999
  foreach l: LapTime in laps {
    if l.timeMs() < best { best = l.timeMs() }
  }
  return best
}

def totalLapMs(laps: List[LapTime]): Int =
  laps.fold(0) { acc, l -> (acc as Int) + (l as LapTime).timeMs() }

def avgLapMs(laps: List[LapTime]): Int =
  if laps.size == 0 { 0 } else { totalLapMs(laps) / laps.size }

def pitTimeFor(name: String): Int {
  var total: Int = 0
  foreach p: PitStop in pitStops {
    if p.driver() == name { total = total + p.duration() }
  }
  return total
}

def penaltyMsFor(name: String): Int {
  var total: Int = 0
  foreach e: RaceEvent in events {
    select e {
      case pen is PenaltyTime:
        if pen.driver() == name { total = total + pen.seconds() * 1000 }
      else:
    }
  }
  return total
}

val pointsTable: List[Int] = [25, 18, 15, 12, 10, 8, 6, 4, 2, 1]

def pointsFor(pos: Int): Int {
  if pos < 1 || pos > pointsTable.size { return 0 }
  return pointsTable[pos - 1] as Int
}

// ─── Compute retirement set ───────────────────────────────────────────────────

val retiredDrivers: List[String] = []
foreach ev: RaceEvent in events {
  select ev {
    case r is Retirement: retiredDrivers.add(r.driver())
    else:
  }
}

def isRetired(name: String): Boolean {
  var found: Boolean = false
  foreach n: String in retiredDrivers { if n == name { found = true } }
  return found
}

// ─── Build per-driver stats ───────────────────────────────────────────────────

val lapsByDriver = rawLaps.groupBy { l -> (l as LapTime).driver() }

// Compute race totals for all drivers
val raceResults: List[RaceResult] = []

foreach drv: Driver in drivers {
  val name: String = drv.name()
  val driverLaps = lapsByDriver.get(name)
  if driverLaps != null {
    val laps = driverLaps as List[LapTime]
    val lapTotal: Int  = totalLapMs(laps)
    val pitTotal: Int  = pitTimeFor(name)
    val penalty: Int   = penaltyMsFor(name)
    val raceTotal: Int = lapTotal + pitTotal + penalty
    val fastest: Int   = fastestLapMs(laps)
    raceResults.add(new RaceResult(name, 0, raceTotal, fastest, 0))
  }
}

// Separate active finishers from retirements, sort active by time
val active = raceResults.filter { r -> !isRetired((r as RaceResult).driver()) }
val dnf    = raceResults.filter { r -> isRetired((r as RaceResult).driver()) }
val sortedActive = active.sortedBy { r -> (r as RaceResult).totalMs() }

// Assign positions and points
val finalResults: List[RaceResult] = []
var pos: Int = 1
foreach r: RaceResult in sortedActive {
  val pts: Int = pointsFor(pos)
  finalResults.add(new RaceResult(r.driver(), pos, r.totalMs(), r.fastestLap(), pts))
  pos = pos + 1
}
foreach r: RaceResult in dnf {
  finalResults.add(new RaceResult(r.driver(), 0, r.totalMs(), r.fastestLap(), 0))
}

// ─── Race Report ──────────────────────────────────────────────────────────────

val leaderTime: Int = if sortedActive.size > 0 { (sortedActive[0] as RaceResult).totalMs() } else { 0 }

IO::println("══════════════════════════════════════════════════")
IO::println("          FORMULA RACING — RACE RESULTS           ")
IO::println("══════════════════════════════════════════════════")

val header: String =
  "POS".padRight(4) + "DRIVER".padRight(13) + "TOTAL".padRight(12) +
  "FASTEST".padRight(12) + "GAP".padRight(14) + "PTS"
IO::println(header)
IO::println("──────────────────────────────────────────────────")

foreach r: RaceResult in finalResults {
  val posStr: String = if r.position() == 0 { "DNF" } else { "" + r.position() }
  val gapStr: String = if r.position() == 0 { "+DNF          " }
                       else if r.position() == 1 { "LEADER        " }
                       else { r.totalMs().gapTo(leaderTime).padRight(14) }
  val row: String =
    posStr.padRight(4) +
    r.driver().padRight(13) +
    r.totalMs().toRaceTime().padRight(12) +
    r.fastestLap().toRaceTime().padRight(12) +
    gapStr +
    r.points()
  IO::println(row)
}

IO::println("══════════════════════════════════════════════════")

// ─── Sector analysis ─────────────────────────────────────────────────────────

IO::println("\n── Lap-by-Lap Highlight (laps 6-10) ─────────────")
val lateLaps = rawLaps.filter { l -> (l as LapTime).lap() >= 6 }
val lateLapsByDriver = lateLaps.groupBy { l -> (l as LapTime).driver() }
foreach drv: Driver in drivers {
  if !isRetired(drv.name()) {
    val laps = lateLapsByDriver.get(drv.name())
    if laps != null {
      val lapList = laps as List[LapTime]
      val fastLate: Int = fastestLapMs(lapList)
      val avgLate: Int  = avgLapMs(lapList)
      IO::println("  #{drv.name().padRight(12)} best=#{fastLate.toRaceTime()} avg=#{avgLate.toRaceTime()}")
    }
  }
}

// ─── Pit stop summary ────────────────────────────────────────────────────────

IO::println("\n── Pit Stop Summary ──────────────────────────────")
val sortedPits = pitStops.sortedBy { p -> (p as PitStop).duration() }
foreach p: PitStop in sortedPits {
  val tyre: String = p.tyre()
  val compound: TyreCompound = select tyre {
    case "SOFT":   TyreCompound::SOFT
    case "MEDIUM": TyreCompound::MEDIUM
    else:          TyreCompound::HARD
  }
  IO::println("  #{p.driver().padRight(12)} lap #{p.lap()} | #{p.duration()}ms | #{tyre} (degradation=#{compound.degradation()}/lap)")
}

// ─── Race events log ─────────────────────────────────────────────────────────

IO::println("\n── Race Events ───────────────────────────────────")
foreach e: RaceEvent in events {
  IO::println("  " + e.describe())
}

// ─── Championship points (cumulative after this race) ────────────────────────

IO::println("\n── Points Standings ──────────────────────────────")
val pointsByDriver = finalResults.sortedBy { r -> -(r as RaceResult).points() }
foreach r: RaceResult in pointsByDriver {
  val bar: String = {
    var b: String = ""
    var i: Int = 0
    while i < r.points() / 2 { b = b + "█"; i++ }
    b
  }
  IO::println("  #{r.driver().padRight(12)} #{("" + r.points()).padLeft(3)} pts  #{bar}")
}

// ─── Statistics ───────────────────────────────────────────────────────────────

IO::println("\n── Race Statistics ───────────────────────────────")
val allTimes = rawLaps.map { l -> (l as LapTime).timeMs() }
val totalLaps: Int = rawLaps.size
val overallFastest: Int = allTimes.fold(999999999) { best, t -> {
  val bestInt: Int = best as Int
  val tInt: Int = t as Int
  if tInt < bestInt { tInt } else { bestInt }
}}
IO::println("  Total laps recorded: #{totalLaps}")
IO::println("  Overall fastest:     #{overallFastest.toRaceTime()} (Verstappen lap 10)")
IO::println("  Active finishers:    #{sortedActive.size}")
IO::println("  Retirements:        #{dnf.size}")
