  new LapTime("Verstappen", 7, 93100), new LapTime("Verstappen", 8, 93000),
  new LapTime("Verstappen", 9, 93200), new LapTime("Verstappen",10, 92900),
  new LapTime("Leclerc",    1, 96200), new LapTime("Leclerc",    2, 94700),
  new LapTime("Leclerc",    3, 94300), new LapTime("Leclerc",    4, 94000),
