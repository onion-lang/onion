// FormulaRacing — Formula 1 race simulation and lap analysis
// Features exercised:
//   records with from re"..." parser; data-carrying enum; ADT case-enum
//   extension methods; collection pipelines (groupBy/sortedBy/fold/filter/map/partition)
//   foreach over maps and ranges; string interpolation; nullable / null checks
//   select / type-pattern matching with guards; closures; try/catch; recursion
//   while loops; do[Option] notation

import { java.util.* }

// ─── Domain records ───────────────────────────────────────────────────────────

record Driver(name: String, nationality: String, number: Int)

record LapTime(driver: String, lap: Int, timeMs: Int)
  from re"(\w+) (\d+) (\d+)"

record PitStop(driver: String, lap: Int, duration: Int, tyre: String)

record RaceResult(driver: String, position: Int, totalMs: Int, fastestLap: Int, points: Int)

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TyreCompound {
  SOFT, MEDIUM, HARD
public:
  def degradation(): Int = select this {
    case TyreCompound::SOFT:   15
    case TyreCompound::MEDIUM: 8
    case TyreCompound::HARD:   4
  }
  def gripBonus(): Int = select this {
    case TyreCompound::SOFT:   12
    case TyreCompound::MEDIUM: 6
    case TyreCompound::HARD:   0
  }
  def label(): String = select this {
    case TyreCompound::SOFT:   "S"
    case TyreCompound::MEDIUM: "M"
    case TyreCompound::HARD:   "H"
  }
}

enum RaceEvent {
  case SafetyCar(lap: Int, reason: String)
  case FastestLap(driver: String, lap: Int, timeMs: Int)
  case Retirement(driver: String, lap: Int, cause: String)
  case PenaltyTime(driver: String, seconds: Int, reason: String)
public:
  def describe(): String = select this {
    case sc is SafetyCar:    "Safety car lap #{sc.lap()}: #{sc.reason()}"
    case fl is FastestLap:   "Fastest lap: #{fl.driver()} lap #{fl.lap()} #{fl.timeMs()}ms"
    case dnf is Retirement:  "DNF: #{dnf.driver()} lap #{dnf.lap()} - #{dnf.cause()}"
    case pen is PenaltyTime: "Penalty: #{pen.driver()} +#{pen.seconds()}s (#{pen.reason()})"
  }
  def isIncident(): Boolean = select this {
    case dnf2 is Retirement: true
    else: false
  }
}

// ─── Extensions ───────────────────────────────────────────────────────────────

extension Int {
  def toRaceTime(): String {
    val mins: Int  = self / 60000
    val secs: Int  = (self % 60000) / 1000
    val ms: Int    = self % 1000
    val secStr: String = if secs < 10 { "0" + secs } else { "" + secs }
    val msStr: String  = if ms < 100 { if ms < 10 { "00" + ms } else { "0" + ms } } else { "" + ms }
    return "#{mins}:#{secStr}.#{msStr}"
  }
  def gapTo(other: Int): String {
    val diff: Int = self - other
    if diff == 0 { return "LEADER" }
    val sign: String = if diff < 0 { "-" } else { "+" }
    return sign + (if diff < 0 { -diff } else { diff }).toRaceTime()
  }
}

extension String {
  def padRight(width: Int): String {
    var s: String = self
    while s.length() < width { s = s + " " }
    return s
  }
  def padLeft(width: Int): String {
    var s: String = self
    while s.length() < width { s = " " + s }
    return s
  }
}

// ─── Sample data ──────────────────────────────────────────────────────────────

val drivers: List[Driver] = [
  new Driver("Hamilton",  "GBR", 44),
  new Driver("Verstappen","NED", 1),
  new Driver("Leclerc",   "MON", 16),
  new Driver("Perez",     "MEX", 11),
  new Driver("Sainz",     "ESP", 55)
]

// Lap times in ms — first 10 laps for each driver
val rawLaps: List[LapTime] = [
