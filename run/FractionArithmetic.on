// Rational-number (fraction) arithmetic library and demo.
// Exercises: records + operator methods, extension methods on Int,
// ADT enums, select / pattern matching, collection pipelines,
// recursion, foreach on ranges, string interpolation, nullable.

// ── GCD helper via extension on Int ─────────────────────────────────────────

extension Int {
  def gcd(other: Int): Int = {
    val a = if self < 0 { -self } else { self }
    val b = if other < 0 { -other } else { other }
    if b == 0 { a } else { b.gcd(a % b) }
  }
}

// ── Fraction record with full arithmetic ────────────────────────────────────

record Fraction(num: Int, den: Int) {
public:
  static def of(n: Int, d: Int): Fraction = {
    if d == 0 { throw new ArithmeticException("denominator cannot be zero") }
    val sign  = if d < 0 { -1 } else { 1 }
    val n2    = n * sign
    val d2    = d * sign
    val g     = n2.gcd(d2)
    new Fraction(n2 / g, d2 / g)
  }
  static def whole(n: Int): Fraction = Fraction::of(n, 1)

  def plus(o: Fraction): Fraction   = Fraction::of(num() * o.den() + o.num() * den(), den() * o.den())
  def minus(o: Fraction): Fraction  = Fraction::of(num() * o.den() - o.num() * den(), den() * o.den())
  def times(o: Fraction): Fraction  = Fraction::of(num() * o.num(), den() * o.den())
  def div(o: Fraction): Fraction    = Fraction::of(num() * o.den(), den() * o.num())

  def negate(): Fraction   = Fraction::of(-num(), den())
  def abs(): Fraction      = Fraction::of(if num() < 0 { -num() } else { num() }, den())
  def recip(): Fraction    = Fraction::of(den(), num())
  def toDouble(): Double   = num() as Double / den() as Double
  def isZero(): Boolean    = num() == 0
  def isWhole(): Boolean   = den() == 1
  def isPositive(): Boolean = num() > 0

  def compareWith(o: Fraction): Int = {
    val cross = num() * o.den() - o.num() * den()
    if cross < 0 { -1 } else if cross > 0 { 1 } else { 0 }
  }

  override def toString(): String =
    if den() == 1 { "#{num()}" } else { "#{num()}/#{den()}" }
}

// ── ADT for expression nodes ─────────────────────────────────────────────────

enum Expr {
  case Lit(value: Fraction)
  case Add(left: Expr, right: Expr)
  case Sub(left: Expr, right: Expr)
  case Mul(left: Expr, right: Expr)
  case Div(left: Expr, right: Expr)
  case Neg(inner: Expr)

public:
  def eval(): Fraction = select this {
    case l is Lit: l.value()
    case a is Add: a.left().eval() + a.right().eval()
    case s is Sub: s.left().eval() - s.right().eval()
    case m is Mul: m.left().eval() * m.right().eval()
    case d is Div: d.left().eval() / d.right().eval()
    case n is Neg: n.inner().eval().negate()
  }

  def show(): String = select this {
    case l is Lit: l.value().toString()
    case a is Add: "(#{a.left().show()} + #{a.right().show()})"
    case s is Sub: "(#{s.left().show()} - #{s.right().show()})"
    case m is Mul: "(#{m.left().show()} * #{m.right().show()})"
    case d is Div: "(#{d.left().show()} / #{d.right().show()})"
    case n is Neg: "(-#{n.inner().show()})"
  }
}

// ── Helpers to build Expr nodes ─────────────────────────────────────────────

def lit(n: Int, d: Int): Expr = new Lit(Fraction::of(n, d))
def litW(n: Int): Expr        = new Lit(Fraction::whole(n))

// ── Statistics over a list of Fractions ─────────────────────────────────────

def fractionSum(fs: List[Fraction]): Fraction = {
  var acc = Fraction::of(0, 1)
  foreach f: Fraction in fs { acc = acc + f }
  return acc
}

def fractionMin(fs: List[Fraction]): Fraction? = {
  if fs.size == 0 { return null }
  var m: Fraction = fs[0] as Fraction
  foreach f: Fraction in fs { if f.compareWith(m) < 0 { m = f } }
  return m
}

def fractionMax(fs: List[Fraction]): Fraction? = {
  if fs.size == 0 { return null }
  var m: Fraction = fs[0] as Fraction
  foreach f: Fraction in fs { if f.compareWith(m) > 0 { m = f } }
  return m
}

// ── Brute-force best rational approximation ──────────────────────────────────
// Scans all n/d with 1 ≤ d ≤ maxDen and finds the fraction closest to target.

def bestApprox(target: Double, maxDen: Int): Fraction {
  var best = Fraction::of(1, 1)
  var bestDist = (target - 1.0) * (target - 1.0)
  foreach d: Int in 1..maxDen {
    val n = (target * (d as Double) + 0.5) as Int
    if n < 0 { continue }
    val f = Fraction::of(n, d)
    val dist = (target - f.toDouble()) * (target - f.toDouble())
    if dist < bestDist { best = f; bestDist = dist }
  }
  return best
}

// ── Harmonic numbers: H(n) = 1 + 1/2 + ... + 1/n ───────────────────────────

def harmonic(n: Int): Fraction {
  var acc = Fraction::of(0, 1)
  foreach k: Int in 1..n { acc = acc + Fraction::of(1, k) }
  return acc
}

// ── Main demo ────────────────────────────────────────────────────────────────

println("=== Fraction Arithmetic Demo ===")
IO::println("")

// Basic arithmetic
val half    = Fraction::of(1, 2)
val third   = Fraction::of(1, 3)
val quarter = Fraction::of(1, 4)

println("1/2 + 1/3 = #{half + third}")
println("1/2 - 1/3 = #{half - third}")
println("1/2 * 2/3 = #{half * Fraction::of(2, 3)}")
println("1/2 / 1/4 = #{half / quarter}")
println("negate(3/4) = #{Fraction::of(3, 4).negate()}")
println("recip(2/5)  = #{Fraction::of(2, 5).recip()}")
IO::println("")

// Reduction check
println("6/8   reduces to: #{Fraction::of(6, 8)}")
println("15/-9 reduces to: #{Fraction::of(15, -9)}")
println("100/25 reduces to: #{Fraction::of(100, 25)}")
IO::println("")

// Expression tree evaluation
val expr1 = new Add(lit(1, 2), new Mul(lit(2, 3), lit(3, 4)))
println("#{expr1.show()} = #{expr1.eval()}")

val expr2 = new Div(new Sub(litW(1), lit(1, 3)), lit(2, 3))
println("#{expr2.show()} = #{expr2.eval()}")

val expr3 = new Neg(new Add(lit(1, 6), lit(1, 3)))
println("#{expr3.show()} = #{expr3.eval()}")
IO::println("")

// Harmonic numbers
println("Harmonic numbers H(1)..H(8):")
foreach n: Int in 1..8 {
  val h = harmonic(n)
  println("  H(#{n}) = #{h}")
}
IO::println("")

// Collection pipeline: filter positive, sort, sum
val fracs: List[Fraction] = [
  Fraction::of(3, 7),  Fraction::of(-1, 5), Fraction::of(2, 3),
  Fraction::of(1, 6),  Fraction::of(-3, 4), Fraction::of(5, 8),
  Fraction::of(1, 2),  Fraction::of(7, 12)
]

val positives: List[Fraction] = fracs.filter { f: Fraction -> f.isPositive() }
println("Positive fractions (#{positives.size}):")
positives.sortedBy { f: Fraction -> f.toDouble() }.forEach { f: Fraction ->
  println("  #{f}")
}

val total = fractionSum(positives)
println("Sum of positives: #{total}")
val mn = fractionMin(positives)
val mx = fractionMax(positives)
if mn != null && mx != null { println("Min: #{mn}  Max: #{mx}") }
IO::println("")

// Best rational approximations
println("Best rational approximations (maxDen=20):")
val targets: List[Double] = [0.333333, 0.142857, 3.14159, 1.41421, 0.693147]
foreach t: Double in targets {
  val approx = bestApprox(t, 20)
  println("  #{t} ≈ #{approx}")
}
IO::println("")

// Comparison
val a = Fraction::of(5, 7)
val b = Fraction::of(7, 10)
val cmp = a.compareWith(b)
val rel = if cmp < 0 { "<" } else if cmp > 0 { ">" } else { "=" }
println("5/7 #{rel} 7/10  (#{a.toDouble()} vs #{b.toDouble()})")
IO::println("")
println("Done.")
