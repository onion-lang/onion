val CURRENT_YEAR: Int = 2026

// ─── Overview ─────────────────────────────────────────────────────────────────

printSection("=== " + catalog.catalogTitle() + " ===")
IO::println("  Entries: #{catalog.entryCount()}  |  Total weight: #{catalog.totalWeight().fmt1()} g")
IO::println("  Avg hardness: #{catalog.averageHardness().fmt1()} (Mohs)")

// ─── Full catalog listing ─────────────────────────────────────────────────────

printSection("=== Full Catalog ===")
foreach e: CollectionEntry in catalog.hardestFirst() {
  val m: Mineral = e.mineral()
  IO::println("  " + m.name().rpad(14) + " H=" + m.mohsHardness().fmt1().lpad(4) +
    "  " + m.crystalSystem().shortName().rpad(6) +
    "  " + rarityStars(m.rarity()).rpad(6) +
    "  " + e.statusLabel().rpad(10) +
    "  " + m.luster().description())
}

// ─── Hardness group distribution ─────────────────────────────────────────────

printSection("=== Hardness Group Distribution ===")
val hardGroups: Map[String, Int] = [:]
foreach e: CollectionEntry in catalog.getEntries() {
  val grp: String = e.mineral().hardnessGroup()
  val c: Int? = hardGroups[grp]
  hardGroups[grp] = if c == null { 1 } else { c + 1 }
}
val orderedGroups: List[String] = ["Soft (< 3)", "Medium (3-6)", "Hard (6-8)", "Very Hard (8+)"]
foreach grp: String in orderedGroups {
  val cnt: Int? = hardGroups[grp]
  if cnt != null {
    val bar: String = "|".repeat(cnt)
    IO::println("  " + grp.rpad(18) + " " + cnt.lpadN(3) + "  " + bar)
  }
}

// ─── Chemical group breakdown ─────────────────────────────────────────────────

printSection("=== Chemical Group Breakdown ===")
val groupCounts: Map[String, Int] = catalog.groupCounts()
val sortedGroups: List[String] = groupCounts.keys().sortedBy { k ->
  val c: Int? = groupCounts[k as String]
  0 - (if c == null { 0 } else { c })
}
foreach g: Object in sortedGroups {
  val gs: String = g as String
  val cnt: Int = (groupCounts[gs]) ?: 0
  val bar: String = "*".repeat(cnt)
  IO::println("  " + gs.rpad(6) + " " + cnt.lpadN(3) + "  " + bar)
}

// ─── Crystal system analysis ──────────────────────────────────────────────────

printSection("=== Crystal System Distribution ===")
val sysCounts: Map[String, Int] = [:]
foreach e: CollectionEntry in catalog.getEntries() {
  val sys: String = e.mineral().crystalSystem().shortName()
  val c: Int? = sysCounts[sys]
  sysCounts[sys] = if c == null { 1 } else { c + 1 }
}
foreach (sys, cnt) in sysCounts {
  val bar: String = "=".repeat(cnt as Int)
  IO::println("  " + (sys as String).rpad(8) + " " + (cnt as Int).lpadN(3) + "  " + bar)
}

// ─── Gem-quality specimens ────────────────────────────────────────────────────

printSection("=== Gem-Quality Specimens ===")
val gems: List[CollectionEntry] = catalog.gemQualityEntries()
IO::println("  #{gems.size} gem-quality entries (H>=7 and Rare+):")
foreach e: CollectionEntry in gems {
  val m: Mineral = e.mineral()
  IO::println("  * #{m.name().rpad(14)} #{m.mainColor().rpad(12)} #{rarityStars(m.rarity())} — #{m.description()}")
}

// ─── Status breakdown ─────────────────────────────────────────────────────────

printSection("=== Collection Status ===")
val owned:    List[CollectionEntry] = catalog.byStatus(CollectionStatus::Owned)
val wishlist: List[CollectionEntry] = catalog.byStatus(CollectionStatus::Wishlist)
val loaned:   List[CollectionEntry] = catalog.byStatus(CollectionStatus::Loaned)
val forsale:  List[CollectionEntry] = catalog.byStatus(CollectionStatus::ForSale)
IO::println("  Owned:    #{owned.size}")
IO::println("  Wishlist: #{wishlist.size}")
IO::println("  Loaned:   #{loaned.size}")
IO::println("  For Sale: #{forsale.size}")
