  IO::println("  Loaned items:")
  foreach e: CollectionEntry in loaned {
    IO::println("    - #{e.mineral().name()} (#{e.notes()})")
  }
}

// ─── Silicate family detail ───────────────────────────────────────────────────

printSection("=== Silicate Minerals ===")
val silicates: List[CollectionEntry] = catalog.byGroup(ChemicalGroup::Silicate)
IO::println("  #{silicates.size} silicate entries, sorted by hardness:")
val silicatesSorted: List[CollectionEntry] = silicates.sortedBy { e ->
  0.0 - (e as CollectionEntry).mineral().mohsHardness()
}.map { e -> e as CollectionEntry }
foreach e: CollectionEntry in silicatesSorted {
  val m: Mineral = e.mineral()
  IO::println("  #{m.name().rpad(14)} #{m.crystalSystem().shortName().rpad(6)} H=#{m.mohsHardness().fmt1()}")
}

// ─── Acquisition timeline ─────────────────────────────────────────────────────

printSection("=== Acquisition Timeline ===")
val byYear: Map[String, Int] = [:]
foreach e: CollectionEntry in catalog.getEntries() {
  val yr: String = "" + e.acquisitionYear()
  val c: Int? = byYear[yr]
  byYear[yr] = if c == null { 1 } else { c + 1 }
}
val years: List[String] = byYear.keys().sortedBy { k -> k as String }
foreach yr: Object in years {
  val yrs: String = yr as String
  val cnt: Int = (byYear[yrs]) ?: 0
  val bar: String = "+".repeat(cnt)
  IO::println("  " + yrs + " " + cnt.lpadN(3) + "  " + bar)
}

// ─── Hardness statistics (fold + recursion) ──────────────────────────────────

printSection("=== Hardness Statistics ===")

def hardnessMax(entries: List[CollectionEntry], idx: Int, current: Double): Double {
  if idx >= entries.size { return current }
  val h: Double = (entries.get(idx) as CollectionEntry).mineral().mohsHardness()
  return hardnessMax(entries, idx + 1, if h > current { h } else { current })
}

def hardnessMin(entries: List[CollectionEntry], idx: Int, current: Double): Double {
  if idx >= entries.size { return current }
  val h: Double = (entries.get(idx) as CollectionEntry).mineral().mohsHardness()
  return hardnessMin(entries, idx + 1, if h < current { h } else { current })
}

val allEntries: List[CollectionEntry] = catalog.getEntries()
val hMax: Double = hardnessMax(allEntries, 1, (allEntries.get(0) as CollectionEntry).mineral().mohsHardness())
val hMin: Double = hardnessMin(allEntries, 1, (allEntries.get(0) as CollectionEntry).mineral().mohsHardness())
val hAvg: Double = catalog.averageHardness()

IO::println("  Min: #{hMin.fmt1()}  Max: #{hMax.fmt1()}  Avg: #{hAvg.fmt1()}")
IO::println("  Harder than avg: " + catalog.getEntries().filter { e ->
  (e as CollectionEntry).mineral().mohsHardness() > hAvg
}.size + " / " + catalog.entryCount())

// ─── Rarity distribution ──────────────────────────────────────────────────────

printSection("=== Rarity Distribution ===")
val rarityCounts: Map[String, Int] = [:]
foreach e: CollectionEntry in catalog.getEntries() {
  val r: String = "" + e.mineral().rarity()
  val c: Int? = rarityCounts[r]
  rarityCounts[r] = if c == null { 1 } else { c + 1 }
}
val rarityOrder: List[String] = ["Common", "Uncommon", "Rare", "VeryRare", "Exceptional"]
foreach rr: String in rarityOrder {
  val cnt: Int? = rarityCounts[rr]
  if cnt != null {
    IO::println("  " + rr.rpad(12) + " " + cnt.lpadN(3) + "  " + rarityStars(
      select rr {
        case "Common":      Rarity::Common
        case "Uncommon":    Rarity::Uncommon
        case "Rare":        Rarity::Rare
        case "VeryRare":    Rarity::VeryRare
        case "Exceptional": Rarity::Exceptional
        else:               Rarity::Common
      }
    ))
  }
}

// ─── Zip: mineral paired with age in collection ──────────────────────────────

printSection("=== Collection Ages ===")
val entryList: List[CollectionEntry] = catalog.hardestFirst()
val names: List[String] = entryList.map { e -> (e as CollectionEntry).mineral().name() }
val ages: List[Int]    = entryList.map { e -> (e as CollectionEntry).age(CURRENT_YEAR) }
val paired = names.zip(ages)
foreach pair: Object in paired {
  val p: List[Object] = pair as List[Object]
  val nm:  String = p[0] as String
  val age: Int    = p[1] as Int
  IO::println("  " + nm.rpad(14) + " " + age.lpadN(3) + " yr" + (if age == 1 { "" } else { "s" }))
}

IO::println("")
IO::println("=== Collection analysis complete ===")
