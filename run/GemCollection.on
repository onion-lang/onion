// GemCollection.on — mineral and gemstone collection management system
// Exercises: records with methods, data-carrying enums, ADT enums, classes,
//   interfaces, generics, collection pipelines (map/filter/fold/groupBy/
//   sortedBy/distinct/find/partition/zip), select/pattern matching, nullable,
//   closures, string interpolation, try/catch, recursion, while, foreach.

// ─── Plain enums ──────────────────────────────────────────────────────────────

enum Rarity { Common, Uncommon, Rare, VeryRare, Exceptional }

enum CollectionStatus { Owned, Wishlist, Loaned, ForSale }

// ─── Data-carrying enums ──────────────────────────────────────────────────────

enum CrystalSystem(shortName: String, axisCount: Int) {
  Cubic("Cubic", 3),
  Hexagonal("Hex", 4),
  Tetragonal("Tet", 3),
  Orthorhombic("Orth", 3),
  Monoclinic("Mono", 3),
  Triclinic("Tri", 3),
  Amorphous("Amrph", 0)
}

enum ChemicalGroup(symbol: String) {
  Silicate("Si"),
  Oxide("Ox"),
  Carbonate("CO3"),
  Sulfide("S"),
  Halide("Hal"),
  Native("Nat"),
  Phosphate("PO4"),
  Sulfate("SO4")
}

// ─── ADT enum: LusterType ─────────────────────────────────────────────────────

enum LusterType {
  case Metallic
  case Vitreous(transparency: String)
  case Adamantine
  case Resinous
  case Silky(fibrous: Boolean)
  case Waxy
  case Earthy
public:
  def description(): String = select this {
    case m is Metallic:  "metallic"
    case v is Vitreous:  "vitreous (#{v.transparency()})"
    case a is Adamantine: "adamantine"
    case r is Resinous:  "resinous"
    case s is Silky:     if s.fibrous() { "silky/fibrous" } else { "silky" }
    case w is Waxy:      "waxy"
    case e is Earthy:    "earthy"
  }
}

// ─── Extensions ───────────────────────────────────────────────────────────────

extension Double {
  def fmt1(): String {
    val i: Int = (self * 10.0 + 0.5) as Int
    return "" + (i / 10) + "." + (i % 10)
  }
}

extension String {
  def rpad(w: Int): String {
    var s: String = self
    while s.length() < w { s = s + " " }
    return s
  }
  def lpad(w: Int): String {
    var s: String = self
    while s.length() < w { s = " " + s }
    return s
  }
  def repeat(n: Int): String {
    var s: String = ""
    foreach _: Int in 1..n { s = s + self }
    return s
  }
}

extension Int {
  def lpadN(w: Int): String {
    var s: String = "" + self
    while s.length() < w { s = " " + s }
    return s
  }
}

// ─── Records ──────────────────────────────────────────────────────────────────

record Mineral(
  name:          String,
  formula:       String,
  group:         ChemicalGroup,
  crystalSystem: CrystalSystem,
  mohsHardness:  Double,
  luster:        LusterType,
  rarity:        Rarity,
  mainColor:     String,
  description:   String
) {
public:
  def hardnessGroup(): String =
    if mohsHardness() < 3.0      { "Soft (< 3)" }
    else if mohsHardness() < 6.0 { "Medium (3-6)" }
    else if mohsHardness() < 8.0 { "Hard (6-8)" }
    else                          { "Very Hard (8+)" }

  def isGemQuality(): Boolean = mohsHardness() >= 7.0 && rarity().ordinal() >= Rarity::Rare.ordinal()

  def shortLabel(): String = "#{name()} (#{formula()}) H=#{mohsHardness().fmt1()}"
}

record CollectionEntry(
  mineral:      Mineral,
  sampleWeight: Double,
  acquisitionYear: Int,
  source:       String,
  status:       CollectionStatus,
  notes:        String
) {
public:
  def statusLabel(): String = select status() {
    case CollectionStatus::Owned:    "Owned"
    case CollectionStatus::Wishlist: "Wishlist"
    case CollectionStatus::Loaned:   "Loaned"
    case CollectionStatus::ForSale:  "For Sale"
    else:                            "Unknown"
  }
  def age(currentYear: Int): Int = currentYear - acquisitionYear()
  def label(): String =
    "#{mineral().name()} | #{sampleWeight().fmt1()}g | #{source()} | #{statusLabel()}"
}

// ─── Interface ────────────────────────────────────────────────────────────────

interface Catalogable {
  def entryCount(): Int
  def catalogTitle(): String
}

// ─── MineralCatalog ───────────────────────────────────────────────────────────

class MineralCatalog conforms Catalogable {
  val entries: List[CollectionEntry]
  val title:   String

public:
  def this(t: String) {
    this.title   = t
    this.entries = []
  }

  def addEntry(e: CollectionEntry): void { entries.add(e) }
  def getEntries(): List[CollectionEntry]  = entries
  def entryCount(): Int                    = entries.size
  def catalogTitle(): String               = title

  def findByName(name: String): CollectionEntry? =
    entries.find { e -> (e as CollectionEntry).mineral().name() == name }

  def byGroup(g: ChemicalGroup): List[CollectionEntry] =
    entries.filter { e -> (e as CollectionEntry).mineral().group() == g }
           .map    { e -> e as CollectionEntry }

  def byStatus(s: CollectionStatus): List[CollectionEntry] =
    entries.filter { e -> (e as CollectionEntry).status() == s }
           .map    { e -> e as CollectionEntry }

  def hardestFirst(): List[CollectionEntry] =
    entries.sortedBy { e -> 0.0 - (e as CollectionEntry).mineral().mohsHardness() }
           .map { e -> e as CollectionEntry }

  def gemQualityEntries(): List[CollectionEntry] =
    entries.filter { e -> (e as CollectionEntry).mineral().isGemQuality() }
           .map    { e -> e as CollectionEntry }

  def totalWeight(): Double =
    entries.fold(0.0) { acc, e -> (acc as Double) + (e as CollectionEntry).sampleWeight() } as Double

  def groupCounts(): Map[String, Int] {
    val counts: Map[String, Int] = [:]
    foreach e: CollectionEntry in entries {
      val key: String = e.mineral().group().symbol()
      val c: Int? = counts[key]
      counts[key] = if c == null { 1 } else { c + 1 }
    }
    return counts
  }

  def averageHardness(): Double {
    val n: Int = entries.size
    if n == 0 { return 0.0 }
    val sum: Double = entries.fold(0.0) { acc, e ->
      (acc as Double) + (e as CollectionEntry).mineral().mohsHardness()
    } as Double
    return sum / n
  }
}

// ─── Analysis helpers ─────────────────────────────────────────────────────────

def rarityStars(r: Rarity): String = select r {
  case Rarity::Common:      "*"
  case Rarity::Uncommon:    "**"
  case Rarity::Rare:        "***"
  case Rarity::VeryRare:    "****"
  case Rarity::Exceptional: "*****"
  else:                     "?"
}

def hr(n: Int): void {
  var s: String = ""
  foreach _: Int in 1..n { s = s + "-" }
  IO::println(s)
}

def printSection(title: String): void {
  IO::println("")
  IO::println(title)
  hr(title.length())
}

// ─── Mineral data ─────────────────────────────────────────────────────────────

