// GraphAlgorithms.on — weighted directed/undirected graph with BFS, DFS,
// Dijkstra's shortest path, cycle detection, and topological sort (Kahn).
//
// Exercises: records, ADT case-enum, homogeneous enum, classes, HashMap,
// ArrayList, collection pipelines (map/filter/fold/sortedBy/groupBy),
// extension Int, closures, nullable types, while/foreach, select / type
// patterns, string interpolation, try/catch, do[Option] notation.

import {
  java.util.HashMap;
  java.util.ArrayList;
  java.lang.Integer as JInteger;
}

// ── Fundamental records ───────────────────────────────────────────────────────

record Edge(to: Int, label: String, weight: Int)

record PathResult(nodes: List[Int], labels: List[String], totalWeight: Int) {
public:
  def describe(g: Graph): String {
    if nodes().size == 0 { return "(no path)" }
    var s = ""
    var i = 0
    while i < nodes().size {
      val id = nodes()[i] as Int
      s = s + g.label(id)
      if i < labels().size {
        s = s + " --[#{labels()[i] as String}]--> "
      }
      i++
    }
    return s + " (#{totalWeight()} units)"
  }
}

record TopoResult(order: List[Int], hasCycle: Boolean)

record GraphStats(
  nodeCount: Int,
  edgeCount: Int,
  totalDegree: Int,
  maxDegreeNode: Int,
  isConnected: Boolean
)

// ── Traversal mode ────────────────────────────────────────────────────────────

enum TraversalMode {
  BFS, DFS
public:
  def displayName(): String = select this {
    case TraversalMode::BFS: "Breadth-First Search"
    case TraversalMode::DFS: "Depth-First Search"
    else: "?"
  }
}

// ── Extension Int helpers ─────────────────────────────────────────────────────

extension Int {
  def isInfinity(): Boolean = self >= 2147483647
  def minWith(other: Int): Int = if self < other { self } else { other }
}

// ── Graph class ───────────────────────────────────────────────────────────────

class Graph {
  var nodeLabels: HashMap[Int, String]
  var adj: HashMap[Int, ArrayList[Edge]]
  var directed: Boolean
  var edgeCount_: Int

public:
  def this(directed: Boolean) {
    this.nodeLabels = new HashMap[Int, String]()
    this.adj = new HashMap[Int, ArrayList[Edge]]()
    this.directed = directed
    this.edgeCount_ = 0
  }

  def addNode(id: Int, lbl: String): void {
    nodeLabels.put(id, lbl)
    if !adj.containsKey(id) {
      adj.put(id, new ArrayList[Edge]())
    }
  }

  def addEdge(from: Int, to: Int, lbl: String, weight: Int): void {
    ensureNode(from)
    ensureNode(to)
    (adj.get(from) as ArrayList[Edge]).add(new Edge(to, lbl, weight))
    edgeCount_ = edgeCount_ + 1
    if !directed {
      (adj.get(to) as ArrayList[Edge]).add(new Edge(from, lbl, weight))
      edgeCount_ = edgeCount_ + 1
    }
  }

  def label(id: Int): String {
    val l = nodeLabels.get(id) as String?
    return if l != null { l } else { "#" + id }
  }

  def neighbors(id: Int): List[Edge] {
    val jList = adj.get(id) as ArrayList[Edge]?
    if jList == null { return [] }
    val result: List[Edge] = []
    var i = 0
    while i < jList.size() { result.add(jList.get(i) as Edge); i++ }
    return result
  }

  def nodeIds(): List[Int] {
    val result: List[Int] = []
    foreach (k, lbl) in nodeLabels {
      if lbl != null { result.add(k as Int) }
    }
    return result.sortedBy { id -> id as Int }
  }

  def degree(id: Int): Int {
    val jList = adj.get(id) as ArrayList[Edge]?
    return if jList != null { jList.size() } else { 0 }
  }

  // ── BFS ────────────────────────────────────────────────────────────────────

  def bfs(start: Int): List[Int] {
    val visited: List[Int] = []
    val seen: HashMap[Int, Boolean] = new HashMap[Int, Boolean]()
    val queue: List[Int] = [start]
    seen.put(start, true)
    while queue.size > 0 {
      val curr = queue[0] as Int
      queue.remove(0)
      visited.add(curr)
      foreach edge: Edge in neighbors(curr) {
        if !seen.containsKey(edge.to()) {
          seen.put(edge.to(), true)
          queue.add(edge.to())
        }
      }
    }
    return visited
  }

  // ── DFS ────────────────────────────────────────────────────────────────────

  def dfs(start: Int): List[Int] {
    val visited: List[Int] = []
    val seen: HashMap[Int, Boolean] = new HashMap[Int, Boolean]()
    dfsVisit(start, seen, visited)
    return visited
  }

  def dfsVisit(node: Int, seen: HashMap[Int, Boolean], result: List[Int]): void {
    seen.put(node, true)
    result.add(node)
    foreach edge: Edge in neighbors(node).sortedBy { e -> (e as Edge).to() } {
      if !seen.containsKey((edge as Edge).to()) {
        dfsVisit((edge as Edge).to(), seen, result)
      }
    }
  }

  // ── Dijkstra ───────────────────────────────────────────────────────────────

  def shortestPath(start: Int, end_: Int): PathResult? {
    val INF = 2147483647
    val dist: HashMap[Int, Int] = new HashMap[Int, Int]()
    val prev: HashMap[Int, Int] = new HashMap[Int, Int]()
    val prevLbl: HashMap[Int, String] = new HashMap[Int, String]()
    val visited: HashMap[Int, Boolean] = new HashMap[Int, Boolean]()

    foreach id: Int in nodeIds() { dist.put(id, INF) }
    dist.put(start, 0)

    val ids = nodeIds()
    var remaining = ids.size

    while remaining > 0 {
      // pick unvisited node with smallest dist
      var minDist = INF
      var minNode = -1
      foreach id: Int in nodeIds() {
        if !visited.containsKey(id) {
          val d = dist.get(id) as Int?
          val dv = if d != null { d } else { INF }
          if dv < minDist { minDist = dv; minNode = id }
        }
      }
      if minNode == -1 || minDist == INF { break }
      visited.put(minNode, true)
      remaining--
      if minNode == end_ { break }

      foreach edge: Edge in neighbors(minNode) {
        if !visited.containsKey(edge.to()) {
          val nd = minDist + edge.weight()
          val cd = dist.get(edge.to()) as Int?
          val cdv = if cd != null { cd } else { INF }
          if nd < cdv {
            dist.put(edge.to(), nd)
            prev.put(edge.to(), minNode)
            prevLbl.put(edge.to(), edge.label())
          }
        }
      }
    }

    val endDist = dist.get(end_) as Int?
    val endDistVal = if endDist != null { endDist } else { INF }
    if endDistVal == INF { return null }

    // reconstruct path (reversed, then flip)
    val rpath: List[Int] = []
    val rlbls: List[String] = []
    var cur = end_
    while cur != start {
      rpath.add(cur)
      val p = prev.get(cur) as Int?
      if p == null { return null }
      val l = prevLbl.get(cur) as String?
      if l != null { rlbls.add(l) }
      cur = p
    }
    rpath.add(start)

    // reverse both lists
    val path: List[Int] = []
    val lbls: List[String] = []
    var i = rpath.size - 1
    while i >= 0 { path.add(rpath[i] as Int); i-- }
    var j = rlbls.size - 1
    while j >= 0 { lbls.add(rlbls[j] as String); j-- }

    return new PathResult(path, lbls, endDistVal)
  }

  // ── Cycle detection (DFS 3-colour) ─────────────────────────────────────────

  def hasCycle(): Boolean {
    val color: HashMap[Int, Int] = new HashMap[Int, Int]()
    foreach id: Int in nodeIds() {
      if !color.containsKey(id) {
        if dfsCycle(id, color) { return true }
      }
    }
    return false
  }

  def dfsCycle(node: Int, color: HashMap[Int, Int]): Boolean {
    color.put(node, 1)
    foreach edge: Edge in neighbors(node) {
      val c = color.get(edge.to()) as Int?
      if c == null {
        if dfsCycle(edge.to(), color) { return true }
      } else if c == 1 {
        return true
      }
    }
    color.put(node, 2)
    return false
  }

  // ── Topological sort — Kahn's algorithm ────────────────────────────────────

  def topoSort(): TopoResult {
    val indegree: HashMap[Int, Int] = new HashMap[Int, Int]()
    foreach id: Int in nodeIds() { indegree.put(id, 0) }
    foreach id: Int in nodeIds() {
      foreach edge: Edge in neighbors(id) {
        val prev_ = indegree.get(edge.to()) as Int?
        val pv = if prev_ != null { prev_ } else { 0 }
        indegree.put(edge.to(), pv + 1)
      }
    }
    val queue: List[Int] = []
    foreach id: Int in nodeIds() {
      val d = indegree.get(id) as Int?
      if d == null || d == 0 { queue.add(id) }
    }
    val order: List[Int] = []
    while queue.size > 0 {
      val node = queue[0] as Int
      queue.remove(0)
      order.add(node)
      foreach edge: Edge in neighbors(node) {
        val d = indegree.get(edge.to()) as Int?
        val dv = if d != null { d } else { 0 }
        val newD = dv - 1
        indegree.put(edge.to(), newD)
        if newD == 0 { queue.add(edge.to()) }
      }
    }
    val cycle = order.size < nodeIds().size
    return new TopoResult(order, cycle)
  }

  // ── Statistics ─────────────────────────────────────────────────────────────

  def stats(): GraphStats {
    val ids = nodeIds()
    val n = ids.size
    val e = if directed { edgeCount_ } else { edgeCount_ / 2 }
    val avg = edgeCount_
    var maxDeg = 0
    var maxNode = if ids.size > 0 { ids[0] as Int } else { -1 }
    foreach id: Int in ids {
      val d = degree(id)
      if d > maxDeg { maxDeg = d; maxNode = id }
    }
    // connected = BFS from first node visits all nodes (for undirected)
    val connected = if n == 0 { true } else { bfs(ids[0] as Int).size == n }
    return new GraphStats(n, e, avg, maxNode, connected)
  }

  def ensureNode(id: Int): void {
    if !adj.containsKey(id) {
      adj.put(id, new ArrayList[Edge]())
      nodeLabels.put(id, "#" + id)
    }
  }
}

// ── Formatting helpers ────────────────────────────────────────────────────────

def idList(g: Graph, ids: List[Int]): String {
  val names = ids.map { id -> g.label(id as Int) }
  return names.fold("") { acc, n ->
    val a = acc as String
    val nm = n as String
    if a == "" { nm } else { a + " → " + nm }
  } as String
}

// ── Demo ──────────────────────────────────────────────────────────────────────

// City transit map (undirected, weighted by minutes)
val city = new Graph(false)
city.addNode(1, "Airport")
city.addNode(2, "Central")
city.addNode(3, "University")
city.addNode(4, "Hospital")
city.addNode(5, "Mall")
city.addNode(6, "Beach")
city.addNode(7, "Park")

city.addEdge(1, 2, "Express",   45)
city.addEdge(2, 3, "Metro A",   10)
city.addEdge(2, 4, "Metro B",   15)
city.addEdge(3, 5, "Bus 12",    20)
city.addEdge(4, 5, "Bus 34",    10)
city.addEdge(5, 6, "Tram 7",    25)
city.addEdge(3, 7, "Walk",       5)
city.addEdge(6, 7, "Bus 55",    30)
city.addEdge(1, 4, "Shuttle",   50)

IO::println("=== City Transit Network ===")
val cs = city.stats()
IO::println("Nodes: #{cs.nodeCount()}, Edges: #{cs.edgeCount()}, Total degree: #{cs.totalDegree()}")
IO::println("Most connected: #{city.label(cs.maxDegreeNode())} (degree #{city.degree(cs.maxDegreeNode())})")
IO::println("Is connected: #{cs.isConnected()}")

IO::println("")
IO::println("BFS from Airport:  " + idList(city, city.bfs(1)))
IO::println("DFS from Airport:  " + idList(city, city.dfs(1)))

IO::println("")
IO::println("Shortest paths from Airport:")
foreach dest: Int in [2, 3, 4, 5, 6, 7] {
  val p = city.shortestPath(1, dest)
  if p != null {
    IO::println("  → #{city.label(dest)}: #{(p as PathResult).describe(city)}")
  } else {
    IO::println("  → #{city.label(dest)}: unreachable")
  }
}

// Task dependency graph (directed, acyclic)
val tasks = new Graph(true)
tasks.addNode(1, "design")
tasks.addNode(2, "database")
tasks.addNode(3, "backend")
tasks.addNode(4, "frontend")
tasks.addNode(5, "testing")
tasks.addNode(6, "deploy")

tasks.addEdge(1, 2, "→", 1)
tasks.addEdge(1, 3, "→", 1)
tasks.addEdge(1, 4, "→", 1)
tasks.addEdge(2, 3, "→", 1)
tasks.addEdge(3, 5, "→", 1)
tasks.addEdge(4, 5, "→", 1)
tasks.addEdge(5, 6, "→", 1)

IO::println("")
IO::println("=== Task Dependency Graph ===")
IO::println("Has cycle (DAG): " + tasks.hasCycle())
val topo = tasks.topoSort()
IO::println("Topological order: " + idList(tasks, topo.order()))

// Now introduce a cycle
val cyclic = new Graph(true)
cyclic.addNode(1, "A")
cyclic.addNode(2, "B")
cyclic.addNode(3, "C")
cyclic.addEdge(1, 2, "→", 1)
cyclic.addEdge(2, 3, "→", 1)
cyclic.addEdge(3, 1, "→", 1)

IO::println("")
IO::println("=== Cycle Detection ===")
IO::println("A→B→C→A has cycle: " + cyclic.hasCycle())
val badTopo = cyclic.topoSort()
IO::println("Topo on cyclic graph detected cycle: " + badTopo.hasCycle())

// Pipeline analytics: which city nodes can be reached within 60 minutes?
IO::println("")
IO::println("=== Reachability Analysis (≤ 60 min from Airport) ===")
val reachable = city.nodeIds()
  .filter { id ->
    val p = city.shortestPath(1, id as Int)
    p != null && (p as PathResult).totalWeight() <= 60
  }
  .map { id -> city.label(id as Int) }
IO::println("Within 60 min: " + reachable.toString())

IO::println("")
IO::println("=== Traversal Mode Names ===")
IO::println(TraversalMode::BFS.displayName() + " | " + TraversalMode::DFS.displayName())
