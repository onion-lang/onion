// HashDemo — onion.Hash: md5, sha1, sha256, sha512 checksum/digest helpers.
//
// Hash is not default-imported, so each call below is qualified as Hash::name.
// Every method hashes the UTF-8 bytes of a string and returns a lowercase hex
// digest. This demo checks each algorithm against a published test vector for
// "hello" and the empty string, and reports how many checks failed (0 means
// everything still matches the documented digests).
//
//   onion HashDemo.on

class HashDemo {
public:

  static def check(actual: String, expected: String, label: String): Boolean {
    val ok = actual == expected
    IO::println("  " + (if ok { "ok  " } else { "FAIL" }) + " " + label + " = " + actual)
    return ok
  }

  static def main(args: String[]): Int {
    var failures = 0

    IO::println("hello")
    if !check(Hash::md5("hello"), "5d41402abc4b2a76b9719d911017c592", "md5(hello)") { failures = failures + 1 }
    if !check(Hash::sha1("hello"), "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d", "sha1(hello)") { failures = failures + 1 }
    if !check(Hash::sha256("hello"), "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", "sha256(hello)") { failures = failures + 1 }
    if !check(Hash::sha512("hello"),
      "9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca72323c3d99ba5c11d7c7acc6e14b8c5da0c4663475c2e5c3adef46f73bcdec043",
      "sha512(hello)") { failures = failures + 1 }

    IO::println("\nempty string")
    if !check(Hash::md5(""), "d41d8cd98f00b204e9800998ecf8427e", "md5(\"\")") { failures = failures + 1 }
    if !check(Hash::sha1(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1(\"\")") { failures = failures + 1 }
    if !check(Hash::sha256(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256(\"\")") { failures = failures + 1 }
    if !check(Hash::sha512(""),
      "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
      "sha512(\"\")") { failures = failures + 1 }

    IO::println("\n" + failures + " failure(s)")
    return failures
  }
}
