    [3, 4, 5, 6, 7, 8, 9, 10, 11]
  )

  val t3: Trail = new Trail(
    "T003", "Coastal Cliffs",
    [
      new Waypoint("Beach Access",   15.0, 0.0),
      new Waypoint("Bluff Top",     120.0, 1.5),
      new Waypoint("Lighthouse",    145.0, 3.8),
      new Waypoint("Sea Cave",       20.0, 5.5),
      new Waypoint("Beach Access",   15.0, 7.0)
    ],
    new Moderate(), new Coastal(),
    [4, 5, 6, 7, 8, 9, 10]
  )

  val t4: Trail = new Trail(
    "T004", "Desert Canyon Run",
    [
      new Waypoint("Canyon Mouth",  480.0, 0.0),
      new Waypoint("Narrows",       520.0, 2.2),
      new Waypoint("Arch Rock",     610.0, 4.1),
      new Waypoint("Upper Bench",   720.0, 6.5),
      new Waypoint("Canyon Mouth",  480.0, 11.0)
