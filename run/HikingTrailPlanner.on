// HikingTrailPlanner.on — Trail management, route planning, and trip reporting.
//
// Exercises: records (with example clauses), ADT case-enum, data-carrying
// enums, extension methods on Double/Int/String, interface, classes with
// inheritance, generic record, collection pipelines (filter/map/fold/sortedBy/
// groupBy/distinct/find/partition/count/any/reduce), foreach over Map (k,v),
// nullable types, closures/lambdas, string interpolation, try/catch, recursion,
// while and foreach with ranges.

import { java.lang.Math }

// ─── Extensions ──────────────────────────────────────────────────────────────

extension Double {
  def round1(): Double {
    val s: Int = (self * 10.0) as Int
    return s.doubleValue() / 10.0
  }
  def formatElev(): String = "#{self.round1()}m"
  def formatDist(): String = "#{self.round1()}km"
  def abs(): Double = if self < 0.0 { 0.0 - self } else { self }
}

extension Int {
  def plural(word: String): String = if self == 1 { "1 #{word}" } else { "#{self} #{word}s" }
  def padL(w: Int): String {
    var s: String = "" + self
    while s.length() < w { s = " " + s }
    return s
  }
}

extension String {
  def padR(w: Int): String {
    var s: String = self
    while s.length() < w { s = s + " " }
    return s
  }
  def truncate(w: Int): String {
    if self.length() <= w { return self }
    return self.substring(0, w - 3) + "..."
  }
}

// ─── Difficulty ADT enum ──────────────────────────────────────────────────────

enum Difficulty {
  case Easy
  case Moderate
  case Hard
  case Expert
public:
  def label(): String = select this {
    case d is Easy:     "Easy"
    case d is Moderate: "Moderate"
    case d is Hard:     "Hard"
    case d is Expert:   "Expert"
  }
  def symbol(): String = select this {
    case d is Easy:     "[*   ]"
    case d is Moderate: "[**  ]"
    case d is Hard:     "[*** ]"
    case d is Expert:   "[****]"
  }
  def minFitness(): Int = select this {
    case d is Easy:     1
    case d is Moderate: 3
    case d is Hard:     6
    case d is Expert:   9
  }
}

// ─── Terrain ADT enum ─────────────────────────────────────────────────────────

enum Terrain {
  case Forest
  case Alpine
  case Desert
  case Coastal
  case Mixed
public:
  def label(): String = select this {
    case t is Forest:  "Forest"
    case t is Alpine:  "Alpine"
    case t is Desert:  "Desert"
    case t is Coastal: "Coastal"
    case t is Mixed:   "Mixed"
  }
  def emoji(): String = select this {
    case t is Forest:  "[F]"
    case t is Alpine:  "[A]"
    case t is Desert:  "[D]"
    case t is Coastal: "[C]"
    case t is Mixed:   "[M]"
  }
}

// ─── Season (data-carrying enum) ─────────────────────────────────────────────

enum Season(monthStart: Int, monthEnd: Int, lbl: String) {
  SPRING(3, 5, "Spring"),
  SUMMER(6, 8, "Summer"),
  AUTUMN(9, 11, "Autumn"),
  WINTER(12, 2, "Winter")
public:
  def label(): String = lbl()
  def includesMonth(m: Int): Boolean {
    if monthStart() <= monthEnd() {
      return m >= monthStart() && m <= monthEnd()
    }
    return m >= monthStart() || m <= monthEnd()
  }
}

// ─── Records ──────────────────────────────────────────────────────────────────

record Waypoint(name: String, elevation: Double, distFromStart: Double)
  example {
    val wp: Waypoint = new Waypoint("Summit", 2450.0, 8.5)
    wp.elevation() > wp.distFromStart()
  }

record ElevationProfile(gain: Double, loss: Double, maxElev: Double, minElev: Double) {
  example {
    val ep: ElevationProfile = new ElevationProfile(400.0, 50.0, 1200.0, 800.0)
    ep.gain() > ep.loss()
  }
public:
  def netChange(): Double = gain() - loss()
  def range(): Double = maxElev() - minElev()
  def summary(): String = "+#{gain().formatElev()} / -#{loss().formatElev()}  net: #{netChange().formatElev()}"
}

record TrailStats(trailCount: Int, totalDist: Double, avgElev: Double, hardestDiff: String)
  example { new TrailStats(5, 42.3, 1200.0, "Hard").trailCount() == 5 }

// ─── Generic ranked wrapper ───────────────────────────────────────────────────

record Ranked[T](rank: Int, item: T, score: Double)
  example { new Ranked[String](1, "Summit Loop", 9.2).rank() == 1 }

// ─── Trail class ─────────────────────────────────────────────────────────────

class Trail {
  val trailId: String
  val name: String
  val waypoints: List[Object]
  val difficulty: Difficulty
  val terrain: Terrain
  val bestMonths: List[Object]

public:
  def this(id: String, n: String, wps: List[Object], diff: Difficulty, ter: Terrain, bm: List[Object]) {
    this.trailId = id
    this.name = n
    this.waypoints = wps
    this.difficulty = diff
    this.terrain = ter
    this.bestMonths = bm
  }

  def getId(): String = trailId
  def getName(): String = name
  def getDifficulty(): Difficulty = difficulty
  def getTerrain(): Terrain = terrain
  def getBestMonths(): List[Object] = bestMonths
  def getWaypoints(): List[Object] = waypoints

  def totalDistance(): Double {
    if waypoints.isEmpty { return 0.0 }
    return (waypoints.get(waypoints.size - 1) as Waypoint).distFromStart()
  }

  def elevationProfile(): ElevationProfile {
    if waypoints.isEmpty { return new ElevationProfile(0.0, 0.0, 0.0, 0.0) }
    var gain: Double = 0.0
    var loss: Double = 0.0
    var maxE: Double = 0.0 - 9999.0
    var minE: Double = 9999.0
    var i: Int = 0
    while i < waypoints.size {
      val wp: Waypoint = waypoints.get(i) as Waypoint
      val elev: Double = wp.elevation()
      if elev > maxE { maxE = elev }
      if elev < minE { minE = elev }
      if i > 0 {
        val prev: Waypoint = waypoints.get(i - 1) as Waypoint
        val diff: Double = elev - prev.elevation()
        if diff > 0.0 { gain = gain + diff } else { loss = loss + (0.0 - diff) }
      }
      i = i + 1
    }
    return new ElevationProfile(gain, loss, maxE, minE)
  }

  def suitableForMonth(month: Int): Boolean {
    return bestMonths.any { m -> (m as Int) == month }
  }

  def summary(): String {
    val ep: ElevationProfile = elevationProfile()
    return "#{name.padR(28)} #{difficulty.symbol()} #{terrain.emoji()}  #{totalDistance().formatDist().padR(8)} #{ep.summary()}"
  }
}

// ─── Trail database ───────────────────────────────────────────────────────────

class TrailDatabase {
  val trails: List[Object]

public:
  def this(ts: List[Object]) {
    this.trails = ts
  }

  def getTrails(): List[Object] = trails

  def findById(id: String): Trail? {
    val found = trails.find { t -> (t as Trail).getId() == id }
    if found == null { return null }
    return found as Trail
  }

  def byDifficulty(d: Difficulty): List[Object] {
    return trails.filter { t -> (t as Trail).getDifficulty().label() == d.label() }
  }

  def byTerrain(te: Terrain): List[Object] {
    return trails.filter { t -> (t as Trail).getTerrain().label() == te.label() }
  }

  def suitableForMonth(month: Int): List[Object] {
    return trails.filter { t -> (t as Trail).suitableForMonth(month) }
  }

  def stats(): TrailStats {
    if trails.isEmpty { return new TrailStats(0, 0.0, 0.0, "N/A") }
    val totalDist: Double = trails.fold(0.0) { acc, t ->
      (acc as Double) + (t as Trail).totalDistance()
    } as Double
    val avgElev: Double = trails.fold(0.0) { acc, t ->
      val ep: ElevationProfile = (t as Trail).elevationProfile()
      (acc as Double) + ep.maxElev()
    } as Double / trails.size.doubleValue()
    val hardest: Trail = trails.fold(trails.get(0) as Trail) { acc, t ->
      val a: Trail = acc as Trail
      val b: Trail = t as Trail
      if b.getDifficulty().minFitness() > a.getDifficulty().minFitness() { b } else { a }
    } as Trail
    return new TrailStats(trails.size, totalDist, avgElev.round1(), hardest.getDifficulty().label())
  }
}

// ─── Report generator ─────────────────────────────────────────────────────────

class TrailReporter {
  val db: TrailDatabase

public:
  def this(d: TrailDatabase) {
    this.db = d
  }

  def sep(w: Int): String {
    var s: String = ""
    var i: Int = 0
    while i < w { s = s + "-"; i = i + 1 }
    return s
  }

  def header(): String {
    val stats: TrailStats = db.stats()
    val sb: StringBuilder = new StringBuilder()
    sb.append("#{sep(65)}\n")
    sb.append("  HIKING TRAIL PLANNER  |  #{stats.trailCount().plural("trail")} in database\n")
    sb.append("#{sep(65)}\n")
    sb.append("  Total distance: #{stats.totalDist().formatDist()}   Avg peak: #{stats.avgElev().formatElev()}   Hardest: #{stats.hardestDiff()}\n")
    sb.append("#{sep(65)}\n")
    return sb.toString()
  }

  def allTrails(): String {
    val sb: StringBuilder = new StringBuilder()
    sb.append("ALL TRAILS (sorted by distance):\n")
    val sorted: List[Object] = db.getTrails().sortedBy { t -> (t as Trail).totalDistance() }
    var n: Int = 1
    foreach t: Object in sorted {
      val trail: Trail = t as Trail
      sb.append("  #{n.padL(2)}. #{trail.summary()}\n")
      n = n + 1
    }
    return sb.toString()
  }

  def byTerrainSection(): String {
    val sb: StringBuilder = new StringBuilder()
    sb.append("\nTRAILS BY TERRAIN:\n")
    val grouped: Map[String, List[Object]] = db.getTrails().groupBy { t ->
      (t as Trail).getTerrain().label()
    }
    foreach (terrain, trails) in grouped {
      val tlist: List[Object] = trails as List[Object]
      sb.append("  #{terrain} #{(tlist.get(0) as Trail).getTerrain().emoji()}  (#{tlist.size.plural("trail")})\n")
      val sorted: List[Object] = tlist.sortedBy { t -> (t as Trail).totalDistance() }
      foreach t: Object in sorted {
        val trail: Trail = t as Trail
        sb.append("    - #{trail.getName().padR(28)} #{trail.getDifficulty().symbol()}  #{trail.totalDistance().formatDist()}\n")
      }
    }
    return sb.toString()
  }

  def elevationLeaderboard(n: Int): String {
    val sb: StringBuilder = new StringBuilder()
    sb.append("\nTOP #{n} BY ELEVATION GAIN:\n")
    val ranked: List[Object] = db.getTrails()
      .sortedBy { t -> 0.0 - (t as Trail).elevationProfile().gain() }
    var rank: Int = 1
    foreach t: Object in ranked {
      if rank > n { break }
      val trail: Trail = t as Trail
      val ep: ElevationProfile = trail.elevationProfile()
      sb.append("  #{rank.padL(2)}. #{trail.getName().padR(28)} gain: #{ep.gain().formatElev()}  #{ep.summary()}\n")
      rank = rank + 1
    }
    return sb.toString()
  }

  def seasonalGuide(month: Int): String {
    val sb: StringBuilder = new StringBuilder()
    val season: Season? = [Season::SPRING, Season::SUMMER, Season::AUTUMN, Season::WINTER]
      .find { s -> (s as Season).includesMonth(month) } as Season?
    val seasonName: String = if season == null { "month #{month}" } else { (season as Season).label() }
    val suitable: List[Object] = db.suitableForMonth(month)
    sb.append("\nSEASONAL GUIDE (#{seasonName}):\n")
    sb.append("  #{suitable.size.plural("trail")} recommended:\n")
    val byStar: List[Object] = suitable.sortedBy { t -> (t as Trail).getDifficulty().minFitness() }
    foreach t: Object in byStar {
      val trail: Trail = t as Trail
      sb.append("  - #{trail.getName().padR(28)} #{trail.getDifficulty().symbol()}\n")
    }
    return sb.toString()
  }

  def generate(month: Int): String {
    return header() + allTrails() + byTerrainSection() + elevationLeaderboard(5) + seasonalGuide(month)
  }
}

// ─── Recursive helpers ────────────────────────────────────────────────────────

def cumulativeGain(waypoints: List[Object], idx: Int): Double {
  if idx <= 0 { return 0.0 }
  val curr: Waypoint = waypoints.get(idx) as Waypoint
  val prev: Waypoint = waypoints.get(idx - 1) as Waypoint
  val diff: Double = curr.elevation() - prev.elevation()
  val step: Double = if diff > 0.0 { diff } else { 0.0 }
  return step + cumulativeGain(waypoints, idx - 1)
}

// ─── Sample data ─────────────────────────────────────────────────────────────

def buildDatabase(): TrailDatabase {
  val t1: Trail = new Trail(
    "T001", "Summit Loop",
    [
      new Waypoint("Trailhead",     850.0, 0.0),
      new Waypoint("Ridge Start",  1120.0, 2.5),
      new Waypoint("False Summit", 1380.0, 5.0),
      new Waypoint("Summit",       1524.0, 7.2),
      new Waypoint("Trailhead",     850.0, 14.4)
    ],
    new Hard(), new Alpine(),
    [6, 7, 8, 9]
  )

  val t2: Trail = new Trail(
    "T002", "Forest Wanderer",
    [
      new Waypoint("Parking Lot",   320.0, 0.0),
      new Waypoint("Meadow",        380.0, 1.8),
      new Waypoint("Old Bridge",    295.0, 3.6),
