// HotelReservation.on — Hotel reservation management system.
// Exercises: records, data-carrying & ADT enums, classes, generics, extension
// methods on Int/String/Double, collection pipelines (filter/map/fold/sortedBy/
// groupBy/find/partition), select / type-pattern matching, closures, string
// interpolation, foreach (item & k,v), while, try/catch, recursion, nullable.

// ── Extensions ────────────────────────────────────────────────────────────────

extension Int {
  def abs(): Int = if self < 0 { -self } else { self }
  def max(other: Int): Int = if self >= other { self } else { other }
  def min(other: Int): Int = if self <= other { self } else { other }
}

extension Double {
  def roundCents(): Double {
    val cents: Int = (self * 100.0 + 0.5).intValue()
    return (cents as Double) / 100.0
  }
}

extension String {
  def center(width: Int): String {
    if self.length() >= width { return self }
    val pad = width - self.length()
    val left = pad / 2
    val right = pad - left
    var s = ""
    var i = 0
    while i < left { s = s + " "; i = i + 1 }
    s = s + self
    i = 0
    while i < right { s = s + " "; i = i + 1 }
    return s
  }
  def repeat(n: Int): String {
    var s = ""
    var i = 0
    while i < n { s = s + self; i = i + 1 }
    return s
  }
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum RoomType {
  SINGLE, DOUBLE, SUITE, PENTHOUSE
public:
  def baseRate(): Int = select this {
    case RoomType::SINGLE:    100
    case RoomType::DOUBLE:    150
    case RoomType::SUITE:     300
    case RoomType::PENTHOUSE: 600
    else: 100
  }
  def capacity(): Int = select this {
    case RoomType::SINGLE:    1
    case RoomType::DOUBLE:    2
    case RoomType::SUITE:     4
    case RoomType::PENTHOUSE: 6
    else: 1
  }
  def label(): String = select this {
    case RoomType::SINGLE:    "Single"
    case RoomType::DOUBLE:    "Double"
    case RoomType::SUITE:     "Suite"
    case RoomType::PENTHOUSE: "Penthouse"
    else: "Unknown"
  }
}

enum Season { LOW, MID, HIGH }

// ── Records ───────────────────────────────────────────────────────────────────

record Guest(id: Int, name: String, email: String, loyaltyPoints: Int) {
public:
  def withPoints(pts: Int): Guest =
    new Guest(id(), name(), email(), loyaltyPoints() + pts)
}

record Room(number: Int, floor: Int, type_: RoomType, view: Boolean) {
public:
  def label(): String = "#{number()} (#{type_().label()}" +
                        (if view() { ", view" } else { "" }) + ")"
  def rateFor(nights: Int, season: Season): Double {
    val base: Double = type_().baseRate() as Double
    val multiplier: Double = select season {
      case Season::LOW:  0.8
      case Season::MID:  1.0
      case Season::HIGH: 1.4
      else:              1.0
    }
    val viewPremium: Double = if view() { 1.15 } else { 1.0 }
    return (base * multiplier * viewPremium * (nights as Double)).roundCents()
  }
}

record Reservation(id: Int, roomNumber: Int, guestId: Int,
                   checkIn: Int, checkOut: Int, season: Season) {
public:
  def nights(): Int = (checkOut() - checkIn()).abs().max(1)
}

// ── ADT enum: booking events ──────────────────────────────────────────────────

enum BookingEvent {
  case Reserved(resId: Int, roomNumber: Int, guestName: String)
  case CheckedIn(resId: Int, guestName: String)
  case CheckedOut(resId: Int, total: Double, pointsEarned: Int)
  case Cancelled(resId: Int, reason: String)
}

def eventSummary(ev: BookingEvent): String = select ev {
  case e is Reserved:   "RESERVED  Res##{e.resId()} → Room #{e.roomNumber()} for #{e.guestName()}"
  case e is CheckedIn:  "CHECKED-IN  Res##{e.resId()} — #{e.guestName()}"
  case e is CheckedOut: "CHECKED-OUT Res##{e.resId()} — $#{e.total()} (+#{e.pointsEarned()}pts)"
  case e is Cancelled:  "CANCELLED  Res##{e.resId()} — #{e.reason()}"
}

// ── Generic result type ───────────────────────────────────────────────────────

class BookingResult[T] {
  val value_: T?
  val errMsg_: String?
public:
  def this(v: T) {
    this.value_ = v
    this.errMsg_ = null
  }
  def this(msg: String, dummy: Boolean) {
    this.value_ = null
    this.errMsg_ = msg
  }
  def isOk(): Boolean = value_ != null
  def value(): T? = value_
  def describe(): String =
    if value_ != null { "OK" } else { "ERR: #{errMsg_}" }
}

// ── Hotel class ───────────────────────────────────────────────────────────────

class Hotel {
  val name: String
  val rooms: List[Room]
  val guests: List[Guest]
  val reservations: List[Reservation]
  val eventLog: List[BookingEvent]
  var nextResId: Int
  var nextGuestId: Int

public:
  def this(hotelName: String) {
    this.name = hotelName
    this.rooms = []
    this.guests = []
    this.reservations = []
    this.eventLog = []
    this.nextResId = 1000
    this.nextGuestId = 1
  }

  def addRoom(r: Room): void { rooms.add(r) }

  def registerGuest(gName: String, email: String): Guest {
    val g = new Guest(nextGuestId, gName, email, 0)
    guests.add(g)
    nextGuestId = nextGuestId + 1
    return g
  }

  def findRoom(number: Int): Room? =
    rooms.find { r -> (r as Room).number() == number } as Room?

  def findGuest(id: Int): Guest? =
    guests.find { g -> (g as Guest).id() == id } as Guest?

  def isAvailable(roomNumber: Int, checkIn: Int, checkOut: Int): Boolean {
    val conflicts = reservations.filter { res ->
      val r = res as Reservation
      r.roomNumber() == roomNumber &&
      r.checkIn() < checkOut && r.checkOut() > checkIn
    }
    return conflicts.isEmpty
  }

  def reserve(guestId: Int, roomNumber: Int, checkIn: Int, checkOut: Int, season: Season): BookingResult[Reservation] {
    if findGuest(guestId) == null {
      return new BookingResult[Reservation]("Guest not found", true)
    }
    if findRoom(roomNumber) == null {
      return new BookingResult[Reservation]("Room not found", true)
    }
    if !isAvailable(roomNumber, checkIn, checkOut) {
      return new BookingResult[Reservation]("Room not available", true)
    }
    val resId = nextResId
    nextResId = nextResId + 1
    val res = new Reservation(resId, roomNumber, guestId, checkIn, checkOut, season)
    reservations.add(res)
    val guest = findGuest(guestId) as Guest
    eventLog.add(new Reserved(resId, roomNumber, guest.name()))
    return new BookingResult[Reservation](res)
  }

  def checkout(resId: Int): Double {
    val resOpt = reservations.find { r -> (r as Reservation).id() == resId } as Reservation?
    if resOpt == null { return 0.0 }
    val res = resOpt
    val roomOpt = findRoom(res.roomNumber()) as Room?
    if roomOpt == null { return 0.0 }
    val total = roomOpt.rateFor(res.nights(), res.season())
    val pts = (total / 10.0).intValue()
    val guestOpt = findGuest(res.guestId()) as Guest?
    if guestOpt != null {
      val g = guestOpt
      val idx = guests.indexOf(g)
      if idx >= 0 { guests[idx] = g.withPoints(pts) }
    }
    eventLog.add(new CheckedOut(resId, total, pts))
    return total
  }

  def allRooms(): List[Room] = rooms

  def availableRooms(checkIn: Int, checkOut: Int): List[Room] =
    rooms.filter { r ->
      isAvailable((r as Room).number(), checkIn, checkOut)
    }

  def occupancyReport(): void {
    println("=".repeat(50))
    println(name.center(50))
    println("=".repeat(50))
    println("Total rooms:        " + rooms.size)
    val allRes = reservations.size
    println("Total reservations: " + allRes)
    println("")
    println("Rooms by type:")
    val byType = rooms.groupBy { r -> (r as Room).type_().label() }
    foreach (label, roomList) in byType {
      println("  #{label}: #{(roomList as List).size}")
    }
    println("")
    println("Revenue by season:")
    val bySeason = reservations.groupBy { r ->
      select (r as Reservation).season() {
        case Season::LOW:  "Low"
        case Season::MID:  "Mid"
        case Season::HIGH: "High"
        else:              "?"
      }
    }
    foreach (season, resList) in bySeason {
      var total: Double = 0.0
      foreach res: Object in resList {
        val r = res as Reservation
        val roomOpt = findRoom(r.roomNumber()) as Room?
        if roomOpt != null {
          total = total + roomOpt.rateFor(r.nights(), r.season())
        }
      }
      println("  #{season}: $#{total.roundCents()}")
    }
  }

  def printEventLog(): void {
    println("\n--- Event Log ---")
    foreach ev: BookingEvent in eventLog {
      println("  " + eventSummary(ev))
    }
  }
}

// ── Helpers: day arithmetic ───────────────────────────────────────────────────

def nightsBetween(checkIn: Int, checkOut: Int): Int =
  (checkOut - checkIn).abs().max(1)

// ── Main scenario ─────────────────────────────────────────────────────────────

val hotel = new Hotel("Grand Onion Hotel")

// Add rooms
hotel.addRoom(new Room(101, 1, RoomType::SINGLE, false))
hotel.addRoom(new Room(102, 1, RoomType::SINGLE, true))
hotel.addRoom(new Room(201, 2, RoomType::DOUBLE, false))
hotel.addRoom(new Room(202, 2, RoomType::DOUBLE, true))
hotel.addRoom(new Room(301, 3, RoomType::SUITE,  false))
hotel.addRoom(new Room(302, 3, RoomType::SUITE,  true))
hotel.addRoom(new Room(401, 4, RoomType::PENTHOUSE, true))

// Register guests
val alice = hotel.registerGuest("Alice Smith", "alice@example.com")
val bob   = hotel.registerGuest("Bob Jones",   "bob@example.com")
val carol = hotel.registerGuest("Carol White", "carol@example.com")

println("=== Registered guests ===")
val allGuests = [alice, bob, carol]
foreach g: Guest in allGuests {
  println("  [##{g.id()}] #{g.name()} <#{g.email()}>")
}

// Make reservations
println("\n=== Making Reservations ===")
val r1 = hotel.reserve(alice.id(), 302, 1, 4, Season::HIGH)
println("Alice → Suite view (3 nights, HIGH): " + r1.describe())

val r2 = hotel.reserve(bob.id(), 201, 2, 5, Season::MID)
println("Bob → Double (3 nights, MID):        " + r2.describe())

val r3 = hotel.reserve(carol.id(), 201, 3, 6, Season::MID) // conflict with Bob
println("Carol → Double conflict:             " + r3.describe())

val r4 = hotel.reserve(carol.id(), 102, 5, 7, Season::LOW)
println("Carol → Single view (2 nights, LOW): " + r4.describe())

// Compute rates
println("\n=== Room Rates (per-night × nights) ===")
val room302 = hotel.findRoom(302)
if room302 != null {
  println("Suite view, 3 nights, HIGH: $" + room302.rateFor(3, Season::HIGH))
  println("Suite view, 3 nights, LOW:  $" + room302.rateFor(3, Season::LOW))
}

// Availability check
println("\n=== Available rooms (days 3-5) ===")
val avail = hotel.availableRooms(3, 5)
foreach r: Room in avail.sortedBy { r -> r.number() } {
  println("  Room #{r.label()}")
}

// Checkout and loyalty points
println("\n=== Checkouts ===")
if r1.isOk() {
  val res1 = r1.value()
  if res1 != null {
    val total = hotel.checkout(res1.id())
    println("Alice checked out — total: $" + total)
  }
}
if r2.isOk() {
  val res2 = r2.value()
  if res2 != null {
    val total = hotel.checkout(res2.id())
    println("Bob checked out   — total: $" + total)
  }
}

// Try/catch: safe lookup
def safeRate(room: Room?, nights: Int, season: Season): String {
  try {
    if room == null { return "N/A" }
    return "$" + room.rateFor(nights, season)
  } catch e: Exception {
    return "error"
  }
}
println("\nSafe rate for null room: " + safeRate(null, 3, Season::MID))
println("Safe rate for room 401: " + safeRate(hotel.findRoom(401), 2, Season::HIGH))

// Partitioning: expensive vs affordable rooms
println("\n=== Rooms by price tier ===")
val partitioned = hotel.allRooms().partition { r ->
  (r as Room).type_().baseRate() >= 300
}
val expensive = partitioned[0] as List
val affordable = partitioned[1] as List
println("Luxury rooms: " + expensive.size)
println("Standard rooms: " + affordable.size)

// Recursive: Fibonacci for demonstration
def fib(n: Int): Int = if n <= 1 { n } else { fib(n-1) + fib(n-2) }
println("\nFibonacci(10) = " + fib(10))

// Statistics: average rate across all room types
val avgRate = [RoomType::SINGLE, RoomType::DOUBLE, RoomType::SUITE, RoomType::PENTHOUSE]
  .fold(0) { acc, t -> (acc as Int) + (t as RoomType).baseRate() }
println("Sum of base rates: $" + avgRate)

// Full report
println("")
hotel.occupancyReport()
hotel.printEventLog()
