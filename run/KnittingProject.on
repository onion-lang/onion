// KnittingProject.on — yarn stash manager and knitting project tracker.
// Exercises: data-carrying enums (FiberType, YarnWeight), ADT enum
// (ProjectStatus), records with methods, class, interface, extension methods,
// collection pipelines (map/filter/fold/groupBy/sortedBy/distinct/find/
// partition), select/is pattern matching, nullable, foreach (list/map/range),
// closures, string interpolation, while, try/catch, generics.

// ── Extensions ────────────────────────────────────────────────────────────────

extension String {
  def padRight(w: Int): String {
    var s: String = self
    while s.length() < w { s = s + " " }
    return s
  }
  def padLeft(w: Int): String {
    var s: String = self
    while s.length() < w { s = " " + s }
    return s
  }
}

extension Int {
  def rpt(ch: String): String {
    var out: String = ""
    foreach _: Int in 0..<self { out = out + ch }
    return out
  }
}

extension Double {
  def round1(): Double = ((self * 10.0 + 0.5) as Int) * 1.0 / 10.0
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum FiberType(label: String, isAnimal: Boolean) {
  Wool(    "Wool",     true),
  Cotton(  "Cotton",   false),
  Alpaca(  "Alpaca",   true),
  Merino(  "Merino",   true),
  Silk(    "Silk",     true),
  Linen(   "Linen",    false),
  Acrylic( "Acrylic",  false),
  Blend(   "Blend",    false)
}

enum YarnWeight(label: String, mmRange: String, skeinYards: Int) {
  Fingering("Fingering", "1.5-2.4mm",  400),
  Sport(    "Sport",     "2.5-3.2mm",  300),
  DK(       "DK",        "3.5-4.0mm",  250),
  Worsted(  "Worsted",   "4.5-5.4mm",  200),
  Bulky(    "Bulky",     "5.5-8.0mm",  130),
  SuperBulky("SuperBulky","9.0+mm",     80)
}

enum ProjectType(label: String, typicalYards: Int) {
  Scarf(   "Scarf",    400),
  Hat(     "Hat",      200),
  Sweater( "Sweater", 1800),
  Socks(   "Socks",    400),
  Blanket( "Blanket", 3000),
  Shawl(   "Shawl",   800),
  Mittens( "Mittens",  150)
}

// ── ADT: ProjectStatus ────────────────────────────────────────────────────────

enum ProjectStatus {
  case Active(percentDone: Int)
  case Completed(dateFinished: String)
  case Frogged(reason: String)
  case OnHold
public:
  def label(): String = select this {
    case a is Active:    "Active (#{a.percentDone()}%)"
    case c is Completed: "Done on #{c.dateFinished()}"
    case f is Frogged:   "Frogged: #{f.reason()}"
    case h is OnHold:    "On Hold"
  }
  def isDone(): Boolean = select this {
    case c is Completed: true
    else: false
  }
  def isActive(): Boolean = select this {
    case a is Active: true
    else: false
  }
}

// ── Records ───────────────────────────────────────────────────────────────────

record YarnSkein(
  name:     String,
  colorway: String,
  fiber:    FiberType,
  weight:   YarnWeight,
  yardage:  Int,
  skeins:   Int
) {
public:
  def totalYards(): Int = yardage() * skeins()
  def label(): String = "#{name()} '#{colorway()}' [#{fiber().label()}, #{weight().label()}]"
  def summary(): String = "#{label()} — #{totalYards()} yds (#{skeins()} × #{yardage()})"
}

record NeedleSize(mm: Double, usSize: String) {
public:
  def label(): String = "#{mm()}mm (US #{usSize()})"
}

record KnittingProject(
  name:       String,
  ptype:      ProjectType,
  needles:    NeedleSize,
  yarnNames:  List[String],
  yardageUsed: Int,
  status:     ProjectStatus,
  notes:      String?
) {
public:
  def label(): String = "#{name()} (#{ptype().label()}) — #{status().label()}"
  def completion(): Int = select status() {
    case a is Active:    a.percentDone()
    case c is Completed: 100
    else: 0
  }
}

// ── Interface ─────────────────────────────────────────────────────────────────

interface Describable {
  def describe(): String
  def lineCount(): Int
}

// ── YarnStash ─────────────────────────────────────────────────────────────────

class YarnStash conforms Describable {
  val skeins: List[YarnSkein]

public:
  def this(initial: List[YarnSkein]) {
    this.skeins = initial
  }

  def count(): Int = skeins.size

  def totalYards(): Int =
    skeins.fold(0) { acc, s -> (acc as Int) + (s as YarnSkein).totalYards() }

  def totalSkeins(): Int =
    skeins.fold(0) { acc, s -> (acc as Int) + (s as YarnSkein).skeins() }

  def byWeight(): Map[String, List[YarnSkein]] =
    skeins.groupBy { s -> (s as YarnSkein).weight().label() }

  def byFiber(): Map[String, List[YarnSkein]] =
    skeins.groupBy { s -> (s as YarnSkein).fiber().label() }

  def heaviestWeight(): YarnWeight? {
    val order = [
      YarnWeight::SuperBulky, YarnWeight::Bulky, YarnWeight::Worsted,
      YarnWeight::DK, YarnWeight::Sport, YarnWeight::Fingering
    ]
    foreach w: YarnWeight in order {
      val found = skeins.find { s -> (s as YarnSkein).weight() == w }
      if found != null { return w }
    }
    return null
  }

  def animalFiberYards(): Int =
    skeins.filter { s -> (s as YarnSkein).fiber().isAnimal() }
          .fold(0) { acc, s -> (acc as Int) + (s as YarnSkein).totalYards() }

  def findByName(name: String): YarnSkein? {
    val found = skeins.find { s -> (s as YarnSkein).name() == name }
    return if found != null { found as YarnSkein? } else { null }
  }

  def describe(): String =
    "Yarn stash: #{count()} entries, #{totalSkeins()} skeins, #{totalYards()} total yards"

  def lineCount(): Int = count()
}

// ── ProjectBook ───────────────────────────────────────────────────────────────

class ProjectBook conforms Describable {
public:
  val projects: List[KnittingProject]

  def this(ps: List[KnittingProject]) {
    this.projects = ps
  }

  def count(): Int = projects.size

  def active(): List[KnittingProject] =
    projects.filter { p -> (p as KnittingProject).status().isActive() }

  def completed(): List[KnittingProject] =
    projects.filter { p -> (p as KnittingProject).status().isDone() }

  def totalYardageUsed(): Int =
    projects.fold(0) { acc, p -> (acc as Int) + (p as KnittingProject).yardageUsed() }

  def avgCompletion(): Double {
    val n = active().size
    if n == 0 { return 0.0 }
    val sum = active().fold(0) { acc, p ->
      (acc as Int) + (p as KnittingProject).completion()
    }
    return (sum as Int) * 1.0 / n
  }

  def byType(): Map[String, List[KnittingProject]] =
    projects.groupBy { p -> (p as KnittingProject).ptype().label() }

  def mostUsedNeedle(): NeedleSize? {
    val sizeCounts: Map[String, Int] = [:]
    foreach p: KnittingProject in projects {
      val k = p.needles().label()
      val cur: Int? = sizeCounts.get(k) as Int?
      sizeCounts[k] = if cur != null { (cur as Int) + 1 } else { 1 }
    }
    val top = sizeCounts.keys().sortedBy { k ->
      0 - ((sizeCounts.get(k as String) as Int?) ?: 0)
    }.find { _ -> true }
    if top == null { return null }
    val needle = projects.find { p -> (p as KnittingProject).needles().label() == (top as String) }
    return if needle != null { (needle as KnittingProject).needles() } else { null }
  }

  def describe(): String =
    "Project book: #{count()} projects, #{completed().size} done, #{active().size} active"

  def lineCount(): Int = count()
}

// ── Helper functions ──────────────────────────────────────────────────────────

def hr(n: Int): void {
  IO::println(n.rpt("─"))
}

def section(title: String): void {
  IO::println("")
  IO::println(title)
  hr(title.length())
}

def bar(value: Int, maxValue: Int, width: Int): String {
  val filled = if maxValue > 0 { value * width / maxValue } else { 0 }
  var s: String = "["
  foreach _: Int in 0..<filled       { s = s + "█" }
  foreach _: Int in filled..<width   { s = s + "·" }
  return s + "]"
}

