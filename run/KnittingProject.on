// ── Report ────────────────────────────────────────────────────────────────────

val jarWidth = 62
IO::println(jarWidth.rpt("═"))
IO::println("  KNITTING STASH & PROJECT TRACKER")
IO::println("  " + stash.describe())
IO::println("  " + projects.describe())
IO::println(jarWidth.rpt("═"))

section("YARN STASH OVERVIEW")
IO::println("  Total skeins  : " + stash.totalSkeins())
IO::println("  Total yardage : " + stash.totalYards() + " yds")
IO::println("  Animal fiber  : " + stash.animalFiberYards() + " yds (" +
  ((stash.animalFiberYards() * 1000 / stash.totalYards() + 5) / 10) + "%)")

section("STASH BY WEIGHT")
val byWeight = stash.byWeight()
val weightKeys = byWeight.keys().sortedBy { k -> k as String }
foreach wk: String in weightKeys {
  val list = byWeight.get(wk) as List[YarnSkein]
  val yards = list.fold(0) { acc, s -> (acc as Int) + (s as YarnSkein).totalYards() }
  val cnt   = list.fold(0) { acc, s -> (acc as Int) + (s as YarnSkein).skeins() }
  IO::println("  " + wk.padRight(12) + " : " + ("" + cnt).padLeft(2) + " skeins  " +
    ("" + yards).padLeft(5) + " yds  " + bar(yards, 2000, 20))
}

section("STASH BY FIBER")
val byFiber = stash.byFiber()
val fiberKeys = byFiber.keys().sortedBy { k ->
  0 - (byFiber.get(k as String) as List[YarnSkein]).fold(0) { acc, s ->
    (acc as Int) + (s as YarnSkein).totalYards()
  }
}
foreach fk: String in fiberKeys {
  val list = byFiber.get(fk) as List[YarnSkein]
  val yards = list.fold(0) { acc, s -> (acc as Int) + (s as YarnSkein).totalYards() }
  IO::println("  " + fk.padRight(10) + " : " + ("" + yards).padLeft(5) + " yds")
}

section("ALL PROJECTS")
foreach p: KnittingProject in projects.projects {
  val note = p.notes()
  val notePart = if note != null { "  → " + (note as String) } else { "" }
  IO::println("  " + p.label())
  IO::println("    Needles: #{p.needles().label()}  |  Yarn used: #{p.yardageUsed()} yds#{notePart}")
}

section("ACTIVE PROJECTS")
val activeList = projects.active()
val avgComp = projects.avgCompletion().round1()
IO::println("  Active: #{activeList.size} project(s),  avg completion: #{avgComp}%")
foreach p: KnittingProject in activeList.sortedBy { p -> (p as KnittingProject).completion() } {
  val pct = p.completion()
  IO::println("  [#{("" + pct).padLeft(3)}%] #{p.name().padRight(28)} #{bar(pct, 100, 20)}")
}

section("COMPLETED PROJECTS")
val doneList = projects.completed()
val totalUsed = projects.totalYardageUsed()
IO::println("  Finished: #{doneList.size} of #{projects.count()} project(s)")
IO::println("  Total yardage used across all projects: #{totalUsed} yds")
foreach p: KnittingProject in doneList {
  IO::println("  ✓ #{p.name()} — #{p.yardageUsed()} yds")
}

section("PROJECT BREAKDOWN BY TYPE")
val byType = projects.byType()
val typeKeys = byType.keys().sortedBy { k ->
  0 - (byType.get(k as String) as List[KnittingProject]).size
}
foreach tk: String in typeKeys {
  val list = byType.get(tk) as List[KnittingProject]
  IO::println("  " + tk.padRight(12) + " : " + list.size + " project(s)")
}

section("NEEDLE SIZE ANALYSIS")
val topNeedle = projects.mostUsedNeedle()
if topNeedle != null {
  IO::println("  Most-used needle: #{(topNeedle as NeedleSize).label()}")
}
val needleSizes = projects.projects
  .map { p -> (p as KnittingProject).needles().label() }
  .distinct()
  .sortedBy { n -> n as String }
IO::println("  Needle sizes in use: #{needleSizes.size}")
foreach ns: String in needleSizes {
  val count = projects.projects.filter { p ->
    (p as KnittingProject).needles().label() == ns
  }.size
  IO::println("  " + ns.padRight(20) + " × " + count)
}

IO::println("")
IO::println(jarWidth.rpt("═"))
IO::println("  END OF REPORT")
IO::println(jarWidth.rpt("═"))
