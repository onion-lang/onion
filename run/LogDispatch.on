import {
  java.util.*
}

// ─── Typed record types derived from log-line regex patterns ───────────────

record HttpLog(ts: String, method: String, path: String, status: Int, ms: Int)
  from re"(\d{4}-\d{2}-\d{2}) (GET|POST|PUT|DELETE|PATCH) (/\S*) (\d+) (\d+)"

record DbLog(ts: String, op: String, table: String, ms: Int)
  from re"(\d{4}-\d{2}-\d{2}) (SELECT|INSERT|UPDATE|DELETE) (\w+) (\d+)"

record SysLog(ts: String, level: String, component: String, msg: String)
  from re"(\d{4}-\d{2}-\d{2}) (ERROR|WARN|INFO) (\S+) (.+)"

record MetricLog(ts: String, name: String, value: Int)
  from re"(\d{4}-\d{2}-\d{2}) METRIC (\S+) (\d+)"

// ─── Extension methods ──────────────────────────────────────────────────────

extension Int {
  def statusClass(): String {
    if self >= 500 { return "5xx" }
    if self >= 400 { return "4xx" }
    if self >= 300 { return "3xx" }
    if self >= 200 { return "2xx" }
    return "1xx"
  }
  def msLabel(): String {
    if self < 50  { return "fast" }
    if self < 200 { return "ok  " }
    if self < 500 { return "slow" }
    return "very slow"
  }
}

extension String {
  def truncate(n: Int): String {
    if self.length() <= n { return self }
    return self.substring(0, n) + "…"
  }
  def padRight(n: Int): String {
    var s: String = self
    while s.length() < n { s = s + " " }
    return s
  }
}

// ─── Statistics accumulators ────────────────────────────────────────────────

class IntStats {
  var count_: Int = 0
  var sum_: Int = 0
  var min_: Int = 2147483647
  var max_: Int = -2147483648

  public:
  def add(v: Int): void {
    count_ = count_ + 1
    sum_ = sum_ + v
    if v < min_ { min_ = v }
    if v > max_ { max_ = v }
  }
  def count(): Int = count_
  def sum(): Int = sum_
  def min(): Int = min_
  def max(): Int = max_
  def avg(): Double {
    if count_ == 0 { return 0.0 }
    return 1.0 * sum_ / count_
  }
}

// ─── Hardcoded sample log lines ─────────────────────────────────────────────

val LOGS: List[String] = [
  "2024-01-15 GET /api/users 200 42",
  "2024-01-15 POST /api/orders 201 115",
  "2024-01-15 GET /api/products 200 18",
  "2024-01-15 SELECT orders 230",
  "2024-01-15 GET /api/users/42 404 8",
  "2024-01-15 ERROR auth.service Token expired: user 99",
  "2024-01-15 METRIC cpu.usage 72",
  "2024-01-15 PUT /api/orders/7 200 88",
  "2024-01-15 SELECT users 145",
  "2024-01-15 WARN db.pool Connection pool at 80%",
  "2024-01-15 GET /api/products/5 200 14",
  "2024-01-15 METRIC mem.usage 61",
  "2024-01-15 DELETE /api/cart/3 204 55",
  "2024-01-15 INSERT cart 33",
  "2024-01-15 GET /api/orders 500 3",
  "2024-01-15 ERROR cache Redis connection refused",
  "2024-01-15 METRIC cpu.usage 88",
  "2024-01-15 POST /api/auth/login 200 201",
  "2024-01-15 UPDATE users 67",
  "2024-01-15 INFO app.startup Listening on port 8080",
  "2024-01-15 METRIC mem.usage 64",
  "2024-01-15 GET /api/users 200 39",
  "2024-01-15 PATCH /api/users/3 200 72",
  "2024-01-15 SELECT products 22",
  "2024-01-15 WARN gc.collector Long GC pause: 310ms",
  "2024-01-15 METRIC cpu.usage 55",
  "2024-01-15 GET /health 200 2",
  "2024-01-15 POST /api/orders 400 9",
  "2024-01-15 INSERT orders 88",
  "2024-01-15 ERROR auth.service Password hash mismatch"
]

// ─── Statistics state ────────────────────────────────────────────────────────

val httpLatency: IntStats = new IntStats()
val dbLatency: IntStats = new IntStats()
val httpByMethod: Map[String, IntStats] = [:]
val httpByStatus: Map[String, IntStats] = [:]
val dbByOp: Map[String, IntStats] = [:]
val sysCount: Map[String, Int] = [:]
val metricStats: Map[String, IntStats] = [:]
var unparsed: Int = 0

// ─── Dispatch loop ───────────────────────────────────────────────────────────

foreach line: String in LOGS {
  val http: HttpLog? = HttpLog::parse(line)
  val db: DbLog? = DbLog::parse(line)
  val sys: SysLog? = SysLog::parse(line)
  val metric: MetricLog? = MetricLog::parse(line)

  if http != null {
    val ms: Int = http.ms()
    httpLatency.add(ms)
    val method: String = http.method()
    if !httpByMethod.containsKey(method) { httpByMethod[method] = new IntStats() }
    httpByMethod[method].add(ms)
    val cls: String = http.status().statusClass()
    if !httpByStatus.containsKey(cls) { httpByStatus[cls] = new IntStats() }
    httpByStatus[cls].add(1)
  } else if db != null {
    val ms: Int = db.ms()
    dbLatency.add(ms)
    val op: String = db.op()
    if !dbByOp.containsKey(op) { dbByOp[op] = new IntStats() }
    dbByOp[op].add(ms)
  } else if sys != null {
    val lvl: String = sys.level()
    sysCount[lvl] = (sysCount[lvl] ?: 0) + 1
  } else if metric != null {
    val name: String = metric.name()
    if !metricStats.containsKey(name) { metricStats[name] = new IntStats() }
    metricStats[name].add(metric.value())
  } else {
    unparsed = unparsed + 1
  }
}

// ─── Report helpers ──────────────────────────────────────────────────────────

def separator(n: Int): String {
  var s: String = ""
  foreach i: Int in 0..<n { s = s + "─" }
  return s
}

def fmtDouble(d: Double, decimals: Int): String {
  val mult: Int = if decimals == 1 { 10 } else { 100 }
  val rounded: Int = (d * mult + 0.5) as Int
  val whole: Int = rounded / mult
  val frac: Int = rounded % mult
  if decimals == 1 { return whole + "." + frac }
  val fracStr: String = if frac < 10 { "0" + frac } else { "" + frac }
  return whole + "." + fracStr
}

// ─── HTTP report ─────────────────────────────────────────────────────────────

IO::println("╔══════════════════════════════════════════════════╗")
IO::println("║           LOG DISPATCH ANALYSIS REPORT           ║")
IO::println("╚══════════════════════════════════════════════════╝")
IO::println("")

IO::println("── HTTP Requests (" + httpLatency.count() + " total) " + separator(28))
IO::println("  Overall latency : avg=" + fmtDouble(httpLatency.avg(), 1) + "ms" +
            "  min=" + httpLatency.min() + "ms  max=" + httpLatency.max() + "ms")

IO::println("  By method:")
val methods: List[String] = httpByMethod.keySet().stream().sorted().toList()
foreach m: String in methods {
  val st: IntStats = httpByMethod[m]
  val label: String = ("  " + m.padRight(8)).padRight(14)
  IO::println(label + "  n=" + st.count() + "  avg=" + fmtDouble(st.avg(), 1) + "ms")
}

IO::println("  By status class:")
val classes: List[String] = httpByStatus.keySet().stream().sorted().toList()
foreach cls: String in classes {
  IO::println("    " + cls.padRight(6) + "  n=" + httpByStatus[cls].count())
}

// ─── DB report ───────────────────────────────────────────────────────────────

IO::println("")
IO::println("── Database Queries (" + dbLatency.count() + " total) " + separator(26))
IO::println("  Overall latency : avg=" + fmtDouble(dbLatency.avg(), 1) + "ms" +
            "  min=" + dbLatency.min() + "ms  max=" + dbLatency.max() + "ms")

IO::println("  By operation:")
val ops: List[String] = dbByOp.keySet().stream().sorted().toList()
foreach op: String in ops {
  val st: IntStats = dbByOp[op]
  IO::println("    " + op.padRight(8) + "  n=" + st.count() + "  avg=" + fmtDouble(st.avg(), 1) + "ms")
}

// ─── System log report ───────────────────────────────────────────────────────

IO::println("")
IO::println("── System Logs " + separator(36))
foreach (lvl, cnt) in sysCount {
  val marker: String = select lvl {
    case "ERROR": "[!]"
    case "WARN":  "[~]"
    else:         "[ ]"
  }
  IO::println("  " + marker + " " + lvl.padRight(6) + "  n=" + cnt)
}

// ─── Metrics report ─────────────────────────────────────────────────────────

IO::println("")
IO::println("── Metrics " + separator(40))
val mnames: List[String] = metricStats.keySet().stream().sorted().toList()
foreach name: String in mnames {
  val st: IntStats = metricStats[name]
  IO::println("  " + name.padRight(16) +
              "  avg=" + fmtDouble(st.avg(), 1) +
              "  min=" + st.min() +
              "  max=" + st.max())
}

// ─── Summary ─────────────────────────────────────────────────────────────────

IO::println("")
val total: Int = httpLatency.count() + dbLatency.count() +
                 sysCount.values().stream().mapToInt { v: Int -> v }.sum() +
                 metricStats.values().stream().mapToInt { st: IntStats -> st.count() }.sum() +
                 unparsed
IO::println("── Summary " + separator(40))
IO::println("  Total log lines : " + LOGS.size)
IO::println("  HTTP            : " + httpLatency.count())
IO::println("  Database        : " + dbLatency.count())
IO::println("  System          : " + (total - httpLatency.count() - dbLatency.count() -
                                      metricStats.values().stream()
                                        .mapToInt { st: IntStats -> st.count() }.sum() -
                                      unparsed))
IO::println("  Metrics         : " + metricStats.values().stream()
                                        .mapToInt { st: IntStats -> st.count() }.sum())
IO::println("  Unparsed        : " + unparsed)
