// ── Planner logic ─────────────────────────────────────────────────────────────

def pickRecipe(recipes: List[Object], mt: MealTime, required: List[Object]): Recipe? = {
  foreach r: Recipe in recipes {
    if r.mealTime() == mt && r.suitableFor(required) { return r }
  }
  null
}

def buildDayPlan(date: String, recipes: List[Object], required: List[Object]): DayPlan = {
  val meals: Map[Object, Object] = [:]
  val times: List[Object] = [new Breakfast(), new Lunch(), new Dinner(), new Snack()]
  foreach t: MealTime in times {
    val r: Recipe? = pickRecipe(recipes, t, required)
    if r != null { meals.put(t, r) }
  }
  new DayPlan(date, meals)
}

// ── Report helpers ────────────────────────────────────────────────────────────

def printDayPlan(plan: DayPlan): void {
  IO::println("=== #{plan.date()} ===")
  val timeOrder: List[Object] = [new Breakfast(), new Lunch(), new Dinner(), new Snack()]
  foreach t: MealTime in timeOrder {
    val r: Recipe? = plan.meals().get(t) as Recipe?
    if r != null {
      val n = r.totalNutrients()
      IO::println("  [#{t.label()}] #{r.name()}")
      IO::println("    #{n.summary()}")
      foreach c: RecipeComponent in r.components() {
        val cn = c.nutrients()
        IO::println("      - #{c.ingredient().name()} #{fmt1(c.grams())}g  (#{cn.summary()})")
      }
    }
  }
  val tot = plan.totalNutrients()
  IO::println("  DAILY TOTAL: #{tot.summary()}")
  IO::println("")
}

def printWeekSummary(plans: List[Object], title: String): void {
  IO::println("════════════════════════════════════")
  IO::println("  #{title} — #{plans.size()}-day summary")
  IO::println("════════════════════════════════════")
  var totCal = 0.0; var totP = 0.0; var totC = 0.0; var totF = 0.0; var totFib = 0.0
  foreach p: DayPlan in plans {
    val n = p.totalNutrients()
    totCal = totCal + n.calories()
    totP   = totP   + n.protein()
    totC   = totC   + n.carbs()
    totF   = totF   + n.fat()
    totFib = totFib + n.fiber()
  }
  val d = plans.size() * 1.0
  IO::println("  Avg Calories : #{fmt1(totCal / d)} kcal")
  IO::println("  Avg Protein  : #{fmt1(totP   / d)} g")
  IO::println("  Avg Carbs    : #{fmt1(totC   / d)} g")
  IO::println("  Avg Fat      : #{fmt1(totF   / d)} g")
  IO::println("  Avg Fiber    : #{fmt1(totFib / d)} g")
  IO::println("")
}

def printCatalogStats(recipes: List[Object], ingredients: List[Object]): void {
  IO::println("════════════════════════════════════")
  IO::println("  Recipe Catalogue Statistics")
  IO::println("════════════════════════════════════")
  IO::println("  Total recipes    : #{recipes.size()}")
  IO::println("  Total ingredients: #{ingredients.size()}")
  val timeOrder: List[Object] = [new Breakfast(), new Lunch(), new Dinner(), new Snack()]
  foreach t: MealTime in timeOrder {
    var cnt = 0
    foreach r: Recipe in recipes { if r.mealTime() == t { cnt = cnt + 1 } }
    IO::println("    #{t.label()} recipes: #{cnt}")
  }
  IO::println("  Ingredients per flag:")
  val flagOrder: List[Object] = [new Vegan(), new Vegetarian(), new GlutenFree(), new DairyFree(), new NutFree(), new LowCarb()]
  foreach f: DietaryFlag in flagOrder {
    var cnt = 0
    foreach i: Ingredient in ingredients { if i.hasFlag(f) { cnt = cnt + 1 } }
    IO::println("    #{f.label()}: #{cnt}")
  }
  IO::println("")
}

// ── Entry point ───────────────────────────────────────────────────────────────

val ingredients = makeIngredients()
val idx         = buildIndex(ingredients)
val allRecipes  = makeRecipes(idx)

printCatalogStats(allRecipes, ingredients)

// Vegan 3-day plan
IO::println("──────────── VEGAN MEAL PLAN ────────────")
val veganReq: List[Object] = [new Vegan()]
val veganDays: List[Object] = ["Monday", "Tuesday", "Wednesday"]
val veganPlans: List[Object] = []
foreach day: String in veganDays {
  val plan = buildDayPlan(day, allRecipes, veganReq)
  veganPlans.add(plan)
  printDayPlan(plan)
}
printWeekSummary(veganPlans, "Vegan")

// Gluten-free 4-day plan
IO::println("──────────── GLUTEN-FREE MEAL PLAN ────────────")
val gfReq: List[Object] = [new GlutenFree()]
val gfDays: List[Object] = ["Thursday", "Friday", "Saturday", "Sunday"]
val gfPlans: List[Object] = []
foreach day: String in gfDays {
  val plan = buildDayPlan(day, allRecipes, gfReq)
  gfPlans.add(plan)
  printDayPlan(plan)
}
printWeekSummary(gfPlans, "Gluten-Free")
