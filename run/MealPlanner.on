def buildIndex(ingredients: List[Object]): Map[Object, Object] = {
  val m: Map[Object, Object] = [:]
  foreach i: Ingredient in ingredients { m.put(i.name(), i) }
  m
}

def rc(idx: Map[Object, Object], name: String, g: Double): RecipeComponent =
  new RecipeComponent(idx.get(name) as Ingredient, g)

