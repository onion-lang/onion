// Music Theory Toolbox: notes, scales, chords, intervals, progressions
// Exercises: homogeneous enum, records with methods, extension methods on Int/String,
// collection pipelines (map/filter/contains/size), closures, pattern matching,
// string interpolation, foreach on ranges, static vals, nullable types

import { java.util.List; java.util.ArrayList; }

enum Note { C, CSharp, D, DSharp, E, F, FSharp, G, GSharp, A, ASharp, B }
enum ScaleType { Major, NaturalMinor, HarmonicMinor, Pentatonic, Blues }
enum ChordQuality { MajorQ, MinorQ, DiminishedQ, AugmentedQ, Dom7, Maj7, Min7 }

record Scale(root: Note, kind: ScaleType)
record Chord(root: Note, quality: ChordQuality)
record ProgressionStep(degree: Int, chord: Chord)

// ── Extension methods ─────────────────────────────────────────────────────────

extension Int {
  def semitoneWrap(): Int = ((self % 12) + 12) % 12
  def toNoteName(): String = noteName(noteAt(self))
}

extension String {
  def padTo(n: Int): String {
    var s: String = self
    while s.length() < n { s = s + " " }
    return s
  }
}

// ── Note helpers ──────────────────────────────────────────────────────────────

static def semitoneOf(n: Note): Int = select n {
  case Note::C:       0
  case Note::CSharp:  1
  case Note::D:       2
  case Note::DSharp:  3
  case Note::E:       4
  case Note::F:       5
  case Note::FSharp:  6
  case Note::G:       7
  case Note::GSharp:  8
  case Note::A:       9
  case Note::ASharp: 10
  case Note::B:      11
  else:              -1
}

static def noteAt(semitone: Int): Note = select semitone.semitoneWrap() {
  case 0:  Note::C
  case 1:  Note::CSharp
  case 2:  Note::D
  case 3:  Note::DSharp
  case 4:  Note::E
  case 5:  Note::F
  case 6:  Note::FSharp
  case 7:  Note::G
  case 8:  Note::GSharp
  case 9:  Note::A
  case 10: Note::ASharp
  else:    Note::B
}

static def noteName(n: Note): String = select n {
  case Note::C:       "C"
  case Note::CSharp:  "C#"
  case Note::D:       "D"
  case Note::DSharp:  "D#"
  case Note::E:       "E"
  case Note::F:       "F"
  case Note::FSharp:  "F#"
  case Note::G:       "G"
  case Note::GSharp:  "G#"
  case Note::A:       "A"
  case Note::ASharp:  "A#"
  case Note::B:       "B"
  else:               "?"
}

static def qualityName(q: ChordQuality): String = select q {
  case ChordQuality::MajorQ:      ""
  case ChordQuality::MinorQ:      "m"
  case ChordQuality::DiminishedQ: "dim"
  case ChordQuality::AugmentedQ:  "aug"
  case ChordQuality::Dom7:        "7"
  case ChordQuality::Maj7:        "maj7"
  case ChordQuality::Min7:        "m7"
  else:                           "?"
}

static def scaleTypeName(st: ScaleType): String = select st {
  case ScaleType::Major:         "Major"
  case ScaleType::NaturalMinor:  "Natural Minor"
  case ScaleType::HarmonicMinor: "Harmonic Minor"
  case ScaleType::Pentatonic:    "Pentatonic"
  case ScaleType::Blues:         "Blues"
  else:                          "Unknown"
}

static def chordName(c: Chord): String = noteName(c.root()) + qualityName(c.quality())

// ── Scale building ─────────────────────────────────────────────────────────────

static def scaleIntervalList(st: ScaleType): List[Int] {
  return select st {
  case ScaleType::Major:         [2, 2, 1, 2, 2, 2, 1]
  case ScaleType::NaturalMinor:  [2, 1, 2, 2, 1, 2, 2]
  case ScaleType::HarmonicMinor: [2, 1, 2, 2, 1, 3, 1]
  case ScaleType::Pentatonic:    [2, 2, 3, 2, 3]
  else:                          [3, 2, 1, 1, 3, 2]
  }
}

static def buildScale(root: Note, st: ScaleType): List[Note] {
  val intervals = scaleIntervalList(st)
  val result: List[Note] = new ArrayList[Note]()
  result.add(root)
  var current = semitoneOf(root)
  foreach step: Int in intervals {
    current = current + step
    result.add(noteAt(current))
  }
  return result
}

// ── Chord building ─────────────────────────────────────────────────────────────

static def chordIntervalList(q: ChordQuality): List[Int] {
  return select q {
  case ChordQuality::MajorQ:      [0, 4, 7]
  case ChordQuality::MinorQ:      [0, 3, 7]
  case ChordQuality::DiminishedQ: [0, 3, 6]
  case ChordQuality::AugmentedQ:  [0, 4, 8]
  case ChordQuality::Dom7:        [0, 4, 7, 10]
  case ChordQuality::Maj7:        [0, 4, 7, 11]
  else:                           [0, 3, 7, 10]
  }
}

static def buildChordNotes(c: Chord): List[Note] {
  val root = semitoneOf(c.root())
  val intervals = chordIntervalList(c.quality())
  return intervals.map { iv: Int -> noteAt(root + iv) }
}

// ── Interval helpers ────────────────────────────────────────────────────────────

static def intervalBetween(from: Note, to: Note): Int =
  (semitoneOf(to) - semitoneOf(from) + 12) % 12

static def intervalName(semitones: Int): String = select semitones {
  case 0:  "Unison"
  case 1:  "Min 2nd"
  case 2:  "Maj 2nd"
  case 3:  "Min 3rd"
  case 4:  "Maj 3rd"
  case 5:  "Perf 4th"
  case 6:  "Tritone"
  case 7:  "Perf 5th"
  case 8:  "Min 6th"
  case 9:  "Maj 6th"
  case 10: "Min 7th"
  case 11: "Maj 7th"
  else:    "?"
}

// ── Diatonic progression ───────────────────────────────────────────────────────

static val MAJOR_Q: List[ChordQuality] = [
  ChordQuality::MajorQ, ChordQuality::MinorQ, ChordQuality::MinorQ,
  ChordQuality::MajorQ, ChordQuality::Dom7,   ChordQuality::MinorQ,
  ChordQuality::DiminishedQ
]
static val MINOR_Q: List[ChordQuality] = [
  ChordQuality::MinorQ, ChordQuality::DiminishedQ, ChordQuality::MajorQ,
  ChordQuality::MinorQ, ChordQuality::MinorQ,      ChordQuality::MajorQ,
  ChordQuality::Dom7
]

static def diatonicProgression(root: Note, st: ScaleType): List[ProgressionStep] {
  val scaleNotes = buildScale(root, st)
  val qualities: List[ChordQuality] = if st == ScaleType::Major { MAJOR_Q } else { MINOR_Q }
  val result: List[ProgressionStep] = new ArrayList[ProgressionStep]()
  val maxDegree = if qualities.size() < scaleNotes.size() { qualities.size() } else { scaleNotes.size() }
  foreach i: Int in 0..<maxDegree {
    val note = (scaleNotes[i] as Note)
    val q    = (qualities[i] as ChordQuality)
    result.add(new ProgressionStep(i + 1, new Chord(note, q)))
  }
  return result
}

// ── Printing helpers ──────────────────────────────────────────────────────────

static def noteListStr(notes: List[Note]): String {
  val sb: java.lang.StringBuilder = new java.lang.StringBuilder()
  var first: Boolean = true
  foreach n: Note in notes {
    if !first { sb.append(", ") }
    sb.append(noteName(n))
    first = false
  }
  return sb.toString()
}

static def printScaleInfo(root: Note, st: ScaleType): void {
  val notes = buildScale(root, st)
  IO::println("#{noteName(root)} #{scaleTypeName(st)} (#{notes.size()} notes): #{noteListStr(notes)}")
}

static def printChordInfo(c: Chord): void {
  val notes = buildChordNotes(c)
  IO::println("  #{chordName(c).padTo(8)}: [#{noteListStr(notes)}]")
}

static def printProgression(root: Note, st: ScaleType): void {
  IO::println("  #{noteName(root)} #{scaleTypeName(st)} diatonic chords:")
  val steps = diatonicProgression(root, st)
  foreach step: ProgressionStep in steps {
    val c = step.chord()
    val notes = buildChordNotes(c)
    IO::println("    Degree #{step.degree()}: #{chordName(c).padTo(8)} [#{noteListStr(notes)}]")
  }
}

// ── Common-note analysis ────────────────────────────────────────────────────────

static def commonNotes(a: Chord, b: Chord): List[Note] {
  val aNotes = buildChordNotes(a)
  val bNotes = buildChordNotes(b)
  return aNotes.filter { n: Note -> bNotes.contains(n) }
}

// ── Main program ───────────────────────────────────────────────────────────────

IO::println("=== Music Theory Toolbox ===")
IO::println("")

// 1. Scale survey
IO::println("── Scales ──────────────────────────────────────────────────")
printScaleInfo(Note::C, ScaleType::Major)
printScaleInfo(Note::A, ScaleType::NaturalMinor)
printScaleInfo(Note::G, ScaleType::Major)
printScaleInfo(Note::D, ScaleType::HarmonicMinor)
printScaleInfo(Note::E, ScaleType::Pentatonic)
printScaleInfo(Note::A, ScaleType::Blues)
IO::println("")

// 2. Chord survey
IO::println("── Chords ──────────────────────────────────────────────────")
val sampleChords: List[Chord] = [
  new Chord(Note::C,      ChordQuality::MajorQ),
  new Chord(Note::A,      ChordQuality::MinorQ),
  new Chord(Note::G,      ChordQuality::Dom7),
  new Chord(Note::B,      ChordQuality::DiminishedQ),
  new Chord(Note::E,      ChordQuality::AugmentedQ),
  new Chord(Note::FSharp, ChordQuality::Min7),
  new Chord(Note::D,      ChordQuality::Maj7)
]
foreach c: Chord in sampleChords {
  printChordInfo(c)
}
IO::println("")

// 3. Diatonic progressions
IO::println("── Diatonic Progressions ───────────────────────────────────")
printProgression(Note::C, ScaleType::Major)
IO::println("")
printProgression(Note::A, ScaleType::NaturalMinor)
IO::println("")
printProgression(Note::G, ScaleType::Major)
IO::println("")

// 4. Common-note analysis for voice leading
IO::println("── Voice Leading: Common Notes ─────────────────────────────")
val voicePairs: List[List[Chord]] = [
  [new Chord(Note::C, ChordQuality::MajorQ), new Chord(Note::G, ChordQuality::Dom7)],
  [new Chord(Note::C, ChordQuality::MajorQ), new Chord(Note::A, ChordQuality::MinorQ)],
  [new Chord(Note::G, ChordQuality::Dom7),   new Chord(Note::C, ChordQuality::MajorQ)],
  [new Chord(Note::D, ChordQuality::MinorQ), new Chord(Note::G, ChordQuality::Dom7)]
]
foreach pair: List[Chord] in voicePairs {
  val a = (pair[0] as Chord)
  val b = (pair[1] as Chord)
  val common = commonNotes(a, b)
  IO::println("  #{chordName(a).padTo(6)} -> #{chordName(b).padTo(6)}: common=[#{noteListStr(common)}]")
}
IO::println("")

// 5. Interval table from C
IO::println("── Intervals from C ────────────────────────────────────────")
foreach n: Note in Note::values() {
  val semi = intervalBetween(Note::C, n)
  IO::println("  C -> #{noteName(n).padTo(3)}: #{intervalName(semi).padTo(9)} (#{semi} st)")
}
IO::println("")

// 6. Pipeline: major scales containing both E and B
IO::println("── Major scales containing both E and B ────────────────────")
foreach root: Note in Note::values() {
  val scale = buildScale(root, ScaleType::Major)
  if scale.contains(Note::E) && scale.contains(Note::B) {
    IO::println("  #{noteName(root)} Major: #{noteListStr(scale)}")
  }
}
IO::println("")

// 7. Extension Int: semitone -> note name mapping
IO::println("── Semitone -> Note (extension Int) ────────────────────────")
foreach i: Int in 0..11 {
  IO::println("  #{i}: #{i.toNoteName()}")
}
IO::println("")

// 8. Relative minor / major relationships
IO::println("── Relative Key Pairs ──────────────────────────────────────")
foreach root: Note in Note::values() {
  val relMinorRoot = noteAt(semitoneOf(root) + 9)
  IO::println("  #{noteName(root).padTo(3)} Major  <->  #{noteName(relMinorRoot).padTo(3)} Natural Minor")
}
IO::println("")

IO::println("=== Done ===")
