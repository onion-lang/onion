// Diff engine: LCS-based shortest edit script between two sequences of strings.
// Produces unified-diff output with @@ hunks and context lines.
// Exercises: ADT enum, records, generics, recursion, foreach/select patterns,
//            flat-array DP, collection pipelines, string interpolation.

enum Edit {
  case Keep(line: String)
  case Insert(line: String)
  case Delete(line: String)
}

record DiffResult(edits: List[Object], adds: Int, dels: Int, same: Int)

record Hunk(aStart: Int, aLen: Int, bStart: Int, bLen: Int, lines: List[String])

// ---- LCS DP (flat Int[] of size (n+1)*(m+1)) ----
def lcsFlat(a: List[String], b: List[String]): Int[] {
  val n: Int = a.size
  val m: Int = b.size
  val dp: Int[] = new Int[(n + 1) * (m + 1)]
  foreach i: Int in 1..n {
    foreach j: Int in 1..m {
      val ai: String = a[i - 1]
      val bj: String = b[j - 1]
      if ai == bj {
        dp[i * (m + 1) + j] = dp[(i - 1) * (m + 1) + (j - 1)] + 1
      } else {
        val up:   Int = dp[(i - 1) * (m + 1) + j]
        val left: Int = dp[i * (m + 1) + (j - 1)]
        dp[i * (m + 1) + j] = if up > left { up } else { left }
      }
    }
  }
  return dp
}

// ---- Backtrack through DP table, appending to acc in REVERSE order ----
def backtrack(dp: Int[], a: List[String], b: List[String],
              m: Int, i: Int, j: Int, acc: List[Object]): void {
  if i == 0 && j == 0 { return }
  if i == 0 {
    acc.add(new Insert(b[j - 1]))
    backtrack(dp, a, b, m, i, j - 1, acc)
    return
  }
  if j == 0 {
    acc.add(new Delete(a[i - 1]))
    backtrack(dp, a, b, m, i - 1, j, acc)
    return
  }
  val ai: String = a[i - 1]
  val bj: String = b[j - 1]
  if ai == bj {
    acc.add(new Keep(ai))
    backtrack(dp, a, b, m, i - 1, j - 1, acc)
  } else if dp[(i - 1) * (m + 1) + j] >= dp[i * (m + 1) + (j - 1)] {
    acc.add(new Delete(ai))
    backtrack(dp, a, b, m, i - 1, j, acc)
  } else {
    acc.add(new Insert(bj))
    backtrack(dp, a, b, m, i, j - 1, acc)
  }
}

def diff(a: List[String], b: List[String]): List[Object] {
  val dp: Int[] = lcsFlat(a, b)
  val rev: List[Object] = []
  backtrack(dp, a, b, b.size, a.size, b.size, rev)
  val result: List[Object] = []
  var idx: Int = rev.size - 1
  while idx >= 0 {
    result.add(rev[idx])
    idx = idx - 1
  }
  return result
}

// ---- Statistics ----
def diffStats(edits: List[Object]): DiffResult {
  var adds: Int = 0
  var dels: Int = 0
  var same: Int = 0
  foreach e: Object in edits {
    select e {
      case ek is Keep:   { same = same + 1 }
      case ei is Insert: { adds = adds + 1 }
      case ed is Delete: { dels = dels + 1 }
    }
  }
  return new DiffResult(edits, adds, dels, same)
}

// ---- Position counters ----
record Pos(a: Int, b: Int)

def posAfter(edits: List[Object], upTo: Int): Pos {
  var a: Int = 0
  var b: Int = 0
  foreach j: Int in 0..<upTo {
    select (edits[j] as Object) {
      case ek is Keep:   { a = a + 1; b = b + 1 }
      case ei is Insert: { b = b + 1 }
      case ed is Delete: { a = a + 1 }
    }
  }
  return new Pos(a, b)
}

// ---- Build unified-diff hunks (context = 3 lines) ----
def buildHunks(edits: List[Object]): List[Object] {
  val ctx: Int = 3
  val n: Int = edits.size
  val hunks: List[Object] = []
  var i: Int = 0
  while i < n {
    var isChange: Boolean = false
    select (edits[i] as Object) {
      case ek is Keep:   { isChange = false }
      case ei is Insert: { isChange = true }
      case ed is Delete: { isChange = true }
    }
    if !isChange {
      i = i + 1
    } else {
      val cStart: Int = if i - ctx < 0 { 0 } else { i - ctx }
      val pos: Pos = posAfter(edits, cStart)
      val aStart: Int = pos.a() + 1
      val bStart: Int = pos.b() + 1
      val hlines: List[String] = []
      foreach j: Int in cStart..<i {
        select (edits[j] as Object) {
          case ek is Keep: { hlines.add(" " + ek.line()) }
          else: {}
        }
      }
      var j: Int = i
      var lastChange: Int = i
      while j < n {
        select (edits[j] as Object) {
          case ek is Keep: {
            if j - lastChange > ctx {
              j = n
            } else {
              hlines.add(" " + ek.line())
              j = j + 1
            }
          }
          case ei is Insert: {
            hlines.add("+" + ei.line())
            lastChange = j
            j = j + 1
          }
          case ed is Delete: {
            hlines.add("-" + ed.line())
            lastChange = j
            j = j + 1
          }
        }
      }
      var aLen: Int = 0
      var bLen: Int = 0
      foreach hline: String in hlines {
        if hline.startsWith(" ") || hline.startsWith("-") { aLen = aLen + 1 }
        if hline.startsWith(" ") || hline.startsWith("+") { bLen = bLen + 1 }
      }
      hunks.add(new Hunk(aStart, aLen, bStart, bLen, hlines))
      i = lastChange + ctx + 1
    }
  }
  return hunks
}

// ---- Render unified diff ----
def renderDiff(fileA: String, fileB: String, hunks: List[Object]): void {
  IO::println("--- " + fileA)
  IO::println("+++ " + fileB)
  foreach h: Object in hunks {
    val hunk: Hunk = h as Hunk
    IO::println("@@ -#{hunk.aStart()},#{hunk.aLen()} +#{hunk.bStart()},#{hunk.bLen()} @@")
    foreach line: String in hunk.lines() {
      IO::println(line)
    }
  }
}

// ---- Split a string on newlines ----
def splitLines(text: String): List[String] {
  val result: List[String] = []
  val parts: List[String] = Strings::split(text, "\n")
  foreach p: String in parts {
    result.add(p)
  }
  return result
}

// ---- Word-level inline diff ----
def wordDiff(sentA: String, sentB: String): String {
  val wa: List[String] = []
  val wb: List[String] = []
  foreach w: Object in Strings::split(sentA, " ") { wa.add(w as String) }
  foreach w: Object in Strings::split(sentB, " ") { wb.add(w as String) }
  val edits: List[Object] = diff(wa, wb)
  var out: String = ""
  foreach e: Object in edits {
    select e {
      case ek is Keep:   { out = out + ek.line() + " " }
      case ei is Insert: { out = out + "[+" + ei.line() + "] " }
      case ed is Delete: { out = out + "[-" + ed.line() + "] " }
    }
  }
  return out.trim()
}

// ---- main ----
def main(): void {
  IO::println("=== MyersDiff Demo ===")
  IO::println("")

  // Demo 1: fruit list
  val origFruits: List[String] = splitLines(
    "apple\nbanana\ncherry\ndate\nelderberry\nfig\ngrape\nhoneydew\nkiwi\nlemon"
  )
  val modFruits: List[String] = splitLines(
    "apple\nblueberry\ncherry\ndate\neggfruit\nelderberry\nfig\ngrapefruit\nhoneydew\njackfruit\nkiwi\nlime"
  )
  val fruitEdits: List[Object] = diff(origFruits, modFruits)
  val fs: DiffResult = diffStats(fruitEdits)
  IO::println("--- Fruit list diff ---")
  IO::println("#{origFruits.size} -> #{modFruits.size} lines   +#{fs.adds()} -#{fs.dels()} =#{fs.same()}")
  IO::println("")
  renderDiff("fruits-original.txt", "fruits-modified.txt", buildHunks(fruitEdits))
  IO::println("")

  // Demo 2: Shakespeare sonnet
  val sonnetA: List[String] = splitLines(
    "Shall I compare thee to a summer's day?\n" +
    "Thou art more lovely and more temperate:\n" +
    "Rough winds do shake the darling buds of May,\n" +
    "And summer's lease hath all too short a date:\n" +
    "Sometime too hot the eye of heaven shines,\n" +
    "And often is his gold complexion dimm'd;\n" +
    "And every fair from fair sometime declines,\n" +
    "By chance, or nature's changing course untrimm'd"
  )
  val sonnetB: List[String] = splitLines(
    "Shall I compare thee to a winter's night?\n" +
    "Thou art more lovely and more temperate:\n" +
    "Rough winds do shake the darling buds of May,\n" +
    "And winter's lease hath all too short a date:\n" +
    "Sometime too cold the eye of heaven shines,\n" +
    "And often is his gold complexion dimm'd;\n" +
    "And every fair from fair sometime declines,\n" +
    "By fortune, or nature's changing course untrimm'd"
  )
  val se: List[Object] = diff(sonnetA, sonnetB)
  val ss: DiffResult = diffStats(se)
  IO::println("--- Sonnet diff ---")
  IO::println("#{sonnetA.size} -> #{sonnetB.size} lines   +#{ss.adds()} -#{ss.dels()} =#{ss.same()}")
  IO::println("")
  renderDiff("sonnet-a.txt", "sonnet-b.txt", buildHunks(se))
  IO::println("")

  // Demo 3: word-level inline diff
  IO::println("--- Word-level diff ---")
  val pairs: List[String] = splitLines(
    "summer's|winter's\n" +
    "By chance|By fortune\n" +
    "Sometime too hot|Sometime too cold"
  )
  foreach p: String in pairs {
    val idx: Int = p.indexOf("|")
    if idx >= 0 {
      val la: String = p.substring(0, idx)
      val lb: String = p.substring(idx + 1, p.length())
      IO::println("A: " + la)
      IO::println("B: " + lb)
      IO::println("D: " + wordDiff(la, lb))
      IO::println("")
    }
  }

  // Demo 4: identity check
  IO::println("--- Identity check ---")
  val sameEdits: List[Object] = diff(origFruits, origFruits)
  val sameS: DiffResult = diffStats(sameEdits)
  if sameS.adds() == 0 && sameS.dels() == 0 && sameS.same() == origFruits.size {
    IO::println("PASS: identical input => no changes, #{sameS.same()} kept lines")
  } else {
    IO::println("FAIL: +#{sameS.adds()} -#{sameS.dels()} =#{sameS.same()}")
  }

  // Demo 5: empty vs non-empty
  IO::println("")
  IO::println("--- Empty vs non-empty ---")
  val empty: List[String] = []
  val three: List[String] = splitLines("line1\nline2\nline3")
  val ef: DiffResult = diffStats(diff(empty, three))
  IO::println("empty -> 3 lines: +#{ef.adds()} -#{ef.dels()} =#{ef.same()}")
  val fe: DiffResult = diffStats(diff(three, empty))
  IO::println("3 lines -> empty: +#{fe.adds()} -#{fe.dels()} =#{fe.same()}")

  IO::println("")
  IO::println("Done.")
}
