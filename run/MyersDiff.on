// MyersDiff.on — LCS-based line diff with unified-diff output.
// Exercises: ADT enums (DiffOp), records (Hunk, DiffStats), classes
//            (DiffEngine), flat-2D Int[] DP table, collection pipelines
//            (filter/map/fold/sortedBy), foreach ranges, closures,
//            select type patterns, nullable types, string interpolation.

// ── DiffOp ────────────────────────────────────────────────────────────────────

enum DiffOp {
  case Keep(line: String)
  case Ins(line: String)
  case Del(line: String)
public:
  def sign(): String = select this {
    case k is Keep: " "
    case i is Ins:  "+"
    case d is Del:  "-"
  }
  def content(): String = select this {
    case k is Keep: k.line()
    case i is Ins:  i.line()
    case d is Del:  d.line()
  }
  def isChange(): Boolean = select this { case k is Keep: false; else: true }
}

// ── Hunk ──────────────────────────────────────────────────────────────────────

record Hunk(oldStart: Int, oldLen: Int, newStart: Int, newLen: Int, ops: List[DiffOp]) {
public:
  def header(): String =
    "@@ -#{oldStart()},#{oldLen()} +#{newStart()},#{newLen()} @@"
}

// ── DiffStats ─────────────────────────────────────────────────────────────────

record DiffStats(added: Int, removed: Int, unchanged: Int) {
public:
  def show(): String = "+#{added()} -#{removed()} ~#{unchanged()}"
}

// ── DiffEngine ────────────────────────────────────────────────────────────────

class DiffEngine {
public:
  // Split a multi-line string into a list of lines.
  static def lines(text: String): List[String] =
    Strings::split(text, "\n")

  // Compute LCS-based diff between two line lists.
  // Returns DiffOp list in forward order.
  static def diff(a: List[String], b: List[String]): List[DiffOp] {
    val n: Int = a.size
    val m: Int = b.size
    if n == 0 && m == 0 { return [] }

    // Flat 2-D DP: dp[i*(m+1)+j] = LCS length of a[0..i-1] vs b[0..j-1]
    val dp: Int[] = new Int[(n + 1) * (m + 1)]
    foreach i: Int in 1..n {
      foreach j: Int in 1..m {
        val idx: Int = i * (m + 1) + j
        if a[i - 1] == b[j - 1] {
          dp[idx] = dp[(i - 1) * (m + 1) + (j - 1)] + 1
        } else {
          val up: Int   = dp[(i - 1) * (m + 1) + j]
          val left: Int = dp[i * (m + 1) + (j - 1)]
          dp[idx] = if up >= left { up } else { left }
        }
      }
    }

    // Backtrack from (n, m) — builds ops in reverse order.
    val rops: List[DiffOp] = []
    var i: Int = n
    var j: Int = m
    while i > 0 || j > 0 {
      if i > 0 && j > 0 && a[i - 1] == b[j - 1] {
        rops.add(new Keep(a[i - 1]))
        i = i - 1; j = j - 1
      } else if j > 0 && (i == 0 || dp[i * (m + 1) + j] <= dp[i * (m + 1) + (j - 1)]) {
        rops.add(new Ins(b[j - 1]))
        j = j - 1
      } else {
        rops.add(new Del(a[i - 1]))
        i = i - 1
      }
    }

    // Reverse rops → forward order
    val ops: List[DiffOp] = []
    var k: Int = rops.size - 1
    while k >= 0 { ops.add(rops[k]); k = k - 1 }
    return ops
  }

  // Compute aggregate stats from an ops list.
  static def stats(ops: List[DiffOp]): DiffStats {
    var added: Int = 0; var removed: Int = 0; var unchanged: Int = 0
    foreach op: DiffOp in ops {
      select op {
        case k is Keep: unchanged = unchanged + 1
        case i is Ins:  added = added + 1
        case d is Del:  removed = removed + 1
      }
    }
    return new DiffStats(added, removed, unchanged)
  }

  // Group ops into hunks with `ctx` context lines on each side.
  static def hunks(ops: List[DiffOp], ctx: Int): List[Hunk] {
    val hs: List[Hunk] = []
    val n: Int = ops.size
    if n == 0 { return hs }

    // Collect positions of all changed ops.
    val cpos: List[Int] = []
    foreach ci: Int in 0..<n {
      if ops[ci].isChange() { cpos.add(ci) }
    }
    if cpos.size == 0 { return hs }

    // Build span ranges (merged by ctx).
    val spans: List[Int[]] = []
    var lo: Int = cpos[0] - ctx
    if lo < 0 { lo = 0 }
    var hi2: Int = cpos[0] + ctx
    if hi2 >= n { hi2 = n - 1 }
    foreach si: Int in 1..<cpos.size {
      val pos: Int = cpos[si]
      var nlo: Int = pos - ctx
      if nlo < 0 { nlo = 0 }
      var nhi: Int = pos + ctx
      if nhi >= n { nhi = n - 1 }
      if nlo <= hi2 + 1 {
        if nhi > hi2 { hi2 = nhi }
      } else {
        val sp: Int[] = new Int[2]; sp[0] = lo; sp[1] = hi2
        spans.add(sp)
        lo = nlo; hi2 = nhi
      }
    }
    val spLast: Int[] = new Int[2]; spLast[0] = lo; spLast[1] = hi2
    spans.add(spLast)

    // Convert each span into a Hunk.
    var oldLine: Int = 1
    var newLine: Int = 1
    var opPos: Int = 0

    foreach span: Int[] in spans {
      val spanStart: Int = span[0]
      val spanEnd: Int   = span[1]

      // Advance line counters to spanStart.
      while opPos < spanStart {
        val op: DiffOp = ops[opPos]
        select op {
          case k is Keep: oldLine = oldLine + 1; newLine = newLine + 1
          case d is Del:  oldLine = oldLine + 1
          case i is Ins:  newLine = newLine + 1
        }
        opPos = opPos + 1
      }

      val hops: List[DiffOp] = []
      var oldLen: Int = 0; var newLen: Int = 0
      val hOldStart: Int = oldLine; val hNewStart: Int = newLine
      foreach hi: Int in spanStart..spanEnd {
        val op: DiffOp = ops[hi]
        hops.add(op)
        select op {
          case k is Keep: oldLen = oldLen + 1; newLen = newLen + 1
          case d is Del:  oldLen = oldLen + 1
          case i is Ins:  newLen = newLen + 1
        }
      }
      opPos = spanEnd + 1
      oldLine = hOldStart + oldLen; newLine = hNewStart + newLen
      hs.add(new Hunk(hOldStart, oldLen, hNewStart, newLen, hops))
    }
    return hs
  }

  // Print a unified diff to stdout.
  static def printDiff(aName: String, bName: String, ops: List[DiffOp], ctx: Int): void {
    val hs: List[Hunk] = hunks(ops, ctx)
    if hs.size == 0 { IO::println("(files identical)"); return }
    IO::println("--- #{aName}")
    IO::println("+++ #{bName}")
    foreach h: Hunk in hs {
      IO::println(h.header())
      foreach op: DiffOp in h.ops() {
        IO::println("#{op.sign()} #{op.content()}")
      }
    }
  }
}

// ── helpers ───────────────────────────────────────────────────────────────────

def runCase(title: String, aName: String, bName: String, aText: String, bText: String): void {
  IO::println("\n━━━ #{title} ━━━")
  val ops: List[DiffOp] = DiffEngine::diff(DiffEngine::lines(aText), DiffEngine::lines(bText))
  val st: DiffStats = DiffEngine::stats(ops)
  IO::println("Stats: #{st.show()}")
  DiffEngine::printDiff(aName, bName, ops, 2)
}

// ── demo cases ────────────────────────────────────────────────────────────────

val configOld: String =
  "host = localhost\n" +
  "port = 8080\n" +
  "debug = false\n" +
  "log_level = INFO\n" +
  "timeout = 30"

val configNew: String =
  "host = localhost\n" +
  "port = 9090\n" +
  "debug = true\n" +
  "log_level = DEBUG\n" +
  "timeout = 30\n" +
  "max_connections = 100\n" +
  "retry_limit = 3"

runCase("Config update", "config.old", "config.new", configOld, configNew)

val codeOld: String =
  "class Calculator {\n" +
  "  def add(a, b) {\n" +
  "    return a + b\n" +
  "  }\n" +
  "  def subtract(a, b) {\n" +
  "    return a - b\n" +
  "  }\n" +
  "  def multiply(a, b) {\n" +
  "    return a * b\n" +
  "  }\n" +
  "}"

val codeNew: String =
  "class Calculator {\n" +
  "  def add(a: Double, b: Double): Double {\n" +
  "    return a + b\n" +
  "  }\n" +
  "  def subtract(a: Double, b: Double): Double {\n" +
  "    return a - b\n" +
  "  }\n" +
  "  def multiply(a: Double, b: Double): Double {\n" +
  "    return a * b\n" +
  "  }\n" +
  "  def divide(a: Double, b: Double): Double {\n" +
  "    if b == 0.0 { throw new ArithmeticException(\"division by zero\") }\n" +
  "    return a / b\n" +
  "  }\n" +
  "}"

runCase("Add types + new method", "Calculator.old", "Calculator.new", codeOld, codeNew)

val poemOld: String =
  "Roses are red,\n" +
  "Violets are blue,\n" +
  "Sugar is sweet,\n" +
  "And so are you.\n" +
  "The sun shines bright\n" +
  "On a summer day,\n" +
  "And everything\n" +
  "Seems okay."

val poemNew: String =
  "Roses are crimson,\n" +
  "Violets are blue,\n" +
  "Honey is sweeter,\n" +
  "And so are you.\n" +
  "The moon glows soft\n" +
  "On a winter night,\n" +
  "And everything\n" +
  "Will be alright."

runCase("Poem revision", "poem.v1", "poem.v2", poemOld, poemNew)

// ── inline word-level diff helper ────────────────────────────────────────────

def wordDiff(a: String, b: String): String {
  val aw: List[String] = Strings::split(a, " ")
  val bw: List[String] = Strings::split(b, " ")
  val ops: List[DiffOp] = DiffEngine::diff(aw, bw)
  var result: String = ""
  foreach op: DiffOp in ops {
    select op {
      case k is Keep: result = result + k.line() + " "
      case i is Ins:  result = result + "[+#{i.line()}] "
      case d is Del:  result = result + "[-#{d.line()}] "
    }
  }
  return result.trim()
}

IO::println("\n━━━ Inline word diff ━━━")
IO::println(wordDiff("The quick brown fox", "The slow red fox"))
IO::println(wordDiff("sugar is sweet", "honey is sweeter"))

// ── identical files ───────────────────────────────────────────────────────────

val emptyOps: List[DiffOp] = DiffEngine::diff(DiffEngine::lines("same\nlines\nhere"),
                                               DiffEngine::lines("same\nlines\nhere"))
IO::println("\n━━━ Identical files ━━━")
DiffEngine::printDiff("file.a", "file.b", emptyOps, 2)

// ── summary ───────────────────────────────────────────────────────────────────

IO::println("\n━━━ All diffs summary ━━━")
val cases: List[List[String]] = [
  ["Config update",        configOld, configNew],
  ["Calculator refactor",  codeOld,   codeNew],
  ["Poem revision",        poemOld,   poemNew]
]
foreach row: List[String] in cases {
  val title: String = row[0]
  val src: String   = row[1]
  val dst: String   = row[2]
  val ops: List[DiffOp] = DiffEngine::diff(DiffEngine::lines(src), DiffEngine::lines(dst))
  val st: DiffStats = DiffEngine::stats(ops)
  val pct: Int = if st.removed() + st.added() == 0 { 0 } else {
    (st.added() + st.removed()) * 100 / (st.unchanged() + st.added() + st.removed())
  }
  IO::println("  #{title}: #{st.show()} (#{pct}% changed)")
}

IO::println("\ndone.")
