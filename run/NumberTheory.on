// NumberTheory.on — comprehensive number-theory toolkit
// Exercises: records with static factories + operator overloading, sealed ADT
// enum, top-level recursive functions, classes, collection pipelines
// (map/filter/fold/sortedBy/find/any/count/distinct), foreach on ranges,
// while loops, select / type-pattern matching, nullable, string interpolation.

// ─── Core integer functions ────────────────────────────────────────────────

def gcd(a: Int, b: Int): Int = if b == 0 { a } else { gcd(b, a % b) }

def lcm(a: Int, b: Int): Int = a / gcd(a, b) * b

// ─── Extended GCD ──────────────────────────────────────────────────────────

record ExtGcd(g: Int, s: Int, t: Int) {
public:
  override def toString(): String = "gcd=#{g()}, s=#{s()}, t=#{t()}"
}

def extGcd(a: Int, b: Int): ExtGcd {
  if b == 0 { return new ExtGcd(a, 1, 0) }
  val r = extGcd(b, a % b)
  return new ExtGcd(r.g(), r.t(), r.s() - (a / b) * r.t())
}

// Modular inverse of a mod m (null if gcd(a,m) != 1)
def modInverse(a: Int, m: Int): Int? {
  val r = extGcd(a % m, m)
  if r.g() != 1 { return null }
  val inv: Int = r.s() % m
  return if inv < 0 { inv + m } else { inv }
}

// ─── Sieve of Eratosthenes ──────────────────────────────────────────────────

def sieve(n: Int): List[Int] {
  val composite = new Boolean[n + 1]
  val primes: List[Int] = []
  var p: Int = 2
  while p <= n {
    if !composite[p] {
      primes.add(p)
      var m: Int = p * 2
      while m <= n {
        composite[m] = true
        m = m + p
      }
    }
    p = p + 1
  }
  return primes
}

// ─── Prime factorization ────────────────────────────────────────────────────

def factorize(n: Int): List[Int] {
  val factors: List[Int] = []
  var rem: Int = n
  var d: Int = 2
  while d * d <= rem {
    while rem % d == 0 {
      factors.add(d)
      rem = rem / d
    }
    d = d + 1
  }
  if rem > 1 { factors.add(rem) }
  return factors
}

// ─── NumberClass: sealed classification of a positive integer ───────────────

enum NumberClass {
  case IsZero
  case IsUnit
  case IsPrime
  case IsComposite(factors: List[Int])
public:
  def label(): String = select this {
    case z is IsZero:          "zero"
    case u is IsUnit:          "unit"
    case p is IsPrime:         "prime"
    case c is IsComposite:     "composite #{c.factors()}"
  }
}

def classify(n: Int): NumberClass {
  if n == 0 { return new IsZero() }
  if n == 1 { return new IsUnit() }
  val f = factorize(n)
  if f.size == 1 { return new IsPrime() }
  return new IsComposite(f)
}

// ─── Divisors and totient ───────────────────────────────────────────────────

def divisors(n: Int): List[Int] {
  val divs: List[Int] = []
  var i: Int = 1
  while i * i <= n {
    if n % i == 0 {
      divs.add(i)
      if i != n / i { divs.add(n / i) }
    }
    i = i + 1
  }
  return divs.sortedBy { d -> d as Int }
}

// Euler's totient φ(n)
def totient(n: Int): Int {
  var result: Int = n
  var m: Int = n
  var p: Int = 2
  while p * p <= m {
    if m % p == 0 {
      while m % p == 0 { m = m / p }
      result = result - result / p
    }
    p = p + 1
  }
  if m > 1 { result = result - result / m }
  return result
}

// ─── Fraction — irreducible rational number ─────────────────────────────────

record Fraction(num: Int, den: Int) {
public:
  static def of(n: Int, d: Int): Fraction {
    if d == 0 { throw new IllegalArgumentException("denominator zero") }
    val g: Int = gcd(if n < 0 { 0 - n } else { n }, if d < 0 { 0 - d } else { d })
    val sign: Int = if d < 0 { 0 - 1 } else { 1 }
    return new Fraction(sign * n / g, sign * d / g)
  }
  def plus(o: Fraction): Fraction  = Fraction::of(num * o.den() + o.num() * den, den * o.den())
  def minus(o: Fraction): Fraction = Fraction::of(num * o.den() - o.num() * den, den * o.den())
  def times(o: Fraction): Fraction = Fraction::of(num * o.num(), den * o.den())
  def div(o: Fraction): Fraction   = Fraction::of(num * o.den(), den * o.num())
  def toDouble(): Double           = (num as Double) / den
  override def toString(): String  = if den == 1 { "" + num } else { "#{num()}/#{den()}" }
}

// ─── ModRing — arithmetic modulo m ─────────────────────────────────────────

class ModRing {
  val m: Int
public:
  def this(modulus: Int) { this.m = modulus }
  def add(a: Int, b: Int): Int = ((a + b) % m + m) % m
  def sub(a: Int, b: Int): Int = ((a - b) % m + m) % m
  def mul(a: Int, b: Int): Int = (((a as Long) * (b as Long)) % (m as Long)) as Int
  def pow(base: Int, exp: Int): Int {
    var result: Int = 1
    var bb: Int = base % m
    var e: Int = exp
    while e > 0 {
      if e % 2 == 1 { result = mul(result, bb) }
      bb = mul(bb, bb)
      e = e / 2
    }
    return result
  }
  def inv(a: Int): Int? = modInverse(a, m)
}

// ─── Chinese Remainder Theorem ──────────────────────────────────────────────

// Given residues[i] ≡ r_i (mod m_i) with pairwise coprime m_i, find x in [0, M)
// where M = product of all m_i.
def crt(residues: List[Int], moduli: List[Int]): Int {
  var M: Int = 1
  foreach mi: Int in moduli { M = M * (mi as Int) }
  var x: Int = 0
  foreach i: Int in 0..<residues.size {
    val mi: Int = moduli[i] as Int
    val ri: Int = residues[i] as Int
    val Mi: Int = M / mi
    val inv: Int? = modInverse(Mi, mi)
    if inv == null { throw new IllegalArgumentException("moduli not coprime") }
    x = (x + ri * Mi * (inv as Int)) % M
  }
  return (x % M + M) % M
}

// ─── Demo ───────────────────────────────────────────────────────────────────

// gcd / lcm / extGcd
IO::println("gcd(48,18)=#{gcd(48,18)}  lcm=#{lcm(48,18)}")
val eg = extGcd(35, 15)
IO::println("extGcd(35,15): #{eg}  check: 35*#{eg.s()}+15*#{eg.t()}=#{35*eg.s()+15*eg.t()}")

// primes up to 50
val ps = sieve(50)
IO::println("primes≤50: #{ps}")
IO::println("count=#{ps.size}  sum=#{ps.fold(0) { a, p -> (a as Int) + (p as Int) }}")

// factorize
val nums = [12, 360, 97, 100, 1024]
foreach n: Int in nums {
  val cls = classify(n)
  IO::println("  #{n} → #{cls.label()}")
}

// divisors + totient
foreach n: Int in [6, 12, 30] {
  val d = divisors(n)
  IO::println("  divisors(#{n})=#{d}  σ=#{d.fold(0){a,x->(a as Int)+(x as Int)}}  φ=#{totient(n)}")
}

// Fractions
val a = Fraction::of(1, 3)
val b = Fraction::of(1, 6)
IO::println("1/3 + 1/6 = #{a + b}")
IO::println("1/3 * 1/6 = #{a * b}")
IO::println("1/3 / 1/6 = #{a / b}")
IO::println("as double: #{(a + b).toDouble()}")

// ModRing
val ring = new ModRing(13)
IO::println("ModRing(13): 7^10 mod 13 = #{ring.pow(7,10)}")
IO::println("inv(7,13) = #{modInverse(7,13)}")

// CRT: x≡2(mod3), x≡3(mod5), x≡2(mod7)  → expected 23
val x = crt([2, 3, 2], [3, 5, 7])
IO::println("CRT([2,3,2],[3,5,7]) = #{x}")

// top-10 totients
val totients = sieve(30).map { p -> totient(p as Int) }
IO::println("φ of primes≤30: #{totients}")
