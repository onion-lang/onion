// ── weekly plan ────────────────────────────────────────────────────────────

def buildWeeklyPlan(): List[ScheduledMeal] = {
  val days: List[String] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
  val breakfasts: List[Dish] = [oatmeal(), scrambledEggs(), oatmeal(), scrambledEggs(), oatmeal(), scrambledEggs(), oatmeal()]
  val lunches: List[Dish]    = [chickenWrap(), greekSalad(), chickenWrap(), greekSalad(), chickenWrap(), greekSalad(), chickenWrap()]
  val snacks: List[Dish]     = [yogurtParfait(), almondMix(), yogurtParfait(), almondMix(), yogurtParfait(), almondMix(), yogurtParfait()]
  val dinners: List[Dish]    = [salmonRiceBowl(), lentilSoup(), beefStirFry(), veggiePasta(), salmonRiceBowl(), lentilSoup(), beefStirFry()]
  val plan: List[ScheduledMeal] = []
  foreach i: Int in 0..<7 {
    val day: String = days[i] as String
    plan.add(new ScheduledMeal(day, breakfasts[i] as Dish))
    plan.add(new ScheduledMeal(day, lunches[i]    as Dish))
    plan.add(new ScheduledMeal(day, snacks[i]     as Dish))
    plan.add(new ScheduledMeal(day, dinners[i]    as Dish))
  }
  plan
}

// ── analysis helpers ───────────────────────────────────────────────────────

def profileForDay(meals: List[ScheduledMeal], day: String): NutritionalProfile = {
  var cal: Double  = 0.0
  var pro: Double  = 0.0
  var carb: Double = 0.0
  var fat: Double  = 0.0
  foreach m: ScheduledMeal in meals {
    if m.day == day {
      val np: NutritionalProfile = m.dish.nutritionPerServing()
      cal  = cal  + np.calories
      pro  = pro  + np.protein
      carb = carb + np.carbs
      fat  = fat  + np.fat
    }
  }
  new NutritionalProfile(cal, pro, carb, fat)
}

def totalWeekProfile(meals: List[ScheduledMeal]): NutritionalProfile = {
  var cal: Double  = 0.0
  var pro: Double  = 0.0
  var carb: Double = 0.0
  var fat: Double  = 0.0
  foreach m: ScheduledMeal in meals {
    val np: NutritionalProfile = m.dish.nutritionPerServing()
    cal  = cal  + np.calories
    pro  = pro  + np.protein
    carb = carb + np.carbs
    fat  = fat  + np.fat
  }
  new NutritionalProfile(cal, pro, carb, fat)
}

def printDailyBreakdown(meals: List[ScheduledMeal]): void {
  val days: List[String] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
  println("Day | Calories | Protein | Carbs | Fat")
  println("----+----------+---------+-------+------")
  foreach day: String in days {
    val p: NutritionalProfile = profileForDay(meals, day)
    println("#{day} | #{p.calories.intValue()} kcal   | #{p.protein.intValue()}g     | #{p.carbs.intValue()}g   | #{p.fat.intValue()}g")
  }
}

def dishesWithTag(meals: List[ScheduledMeal], tag: DietTag): List[String] = {
  val result: List[String] = []
  foreach m: ScheduledMeal in meals {
    if m.dish.hasTag(tag) {
      val lbl: String = m.dish.name
      if result.indexOf(lbl) < 0 { result.add(lbl) }
    }
  }
  result
}

def quickDishes(meals: List[ScheduledMeal]): List[String] = {
  val seen: List[String] = []
  foreach m: ScheduledMeal in meals {
    val name: String = m.dish.name
    if m.dish.isQuick() && seen.indexOf(name) < 0 { seen.add(name) }
  }
  seen
}

def printCalorieBar(label: String, cal: Int): void {
  val bars: Int = cal / 100
  var bar: String = ""
  foreach i: Int in 0..<bars { bar = bar + "▓" }
  val pad: String = if label.length < 12 {
    var s: String = label
    foreach j: Int in label.length..<12 { s = s + " " }
    s
  } else {
    label.substring(0, 12)
  }
  println("#{pad} #{bar} #{cal}")
}

// ── main ───────────────────────────────────────────────────────────────────

def main(): void {
  println("╔══════════════════════════════════════════════════════════╗")
  println("║              WEEKLY MEAL PLANNER                        ║")
  println("║     Nutritional analysis for a 7-day plan               ║")
  println("╚══════════════════════════════════════════════════════════╝")
  println("")

  val plan: List[ScheduledMeal] = buildWeeklyPlan()
  println("Plan built: #{plan.size} meals across 7 days")
  println("")

  // Print Monday's menu
  println("═══ MONDAY MENU ═══")
  foreach m: ScheduledMeal in plan {
    if m.day == "Mon" {
      val np: NutritionalProfile = m.dish.nutritionPerServing()
      println("  #{m.dish.mealType.label()}: #{m.dish.name}")
      println("    └─ #{np.summary()}#{if m.dish.isQuick() { "  ⚡quick" } else { "" }}")
    }
  }
  println("")

  // Daily nutritional breakdown
  println("═══ DAILY NUTRITIONAL BREAKDOWN ═══")
  printDailyBreakdown(plan)
  println("")

  // Weekly totals
  val weekTotal: NutritionalProfile = totalWeekProfile(plan)
  val avgPerDay: NutritionalProfile = weekTotal.perServing(7)
  println("═══ WEEKLY TOTALS ═══")
  println("Total  : #{weekTotal.summary()}")
  println("Daily avg: #{avgPerDay.summary()}")
  println("")

  // Calorie bar chart per day
  println("═══ DAILY CALORIE BAR CHART (each ▓ = 100 kcal) ═══")
  val days2: List[String] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
  foreach day: String in days2 {
    val p: NutritionalProfile = profileForDay(plan, day)
    printCalorieBar(day, p.calories.intValue())
  }
  println("")

  // Tag analysis
  println("═══ VEGETARIAN DISHES ═══")
  val vegDishes: List[String] = dishesWithTag(plan, new Vegetarian())
  foreach d: String in vegDishes { println("  • #{d}") }
  println("")

  println("═══ HIGH-PROTEIN DISHES ═══")
  val hiProtDishes: List[String] = dishesWithTag(plan, new HighProtein())
  foreach d: String in hiProtDishes { println("  • #{d}") }
  println("")

  println("═══ QUICK DISHES (≤15 min) ═══")
  val quick: List[String] = quickDishes(plan)
  foreach d: String in quick { println("  • #{d}") }
  println("")

  // Unique dishes summary
  val seen: List[String] = []
  foreach m: ScheduledMeal in plan {
    val name: String = m.dish.name
    if seen.indexOf(name) < 0 { seen.add(name) }
  }
  println("═══ ALL UNIQUE DISHES (#{seen.size} total) ═══")
  foreach name: String in seen {
    // find the dish
    var cal: Int = 0
    foreach m: ScheduledMeal in plan {
      if m.dish.name == name && cal == 0 {
        cal = m.dish.caloriesPerServing().intValue()
      }
    }
    println("  #{name}: #{cal} kcal/serving")
  }
  println("")

  println("Done. Have a healthy week!")
}
