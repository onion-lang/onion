// MealPlanner.on — weekly meal planning with nutritional budgets
// Exercises: records, ADT enums, collection pipelines (map/filter/sortedBy/groupBy),
//            pattern matching with is-patterns, string interpolation,
//            foreach with ranges, nullable fields, method bodies in records,
//            extension methods, and select-based dispatch

record Ingredient(name: String, grams: Double, caloriesPer100g: Double,
                  proteinPer100g: Double, carbsPer100g: Double, fatPer100g: Double) {
public:
  def calories(): Double = grams * caloriesPer100g / 100.0
  def protein(): Double  = grams * proteinPer100g  / 100.0
  def carbs(): Double    = grams * carbsPer100g    / 100.0
  def fat(): Double      = grams * fatPer100g      / 100.0
  def scale(f: Double): Ingredient =
    new Ingredient(name, grams * f, caloriesPer100g, proteinPer100g, carbsPer100g, fatPer100g)
}

record NutritionalProfile(calories: Double, protein: Double, carbs: Double, fat: Double) {
public:
  def plus(other: NutritionalProfile): NutritionalProfile =
    new NutritionalProfile(calories + other.calories, protein + other.protein,
                           carbs   + other.carbs,    fat    + other.fat)
  def perServing(n: Int): NutritionalProfile =
    new NutritionalProfile(calories / n.doubleValue(), protein / n.doubleValue(),
                           carbs    / n.doubleValue(), fat     / n.doubleValue())
  def summary(): String =
    "#{calories.intValue()} kcal | P #{protein.intValue()}g | C #{carbs.intValue()}g | F #{fat.intValue()}g"
}

enum MealType {
  case Breakfast
  case Lunch
  case Dinner
  case Snack
public:
  def label(): String = select this {
    case t is Breakfast: "Breakfast"
    case t is Lunch:     "Lunch"
    case t is Dinner:    "Dinner"
    case t is Snack:     "Snack"
  }
  def ordinal(): Int = select this {
    case t is Breakfast: 0
    case t is Lunch:     1
    case t is Snack:     2
    case t is Dinner:    3
  }
}

enum DietTag {
  case Vegetarian
  case Vegan
  case GlutenFree
  case HighProtein
  case LowCarb
public:
  def label(): String = select this {
    case t is Vegetarian: "Vegetarian"
    case t is Vegan:      "Vegan"
    case t is GlutenFree: "Gluten-Free"
    case t is HighProtein:"High-Protein"
    case t is LowCarb:    "Low-Carb"
  }
}

record Dish(name: String, servings: Int, ingredients: List[Ingredient],
            mealType: MealType, tags: List[DietTag], prepMinutes: Int) {
public:
  def nutritionTotal(): NutritionalProfile = {
    var cal: Double  = 0.0
    var pro: Double  = 0.0
    var carb: Double = 0.0
    var fat: Double  = 0.0
    foreach ing: Ingredient in ingredients {
      cal  = cal  + ing.calories()
      pro  = pro  + ing.protein()
      carb = carb + ing.carbs()
      fat  = fat  + ing.fat()
    }
    new NutritionalProfile(cal, pro, carb, fat)
  }
  def nutritionPerServing(): NutritionalProfile = nutritionTotal().perServing(servings)
  def isQuick(): Boolean = prepMinutes <= 15
  def hasTag(tag: DietTag): Boolean = {
    var found: Boolean = false
    foreach t: DietTag in tags { if t.label() == tag.label() { found = true } }
    found
  }
  def caloriesPerServing(): Double = nutritionPerServing().calories
  def label(): String =
    "#{name} (#{mealType.label()}, #{prepMinutes}min, #{nutritionPerServing().calories.intValue()} kcal/srv)"
}

record ScheduledMeal(day: String, dish: Dish) {
public:
  def summary(): String = "#{day} #{dish.mealType.label()}: #{dish.name}"
}

// ── ingredient helpers ─────────────────────────────────────────────────────

def ing(name: String, g: Double, cal: Double, pro: Double, carb: Double, fat: Double): Ingredient =
  new Ingredient(name, g, cal, pro, carb, fat)

