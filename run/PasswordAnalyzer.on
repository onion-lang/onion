// PasswordAnalyzer — demonstrates ADT enums, extension methods on String/Int,
// sealed hierarchies, collection pipelines, pattern matching with guards,
// generics, records, interfaces, and recursive analysis.

// === Strength level enum (data-carrying) ===
enum Strength(label: String, score: Int) {
  VERY_WEAK("Very Weak", 0),
  WEAK("Weak", 1),
  FAIR("Fair", 2),
  STRONG("Strong", 3),
  VERY_STRONG("Very Strong", 4)
}

// === ADT for security rule violations ===
enum RuleViolation {
  case TooShort(minLen: Int, actualLen: Int)
  case MissingUppercase
  case MissingLowercase
  case MissingDigit
  case MissingSpecial
  case TooManyRepeated(count: Int)
  case CommonPassword(pattern: String)
}

// === Analysis result record ===
record AnalysisResult(password: String, violations: List[RuleViolation], score: Int, strength: Strength)

// === Extension methods on String for password analysis ===
extension String {
  def hasUppercase(): Boolean {
    foreach i: Int in 0..<self.length() {
      val ch: Int = self.charAt(i)
      if ch >= 65 && ch <= 90 { return true }
    }
    return false
  }

  def hasLowercase(): Boolean {
    foreach i: Int in 0..<self.length() {
      val ch: Int = self.charAt(i)
      if ch >= 97 && ch <= 122 { return true }
    }
    return false
  }

  def hasDigit(): Boolean {
    foreach i: Int in 0..<self.length() {
      val ch: Int = self.charAt(i)
      if ch >= 48 && ch <= 57 { return true }
    }
    return false
  }

  def hasSpecial(): Boolean {
    val specials: String = "!@#$%^&*()_+-=[]{}|;':\",./<>?"
    foreach i: Int in 0..<self.length() {
      val s: String = self.substring(i, i + 1)
      if specials.contains(s) { return true }
    }
    return false
  }

  def maxRunLength(): Int {
    if self.length() == 0 { return 0 }
    var maxRun: Int = 1
    var curRun: Int = 1
    foreach i: Int in 1..<self.length() {
      if self.charAt(i) == self.charAt(i - 1) {
        curRun = curRun + 1
        if curRun > maxRun { maxRun = curRun }
      } else {
        curRun = 1
      }
    }
    return maxRun
  }
}

// === Extension methods on Int ===
extension Int {
  def clampTo(lo: Int, hi: Int): Int =
    if self < lo { lo } else if self > hi { hi } else { self }
  def squared(): Int = self * self
}

// === Common weak passwords ===
val commonPasswords: List[String] = [
  "password", "123456", "qwerty", "abc123", "letmein",
  "monkey", "master", "dragon", "shadow", "sunshine"
]

// === Check a password and collect violations ===
def checkPassword(pwd: String): List[RuleViolation] {
  val violations: List[RuleViolation] = []

  val len: Int = pwd.length()
  if len < 8 {
    violations.add(new TooShort(8, len))
  }

  if !pwd.hasUppercase() { violations.add(new MissingUppercase()) }
  if !pwd.hasLowercase() { violations.add(new MissingLowercase()) }
  if !pwd.hasDigit()     { violations.add(new MissingDigit())     }
  if !pwd.hasSpecial()   { violations.add(new MissingSpecial())   }

  val maxRun: Int = pwd.maxRunLength()
  if maxRun >= 3 {
    violations.add(new TooManyRepeated(maxRun))
  }

  val lower: String = pwd.toLowerCase()
  val found = commonPasswords.find { cp -> (cp as String) == lower }
  if found != null {
    violations.add(new CommonPassword(lower))
  }

  return violations
}

// === Score a password (0..100) ===
def scorePassword(pwd: String, violations: List[RuleViolation]): Int {
  var score: Int = 0

  val len: Int = pwd.length()
  if len >= 8  { score = score + 10 }
  if len >= 12 { score = score + 10 }
  if len >= 16 { score = score + 10 }
  if len >= 20 { score = score + 10 }

  if pwd.hasUppercase() { score = score + 10 }
  if pwd.hasLowercase() { score = score + 10 }
  if pwd.hasDigit()     { score = score + 10 }
  if pwd.hasSpecial()   { score = score + 15 }

  score = score - violations.size * 5
  return score.clampTo(0, 100)
}

// === Classify score to strength ===
def classify(score: Int): Strength =
  if score <= 20 { Strength::VERY_WEAK }
  else if score <= 40 { Strength::WEAK }
  else if score <= 60 { Strength::FAIR }
  else if score <= 80 { Strength::STRONG }
  else { Strength::VERY_STRONG }

// === Describe a violation (ADT pattern matching) ===
def describeViolation(v: RuleViolation): String =
  select v {
    case ts is TooShort:
      "Too short: need #{ts.minLen()} chars, got #{ts.actualLen()}"
    case mu is MissingUppercase:
      "Missing uppercase letter"
    case ml is MissingLowercase:
      "Missing lowercase letter"
    case md is MissingDigit:
      "Missing digit"
    case ms is MissingSpecial:
      "Missing special character"
    case tr is TooManyRepeated:
      "Too many repeated chars: run of #{tr.count()}"
    case cp is CommonPassword:
      "Common password: '#{cp.pattern()}'"
  }

// === Analyze one password ===
def analyze(pwd: String): AnalysisResult {
  val violations: List[RuleViolation] = checkPassword(pwd)
  val score: Int = scorePassword(pwd, violations)
  val strength: Strength = classify(score)
  return new AnalysisResult(pwd, violations, score, strength)
}

// === Print one report ===
def printReport(result: AnalysisResult): void {
  val pwd: String = result.password()
  val hidden: String = if pwd.length() >= 2 { pwd.substring(0, 2) + "***" } else { "***" }
  IO::println("--- #{hidden} ---")
  IO::println("  Score:    #{result.score()}/100")
  IO::println("  Strength: #{result.strength().label()}")

  val viols: List[RuleViolation] = result.violations()
  if viols.size == 0 {
    IO::println("  Issues:   none")
  } else {
    IO::println("  Issues:")
    foreach v: RuleViolation in viols {
      IO::println("    - #{describeViolation(v)}")
    }
  }
}

// === Batch analysis ===
def batchReport(passwords: List[String]): void {
  IO::println("=== Password Strength Batch Report ===")

  val results: List[AnalysisResult] = passwords.map { pwd -> analyze(pwd as String) }

  foreach r: AnalysisResult in results {
    printReport(r)
  }

  IO::println("")
  IO::println("=== Summary by Strength Level ===")
  val byStrength = results.groupBy { r -> (r as AnalysisResult).strength().label() }
  foreach (level, group) in byStrength {
    IO::println("  #{level}: #{(group as List).size} password(s)")
  }

  IO::println("")
  val total: Int = results.fold(0) { acc, r ->
    (acc as Int) + (r as AnalysisResult).score()
  } as Int
  val avg: Int = total / results.size
  IO::println("Average score: #{avg}/100")

  val strongCount: Int = results.filter { r ->
    (r as AnalysisResult).score() > 60
  }.size
  IO::println("Strong passwords (>60): #{strongCount}/#{results.size}")

  val topResult = results.sortedBy { r -> 0 - (r as AnalysisResult).score() }.get(0) as AnalysisResult
  IO::println("Best password: #{topResult.password().substring(0, 2)}*** (#{topResult.score()}/100)")
}

// === Recursive entropy estimator ===
def charsetSize(pwd: String): Int {
  var cs: Int = 0
  if pwd.hasLowercase() { cs = cs + 26 }
  if pwd.hasUppercase() { cs = cs + 26 }
  if pwd.hasDigit()     { cs = cs + 10 }
  if pwd.hasSpecial()   { cs = cs + 32 }
  if cs == 0 { cs = 26 }
  return cs
}

def log2Floor(n: Int): Int {
  if n <= 1 { return 0 }
  return 1 + log2Floor(n / 2)
}

def estimateBits(pwd: String): Int =
  pwd.length() * log2Floor(charsetSize(pwd))

// === Demo ===
val testPasswords: List[String] = [
  "abc",
  "password",
  "Hello123",
  "Tr0ub4dor&3",
  "correcthorsebatterystaple",
  "X!9kQm#2vLpR",
  "aaaaaaa",
  "MyP@ssw0rd!2024"
]

batchReport(testPasswords)

IO::println("")
IO::println("=== Entropy Estimates ===")
foreach pwd: String in testPasswords {
  val bits: Int = estimateBits(pwd)
  IO::println("  #{pwd.substring(0, 3)}... -> ~#{bits} bits of entropy")
}

IO::println("")
IO::println("=== Extension Method Demo ===")
val x: Int = 42
IO::println("42.squared() = #{x.squared()}")
IO::println("150.clampTo(0,100) = #{(150).clampTo(0, 100)}")
IO::println("(-5).clampTo(0,100) = #{(0 - 5).clampTo(0, 100)}")

// === Policy interface and classes ===
interface Policy {
  def name(): String
  def check(pwd: String): Boolean
  def advice(): String
}

class LengthPolicy(val minLen: Int) conforms Policy {
public:
  def name(): String = "MinLength(#{minLen})"
  def check(pwd: String): Boolean = pwd.length() >= minLen
  def advice(): String = "Use at least #{minLen} characters"
}

class DiversityPolicy conforms Policy {
public:
  def this {}
  def name(): String = "Diversity"
  def check(pwd: String): Boolean =
    pwd.hasUppercase() && pwd.hasLowercase() && pwd.hasDigit()
  def advice(): String = "Mix uppercase, lowercase, and digits"
}

class SpecialCharPolicy conforms Policy {
public:
  def this {}
  def name(): String = "SpecialChar"
  def check(pwd: String): Boolean = pwd.hasSpecial()
  def advice(): String = "Include at least one special character (!@#$...)"
}

def applyPolicies(pwd: String, policies: List[Policy]): void {
  IO::println("Checking '#{pwd.substring(0, 2)}...' against #{policies.size} policies:")
  var passed: Int = 0
  foreach p: Policy in policies {
    val ok: Boolean = p.check(pwd)
    if ok { passed = passed + 1 }
    val status: String = if ok { "PASS" } else { "FAIL" }
    IO::println("  [#{status}] #{p.name()}" + (if !ok { " -> #{p.advice()}" } else { "" }))
  }
  IO::println("  Result: #{passed}/#{policies.size} policies passed")
}

IO::println("")
IO::println("=== Policy Checks ===")
val policies: List[Policy] = [new LengthPolicy(12), new DiversityPolicy(), new SpecialCharPolicy()]
applyPolicies("Hello123", policies)
applyPolicies("Tr0ub4dor&3", policies)
applyPolicies("MyP@ssw0rd!2024", policies)

// === while loop: brute-force count unique chars ===
def uniqueCharCount(pwd: String): Int {
  val seen: List[Int] = []
  var i: Int = 0
  while i < pwd.length() {
    val c: Int = pwd.charAt(i)
    val already = seen.find { s -> (s as Int) == c }
    if already == null { seen.add(c) }
    i = i + 1
  }
  return seen.size
}

IO::println("")
IO::println("=== Unique Character Counts ===")
foreach pwd: String in testPasswords {
  IO::println("  #{pwd.substring(0, 3)}...: #{uniqueCharCount(pwd)} unique chars")
}

// === try/catch: safe password analysis ===
def safeAnalyze(pwd: String): String {
  try {
    val r: AnalysisResult = analyze(pwd)
    return "#{r.strength().label()} (#{r.score()}/100)"
  } catch e: Exception {
    return "error: #{e.message()}"
  }
}

IO::println("")
IO::println("=== Safe Analysis ===")
IO::println("  Tr0ub4dor&3: " + safeAnalyze("Tr0ub4dor&3"))
IO::println("  empty:       " + safeAnalyze(""))
IO::println("  short:       " + safeAnalyze("ab"))
