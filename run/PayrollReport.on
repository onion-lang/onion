// PayrollReport.on — employee payroll report exercising ADT enums, interfaces,
// class-method bodies, partition, zip, any/all/count, distinct, flatMap, recursive
// projections, extension methods, map iteration, and exhaustive select patterns.

// --- Homogeneous enums (Java-backed) ---
enum Department { ENG, SALES, HR, OPS }
enum Level { JUNIOR, MID, SENIOR, LEAD }

// --- ADT enum: heterogeneous contract types ---
enum ContractType {
  case Permanent(monthlyBase: Int)
  case Hourly(ratePerHour: Int, hoursPerMonth: Int)
  case Freelance(projectFee: Int)
}

// --- Records ---
record Employee(id: Int, name: String, dept: Department, level: Level, contract: ContractType)

// --- Interface ---
interface PayrollItem {
  def monthlyCost(): Int
  def annualCost(): Int
  def describe(): String
}

// --- Class implementing interface ---
class EmployeePayroll conforms PayrollItem {
  val _emp: Employee
public:
  def this(e: Employee) { this._emp = e }
  def emp(): Employee = _emp

  def monthlyCost(): Int = select _emp.contract() {
    case c is Permanent: c.monthlyBase()
    case c is Hourly:   c.ratePerHour() * c.hoursPerMonth()
    case c is Freelance: c.projectFee()
  }

  def annualCost(): Int = monthlyCost() * 12

  def describe(): String {
    val cost = monthlyCost()
    return "#{_emp.name()} [#{_emp.dept()}/#{_emp.level()}]: #{cost}/mo"
  }
}

// --- Extension on Int ---
extension Int {
  def isOverBudget(budget: Int): Boolean = self > budget
}

// --- Helper functions ---
def sharePct(part: Int, total: Int): Int {
  if total == 0 { return 0 }
  return part * 100 / total
}

// --- Extension on String ---
extension String {
  def padEnd(width: Int): String {
    var s = self
    while s.length() < width { s = s + " " }
    return s
  }
}

// --- Recursive salary projection (n annual raises at pct%) ---
def withRaises(base: Int, pct: Int, years: Int): Int {
  if years <= 0 { return base }
  val raised = base + base * pct / 100
  return withRaises(raised, pct, years - 1)
}

// --- Helper: build a label for a contract type ---
def contractLabel(ct: ContractType): String = select ct {
  case p is Permanent: "permanent"
  case h is Hourly:    "hourly"
  case f is Freelance: "freelance"
}

// ======================================================================
// Payroll data
// ======================================================================
val employees: List[Employee] = [
  new Employee(1,  "Alice",  Department::ENG,   Level::SENIOR, new Permanent(600000)),
  new Employee(2,  "Bob",    Department::SALES,  Level::MID,    new Permanent(400000)),
  new Employee(3,  "Carol",  Department::HR,     Level::JUNIOR, new Permanent(280000)),
  new Employee(4,  "Dave",   Department::ENG,    Level::LEAD,   new Permanent(750000)),
  new Employee(5,  "Eve",    Department::OPS,    Level::MID,    new Hourly(2500, 160)),
  new Employee(6,  "Frank",  Department::SALES,  Level::SENIOR, new Permanent(520000)),
  new Employee(7,  "Grace",  Department::ENG,    Level::JUNIOR, new Hourly(2000, 160)),
  new Employee(8,  "Hank",   Department::HR,     Level::MID,    new Freelance(350000)),
  new Employee(9,  "Ivy",    Department::OPS,    Level::SENIOR, new Permanent(480000)),
  new Employee(10, "Jack",   Department::ENG,    Level::MID,    new Freelance(450000))
]

val payroll: List[EmployeePayroll] =
  employees.map { e -> new EmployeePayroll(e as Employee) }

// ======================================================================
// 1. Totals
// ======================================================================
val totalMonthly = payroll.fold(0) { acc, p ->
  (acc as Int) + (p as EmployeePayroll).monthlyCost()
}
val totalAnnual  = payroll.fold(0) { acc, p ->
  (acc as Int) + (p as EmployeePayroll).annualCost()
}
IO::println("=== Payroll Summary ===")
IO::println("Total monthly : " + totalMonthly)
IO::println("Total annual  : " + totalAnnual)

// ======================================================================
// 2. Employee list with describe()
// ======================================================================
IO::println("\n--- Employee List ---")
foreach p: Object in payroll {
  IO::println((p as EmployeePayroll).describe())
}

// ======================================================================
// 3. Partition: expensive (>500k/mo) vs. affordable
// ======================================================================
val parts     = payroll.partition { p -> (p as EmployeePayroll).monthlyCost() > 500000 }
val expensive = parts[0] as List
val affordable = parts[1] as List
IO::println("\nExpensive (>500k/mo) : " + expensive.size)
IO::println("Affordable           : " + affordable.size)

// ======================================================================
// 4. Group by department
// ======================================================================
IO::println("\n--- By Department ---")
val byDept = payroll.groupBy { p -> (p as EmployeePayroll).emp().dept() }
foreach (dept, members) in byDept {
  val deptCost: Int = ((members as List).fold(0) { acc, p ->
    (acc as Int) + (p as EmployeePayroll).monthlyCost()
  }) as Int
  val totalMo: Int = totalMonthly as Int
  val share = sharePct(deptCost, totalMo)
  IO::println("#{dept}: #{(members as List).size} people, #{deptCost}/mo (#{share}%)")
}

// ======================================================================
// 5. Top earner
// ======================================================================
val ranked = payroll.sortedByDescending { p -> (p as EmployeePayroll).monthlyCost() }
if ranked.size > 0 {
  val top = ranked[0] as EmployeePayroll
  IO::println("\nTop earner: #{top.emp().name()} at #{top.monthlyCost()}/mo")
}

// ======================================================================
// 6. any / all / count
// ======================================================================
val anyHighRoller = payroll.any { p -> (p as EmployeePayroll).monthlyCost() > 700000 }
val allPositive   = payroll.all { p -> (p as EmployeePayroll).monthlyCost() > 0 }
val seniorCount   = employees.count { e -> (e as Employee).level() == Level::SENIOR }
IO::println("\nAny earner >700k : " + anyHighRoller)
IO::println("All positive     : " + allPositive)
IO::println("Senior count     : " + seniorCount)

// ======================================================================
// 7. distinct departments
// ======================================================================
val depts = employees.map { e -> (e as Employee).dept() }.distinct()
IO::println("\nDistinct departments: " + depts.size)

// ======================================================================
// 8. Filter senior/lead, then map to names
// ======================================================================
val seniorNames = employees
  .filter { e -> (e as Employee).level() == Level::SENIOR || (e as Employee).level() == Level::LEAD }
  .map { e -> (e as Employee).name() }
IO::println("\nSenior/Lead : " + seniorNames.toString())

// ======================================================================
// 9. 3-year salary projection (5% raise/year, recursive)
// ======================================================================
IO::println("\n--- 3-Year Salary Projection (5% annual raise) ---")
val projections = payroll.map { p ->
  val ep   = p as EmployeePayroll
  val curr = ep.monthlyCost()
  val proj = withRaises(curr, 5, 3)
  ep.emp().name().padEnd(8) + ": " + curr + " -> " + proj
}
foreach label: Object in projections {
  IO::println(label as String)
}

// ======================================================================
// 10. Contract type breakdown
// ======================================================================
IO::println("\n--- Contract Types ---")
var permCount = 0; var hourlyCount = 0; var freelanceCount = 0
foreach e: Object in employees {
  select (e as Employee).contract() {
    case perm is Permanent: permCount      = permCount + 1
    case hour is Hourly:    hourlyCount    = hourlyCount + 1
    case free is Freelance: freelanceCount = freelanceCount + 1
  }
}
IO::println("Permanent : " + permCount)
IO::println("Hourly    : " + hourlyCount)
IO::println("Freelance : " + freelanceCount)

// ======================================================================
// 11. Engineering budget check (extension Int.isOverBudget)
// ======================================================================
val engBudget = 2000000
val engTotal: Int = (payroll
  .filter { p -> (p as EmployeePayroll).emp().dept() == Department::ENG }
  .fold(0) { acc, p -> (acc as Int) + (p as EmployeePayroll).monthlyCost() }) as Int
IO::println("\nEng monthly: #{engTotal}, budget: #{engBudget}")
IO::println("Eng over budget: " + engTotal.isOverBudget(engBudget))

// ======================================================================
// 12. zip: monthly vs. annual side-by-side for first 3 employees
// ======================================================================
IO::println("\n--- Monthly vs Annual (first 3) ---")
val first3monthly = payroll.take(3).map { p -> (p as EmployeePayroll).monthlyCost() }
val first3annual  = payroll.take(3).map { p -> (p as EmployeePayroll).annualCost() }
val zipped = first3monthly.zip(first3annual)
foreach pair: Object in zipped {
  val row = pair as List
  IO::println("monthly=" + row[0] + " annual=" + row[1])
}

// ======================================================================
// 13. try/catch: safe division for percentage share
// ======================================================================
def safePct(part: Int, total: Int): String {
  try {
    return "" + (part * 100 / total) + "%"
  } catch e: Exception {
    return "N/A"
  }
}
IO::println("\nEng share: " + safePct(engTotal, totalMonthly))
IO::println("Zero share: " + safePct(100, 0))

// ======================================================================
// 14. foreach over a range: headcount by level
// ======================================================================
IO::println("\n--- Headcount by Level ---")
val levelNames = ["JUNIOR", "MID", "SENIOR", "LEAD"]
val levelValues: List[Level] = [Level::JUNIOR, Level::MID, Level::SENIOR, Level::LEAD]
var li = 0
while li < levelValues.size {
  val lv = levelValues[li] as Level
  val c  = employees.count { e -> (e as Employee).level() == lv }
  IO::println(levelNames[li] + ": " + c)
  li = li + 1
}

// ======================================================================
// 15. flatMap: each employee expands to dept/name and name-only labels
// ======================================================================
IO::println("\n--- Dept/Name Labels (via flatMap) ---")
val allLabels: List[String] = employees.flatMap { e ->
  val emp = e as Employee
  ["" + emp.dept() + "/" + emp.name(), emp.name()]
}
IO::println("label count: " + allLabels.size)
foreach label: Object in allLabels.take(6) {
  IO::println("  " + (label as String))
}

// ======================================================================
// 16. String interpolation summary
// ======================================================================
val n  = employees.size
val hi = (ranked[0] as EmployeePayroll).emp().name()
IO::println("\nProcessed #{n} employees. Top earner: #{hi}. Annual cost: #{totalAnnual}.")
