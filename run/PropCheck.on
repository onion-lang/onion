// PropCheck.on — A mini property-based testing framework (QuickCheck-inspired)
//
// Exercises: class with mutable state (LCG RNG), records with methods,
// ADT case-enums, extension methods (Int, String), closures as properties,
// collection pipelines (map/filter/sortedBy/fold/any/find/count/groupBy),
// while/for/foreach, select + type patterns, string interpolation, nullable,
// recursion (integer shrinking).

// ─── Extension helpers ────────────────────────────────────────────────────────

extension Int {
  def abs(): Int = if self < 0 { 0 - self } else { self }
  def clamp(lo: Int, hi: Int): Int = if self < lo { lo } else if self > hi { hi } else { self }
  def padLeft(w: Int): String {
    val s: String = "" + self
    var r: String = s
    while r.length() < w { r = " " + r }
    return r
  }
  def sign(): String = if self > 0 { "+" } else if self < 0 { "-" } else { "0" }
}

extension String {
  def pad(w: Int): String {
    if self.length() >= w { return self.substring(0, w) }
    var r: String = self
    while r.length() < w { r = r + " " }
    return r
  }
  def repeat(n: Int): String {
    var s: String = ""
    for var i: Int = 0; i < n; i++ { s = s + self }
    return s
  }
  def isPalindrome(): Boolean {
    val len: Int = self.length()
    var ok: Boolean = true
    for var i: Int = 0; i < len / 2; i++ {
      if self.charAt(i) != self.charAt(len - 1 - i) { ok = false }
    }
    return ok
  }
}

// ─── LCG: Linear Congruential Generator ──────────────────────────────────────

class Lcg {
  var seed: Long
public:
  def this(s: Long) { seed = s }
  def fork(): Lcg = new Lcg(seed * 1000003L + 7L)
  def nextLong(): Long {
    seed = seed * 6364136223846793005L + 1442695040888963407L
    return seed
  }
  def nextInt(lo: Int, hi: Int): Int {
    val range: Long = (hi as Long) - (lo as Long) + 1L
    var raw: Long = nextLong()
    if raw < 0L { raw = 0L - raw }
    return lo + ((raw % range) as Int)
  }
  def nextBool(): Boolean = nextInt(0, 1) == 0
  def nextString(maxLen: Int): String {
    val alpha: String = "abcdefghijklmnopqrstuvwxyz"
    val len: Int = nextInt(0, maxLen)
    var s: String = ""
    for var i: Int = 0; i < len; i++ {
      s = s + alpha.charAt(nextInt(0, alpha.length() - 1))
    }
    return s
  }
  def nextList(size: Int, lo: Int, hi: Int): List[Int] {
    val xs: List[Int] = []
    for var i: Int = 0; i < size; i++ { xs.add(nextInt(lo, hi)) }
    return xs
  }
}

// ─── Result types ─────────────────────────────────────────────────────────────

enum CheckStatus {
  case Pass
  case Fail(counterexample: String, shrunkEx: String?)
  case Discard
}

record TestResult(
  name:       String,
  runs:       Int,
  passed:     Int,
  discarded:  Int,
  status:     CheckStatus
) {
public:
  def isPass(): Boolean = status() is Pass
  def summary(): String {
    return select status() {
      case p is Pass:
        "PASS  #{name().pad(40)} #{passed().padLeft(4)} / #{runs().padLeft(4)} ran"
      case f is Fail:
        val ex:  String = f.counterexample()
        val shx: String = f.shrunkEx() ?: ex
        "FAIL  #{name().pad(40)} example=#{ex}  shrunk=#{shx}"
      case d is Discard:
        "SKIP  #{name().pad(40)} (all discarded)"
    }
  }
}

// ─── Property runner ──────────────────────────────────────────────────────────

def shrinkInt(failing: Int, prop: (Int) -> Boolean): Int {
  var best: Int = failing
  var candidate: Int = failing / 2
  var steps: Int = 20
  while steps > 0 {
    if candidate != best && !prop(candidate) {
      best = candidate
      candidate = best / 2
    } else if (0 - candidate) != best && !prop(0 - candidate.abs()) {
      best = 0 - candidate.abs()
      candidate = best / 2
    } else {
      steps = 0
    }
    steps--
  }
  return best
}

def checkIntProp(
  name:  String,
  runs:  Int,
  rng:   Lcg,
  lo:    Int,
  hi:    Int,
  prop:  (Int) -> Boolean
): TestResult {
  var passed: Int = 0
  var failEx: String? = null
  var shrunk: String? = null
  for var i: Int = 0; i < runs; i++ {
    val a: Int = rng.nextInt(lo, hi)
    if prop(a) {
      passed++
    } else if failEx == null {
      failEx = "" + a
      val s: Int = shrinkInt(a, prop)
      shrunk = "" + s
    }
  }
  val status: CheckStatus =
    if failEx != null { new Fail(failEx as String, shrunk) }
    else              { new Pass() }
  return new TestResult(name, runs, passed, runs - passed, status)
}

def checkIntPairProp(
  name:  String,
  runs:  Int,
  rng:   Lcg,
  lo:    Int,
  hi:    Int,
  prop:  (Int, Int) -> Boolean
): TestResult {
  var passed: Int = 0
  var failEx: String? = null
  for var i: Int = 0; i < runs; i++ {
    val a: Int = rng.nextInt(lo, hi)
    val b: Int = rng.nextInt(lo, hi)
    if prop(a, b) {
      passed++
    } else if failEx == null {
      failEx = "(#{a}, #{b})"
    }
  }
  val status: CheckStatus =
    if failEx != null { new Fail(failEx as String, null) }
    else              { new Pass() }
  return new TestResult(name, runs, passed, runs - passed, status)
}

def checkIntTripleProp(
  name:  String,
  runs:  Int,
  rng:   Lcg,
  lo:    Int,
  hi:    Int,
  prop:  (Int, Int, Int) -> Boolean
): TestResult {
  var passed: Int = 0
  var failEx: String? = null
  for var i: Int = 0; i < runs; i++ {
    val a: Int = rng.nextInt(lo, hi)
    val b: Int = rng.nextInt(lo, hi)
    val c: Int = rng.nextInt(lo, hi)
    if prop(a, b, c) {
      passed++
    } else if failEx == null {
      failEx = "(#{a}, #{b}, #{c})"
    }
  }
  val status: CheckStatus =
    if failEx != null { new Fail(failEx as String, null) }
    else              { new Pass() }
  return new TestResult(name, runs, passed, runs - passed, status)
}

def checkStrProp(
  name:  String,
  runs:  Int,
  rng:   Lcg,
  maxL:  Int,
  prop:  (String) -> Boolean
): TestResult {
  var passed: Int = 0
  var failEx: String? = null
  for var i: Int = 0; i < runs; i++ {
    val s: String = rng.nextString(maxL)
    if prop(s) {
      passed++
    } else if failEx == null {
      failEx = "\"" + s + "\""
    }
  }
  val status: CheckStatus =
    if failEx != null { new Fail(failEx as String, null) }
    else              { new Pass() }
  return new TestResult(name, runs, passed, runs - passed, status)
}

def checkListProp(
  name:  String,
  runs:  Int,
  rng:   Lcg,
  sz:    Int,
  lo:    Int,
  hi:    Int,
  prop:  (List[Int]) -> Boolean
): TestResult {
  var passed: Int = 0
  var failEx: String? = null
  for var i: Int = 0; i < runs; i++ {
    val xs: List[Int] = rng.nextList(rng.nextInt(0, sz), lo, hi)
    if prop(xs) {
      passed++
    } else if failEx == null {
      val xsStr: String = xs.map { x -> "" + (x as Int) }.fold("", (acc: String, s: String) ->
        if acc == "" { s } else { acc + "," + s })
      failEx = "[#{xsStr}]"
    }
  }
  val status: CheckStatus =
    if failEx != null { new Fail(failEx as String, null) }
    else              { new Pass() }
  return new TestResult(name, runs, passed, runs - passed, status)
}

// ─── Helpers ─────────────────────────────────────────────────────────────────

def listMax(xs: List[Int]): Int {
  if xs.size == 0 { return 0 }
  var m: Int = xs.get(0) as Int
  foreach x: Int in xs { if x > m { m = x } }
  return m
}

def listSum(xs: List[Int]): Int {
  var s: Int = 0
  foreach x: Int in xs { s = s + x }
  return s
}

def isSorted(xs: List[Int]): Boolean {
  if xs.size <= 1 { return true }
  for var i: Int = 0; i < xs.size - 1; i++ {
    val a: Int = xs.get(i) as Int
    val b: Int = xs.get(i + 1) as Int
    if a > b { return false }
  }
  return true
}

def listEquals(a: List[Int], b: List[Int]): Boolean {
  if a.size != b.size { return false }
  for var i: Int = 0; i < a.size; i++ {
    if (a.get(i) as Int) != (b.get(i) as Int) { return false }
  }
  return true
}

// ─── Report ───────────────────────────────────────────────────────────────────

def printReport(results: List[TestResult]): void {
  val total:   Int = results.size
  val passing: Int = results.filter { r -> (r as TestResult).isPass() }.size
  val failing: Int = total - passing

  println("=".repeat(72))
  println("  MiniCheck Report  --  #{total} properties,  #{passing} pass,  #{failing} fail")
  println("=".repeat(72))
  println("")
  val failGroup: List[TestResult] = results.filter { r -> !(r as TestResult).isPass() }
  val passGroup: List[TestResult] = results.filter { r -> (r as TestResult).isPass() }
  if failGroup.size > 0 {
    println("  Failures:")
    foreach r: TestResult in failGroup { println("    " + r.summary()) }
    println("")
  }
  println("  Passing:")
  foreach r: TestResult in passGroup { println("    " + r.summary()) }
  println("")
  println("  Outcome: #{if failing == 0 { "ALL PASS" } else { "#{failing} FAILED" }}")
  println("=".repeat(72))
}

// ─── Main ─────────────────────────────────────────────────────────────────────

def main(): void {
  val rng: Lcg = new Lcg(20240101L)
  val N:   Int = 200
  val results: List[TestResult] = []

  // Arithmetic: commutativity
  results.add(checkIntPairProp(
    "addition is commutative:      a+b == b+a", N, rng, -1000, 1000,
    (a: Int, b: Int) -> a + b == b + a))

  // Arithmetic: associativity
  results.add(checkIntTripleProp(
    "addition is associative:  (a+b)+c == a+(b+c)", N, rng, -500, 500,
    (a: Int, b: Int, c: Int) -> (a + b) + c == a + (b + c)))

  // Arithmetic: distributivity
  results.add(checkIntTripleProp(
    "distributivity: a*(b+c)==a*b+a*c", N, rng, -100, 100,
    (a: Int, b: Int, c: Int) -> a * (b + c) == a * b + a * c))

  // abs is non-negative
  results.add(checkIntProp(
    "abs(a) >= 0", N, rng, -10000, 10000,
    (a: Int) -> a.abs() >= 0))

  // signum: a * sign >= 0 (using abs)
  results.add(checkIntProp(
    "a.abs() * a.abs() == a * a", N, rng, -1000, 1000,
    (a: Int) -> a.abs() * a.abs() == a * a))

  // Subtraction: a - a == 0
  results.add(checkIntProp(
    "a - a == 0", N, rng, -100000, 100000,
    (a: Int) -> a - a == 0))

  // Clamp: result is within bounds
  results.add(checkIntTripleProp(
    "clamp(a, lo, hi) in [lo..hi]", N, rng, -50, 50,
    (a: Int, lo: Int, hi: Int) -> {
      val lo2: Int = if lo <= hi { lo } else { hi }
      val hi2: Int = if lo <= hi { hi } else { lo }
      val c: Int = a.clamp(lo2, hi2)
      return c >= lo2 && c <= hi2
    }))

  // String: concat length
  results.add(checkStrProp(
    "string concat length", N, rng, 15,
    (s: String) -> {
      val t: String = rng.nextString(15)
      return (s + t).length() == s.length() + t.length()
    }))

  // String: palindrome detection is symmetric
  results.add(checkStrProp(
    "palindrome(reverse(s)) == palindrome(s)", N, rng, 8,
    (s: String) -> {
      val rev: String = new StringBuilder(s).reverse().toString()
      return rev.isPalindrome() == s.isPalindrome()
    }))

  // String: repeat length
  results.add(checkIntProp(
    "\"ab\".repeat(n).length == n*2  for n in 0..50", 50, rng, 0, 50,
    (n: Int) -> "ab".repeat(n).length() == n * 2))

  // List: sort preserves size
  results.add(checkListProp(
    "sort preserves length", N, rng, 20, -100, 100,
    (xs: List[Int]) -> xs.sortedBy { x -> (x as Int) }.size == xs.size))

  // List: sort is idempotent
  results.add(checkListProp(
    "sort is idempotent", N, rng, 15, -100, 100,
    (xs: List[Int]) -> {
      val once:  List[Int] = xs.sortedBy { x -> (x as Int) }
      val twice: List[Int] = once.sortedBy { x -> (x as Int) }
      return listEquals(once, twice)
    }))

  // List: max >= every element
  results.add(checkListProp(
    "max >= all elements", N, rng, 20, -500, 500,
    (xs: List[Int]) -> {
      if xs.size == 0 { return true }
      val m: Int = listMax(xs)
      return xs.filter { x -> (x as Int) > m }.size == 0
    }))

  // List: sum of [a,b,c] == a+b+c (spot-check three-element)
  results.add(checkIntTripleProp(
    "sum([a,b,c]) == a+b+c", N, rng, -200, 200,
    (a: Int, b: Int, c: Int) -> {
      val xs: List[Int] = [a, b, c]
      return listSum(xs) == a + b + c
    }))

  // Demonstrate a FAILING property: a*a < 10000 (fails for a >= 100)
  results.add(checkIntProp(
    "a*a < 10000  [expect fail; shrunk toward 100]", N, rng, -500, 500,
    (a: Int) -> a * a < 10000))

  // Demonstrate a FAILING pair property: a + b > a  (false when b <= 0)
  results.add(checkIntPairProp(
    "a+b > a  [expect fail, b<=0 is a counterexample]", N, rng, -100, 100,
    (a: Int, b: Int) -> a + b > a))

  printReport(results)
}
