// ProteinAnalyzer.on — amino acid properties and protein sequence analysis
//
// Exercises: data-carrying enum (AaClass), ADT case-enum with methods
// (AaPolarity), records with example clause, collection pipelines
// (map/filter/fold/groupBy/sortedBy/find/distinct),
// foreach (k,v) in Map, do[Option], extension methods (Int/String/Double),
// nullable types, closures, string interpolation, try/catch, while.

import {
  java.lang.Math as JMath;
  onion.Option;
}

// ── Amino acid polarity: ADT case-enum ───────────────────────────────────────

enum AaPolarity {
  case Nonpolar
  case Polar
  case PositiveCharge
  case NegativeCharge
  case Special
public:
  def label(): String = select this {
    case p is Nonpolar:        "Nonpolar"
    case p is Polar:           "Polar"
    case p is PositiveCharge:  "Positive (+)"
    case p is NegativeCharge:  "Negative (-)"
    case p is Special:         "Special"
  }
  def symbol(): String = select this {
    case p is Nonpolar:        "o"
    case p is Polar:           "*"
    case p is PositiveCharge:  "+"
    case p is NegativeCharge:  "-"
    case p is Special:         "!"
  }
}

// ── Amino acid class (data-carrying enum) ────────────────────────────────────

enum AaClass(abbrev: String, description: String) {
  Aliphatic("Ali",  "aliphatic"),
  Aromatic ("Aro",  "aromatic"),
  Amide    ("Ami",  "amide"),
  Acidic   ("Aci",  "acidic"),
  Basic    ("Bas",  "basic"),
  Hydroxyl ("Hyd",  "hydroxyl"),
  Sulfur   ("Sul",  "sulfur"),
  Imino    ("Imi",  "imino")
}

// ── AminoAcid record ─────────────────────────────────────────────────────────

record AminoAcid(
  name:     String,
  code1:    String,
  code3:    String,
  mw:       Double,
  polarity: AaPolarity,
  aaClass:  AaClass
) {
public:
  def isCharged(): Boolean =
    polarity() is PositiveCharge || polarity() is NegativeCharge
  def isNonpolar(): Boolean = polarity() is Nonpolar
  def label(): String = "#{name()} (#{code1()}/#{code3()})"
  def summary(): String =
    "#{code1()} #{code3()} #{polarity().symbol()} #{aaClass().abbrev()} MW=#{mw()}Da"
}

example {
  new AminoAcid("Glycine","G","Gly",57.05,new Nonpolar(),AaClass::Aliphatic).isCharged() == false
}
example {
  new AminoAcid("Lysine","K","Lys",128.17,new PositiveCharge(),AaClass::Basic).isCharged() == true
}

// ── Standard amino acid table ────────────────────────────────────────────────

