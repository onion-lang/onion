// ─── Main demo ────────────────────────────────────────────────────────────────

println("=== Recipe Planner Demo ===")
IO::println("")
println("Total recipes: #{book.size()}")
println("Average calories/serving: #{book.avgCalories()} kcal")
IO::println("")

// All recipes by category
println("── All Recipes by Category ──────────────────────────────────────────────")
val grouped: Map[Object, List[Recipe]] = book.byCategoryBreakdown()
foreach (cat, catRecipes) in grouped {
  println("  #{(cat as String).cap()}:")
  foreach r: Recipe in catRecipes.sortedBy { x -> (x as Recipe).name() } {
    println("    #{r}")
  }
}
IO::println("")

// Quick meals
println("── Quick Meals (≤15 min) ────────────────────────────────────────────────")
foreach r: Recipe in book.quickMeals(15) {
  println("  #{r}")
}
IO::println("")

// Low calorie options
println("── Low-calorie Dinners (≤500 kcal) ─────────────────────────────────────")
foreach r: Recipe in book.byCategory(MealCategory::Dinner).filter { r ->
  (r as Recipe).caloriesPerServing() <= 500
} {
  println("  #{r}")
}
IO::println("")

// Vegan options
val veganRecipes: List[Recipe] = book.byTag(new Vegan())
println("── Vegan Recipes (#{veganRecipes.size}) ──────────────────────────────────────────────")
foreach r: Recipe in veganRecipes.sortedBy { r -> (r as Recipe).name() } {
  println("  #{r}")
}
IO::println("")

// High-protein meals
println("── High-Protein Options ─────────────────────────────────────────────────")
val highProtein: List[Recipe] = book.byTag(new HighProtein())
foreach r: Recipe in highProtein.sortedBy { r -> -((r as Recipe).caloriesPerServing()) } {
  println("  #{r}")
}
IO::println("")

// Dietary tags in catalog
println("── Dietary Tags in Catalog: #{book.allTags()}")
IO::println("")

// Weekly meal plan
println("── Weekly Meal Plan ─────────────────────────────────────────────────────")
val planner = new MealPlanner()

val overnightOats: Recipe? = book.find("Overnight Oats")
val avocadoToast: Recipe?  = book.find("Avocado Toast")
val gYogurt: Recipe?       = book.find("Greek Yogurt Parfait")
val buddhaB: Recipe?       = book.find("Quinoa Buddha Bowl")
val chicken: Recipe?       = book.find("Chicken Caesar Salad")
val lentilS: Recipe?       = book.find("Lentil Soup")
val salmon: Recipe?        = book.find("Grilled Salmon")
val pasta: Recipe?         = book.find("Pasta Primavera")
val beef: Recipe?          = book.find("Beef Stir-fry")
val risotto: Recipe?       = book.find("Mushroom Risotto")
val hummus: Recipe?        = book.find("Hummus & Veggies")

if overnightOats != null { planner.plan("Monday",    MealCategory::Breakfast, overnightOats) }
if buddhaB       != null { planner.plan("Monday",    MealCategory::Lunch,     buddhaB)       }
if salmon        != null { planner.plan("Monday",    MealCategory::Dinner,    salmon)        }
if avocadoToast  != null { planner.plan("Tuesday",   MealCategory::Breakfast, avocadoToast)  }
if chicken       != null { planner.plan("Tuesday",   MealCategory::Lunch,     chicken)       }
if pasta         != null { planner.plan("Tuesday",   MealCategory::Dinner,    pasta)         }
if gYogurt       != null { planner.plan("Wednesday", MealCategory::Breakfast, gYogurt)       }
if lentilS       != null { planner.plan("Wednesday", MealCategory::Lunch,     lentilS)       }
if beef          != null { planner.plan("Wednesday", MealCategory::Dinner,    beef)          }
if overnightOats != null { planner.plan("Thursday",  MealCategory::Breakfast, overnightOats) }
if buddhaB       != null { planner.plan("Thursday",  MealCategory::Lunch,     buddhaB)       }
if risotto       != null { planner.plan("Thursday",  MealCategory::Dinner,    risotto)       }
if avocadoToast  != null { planner.plan("Friday",    MealCategory::Breakfast, avocadoToast)  }
if chicken       != null { planner.plan("Friday",    MealCategory::Lunch,     chicken)       }
if salmon        != null { planner.plan("Friday",    MealCategory::Dinner,    salmon)        }
if hummus        != null { planner.plan("Monday",    MealCategory::Snack,     hummus)        }
if hummus        != null { planner.plan("Wednesday", MealCategory::Snack,     hummus)        }

planner.printWeeklyPlan()
IO::println("")

// Daily calorie totals
println("── Daily Calorie Totals ─────────────────────────────────────────────────")
foreach day: String in ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"] {
  val cal: Int = planner.dailyCalories(day)
  val bar: String = "|".repeat(cal / 100)
  println("  #{day.padEnd(11)} #{cal.kcalStr().padEnd(12)} #{bar}")
}
IO::println("")

// Weekly nutrition
println("── Weekly Nutrition (all planned meals) ─────────────────────────────────")
val weekNutrition: NutritionFacts = planner.nutritionSummary()
println("  #{weekNutrition}")
IO::println("")

// find / nullable demo
val missing: Recipe? = book.find("Flying Saucer Soup")
println("Search 'Flying Saucer Soup': #{if missing == null { "not found" } else { "found" }}")
IO::println("")

println("Done.")
