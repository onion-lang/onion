// RecipePlanner.on — recipe catalog and weekly meal planner (~280 lines)
//
// Exercises: extension methods (Int/Double/String), data-carrying enums,
// ADT case enums with methods, records with methods and operator overloading,
// class with mutable state, collection pipelines (groupBy/map/filter/fold/
// sortedBy/find/take/count/any), foreach (list + map + range), select/
// pattern matching, nullable types, string interpolation, try/catch, closures.

// ─── Extension methods ────────────────────────────────────────────────────────

extension Int {
  def kcalStr(): String = "#{self} kcal"
}

extension Double {
  def pct(): String {
    val s: String = "" + self
    val dot: Int = s.indexOf(".")
    if dot < 0 { return s + ".0%" }
    val end: Int = dot + 2
    if s.length() <= end { return s + "%" }
    return s.substring(0, end) + "%"
  }
}

extension String {
  def padEnd(width: Int): String {
    var s: String = self
    while s.length() < width { s = s + " " }
    return s
  }
  def cap(): String {
    if self.length() == 0 { return self }
    return self.substring(0, 1).toUpperCase() + self.substring(1)
  }
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Data-carrying: each meal category has a display label and recommended meals/day
enum MealCategory(label: String, slotsPerDay: Int) {
  Breakfast ("Breakfast", 1),
  Lunch     ("Lunch",     1),
  Dinner    ("Dinner",    1),
  Snack     ("Snack",     2),
  Dessert   ("Dessert",   1)
}

// ADT enum for dietary tag
enum DietaryTag {
  case Vegan
  case Vegetarian
  case GlutenFree
  case DairyFree
  case HighProtein
  case LowCarb
  case Keto
public:
  def label(): String = select this {
    case t is Vegan:       "Vegan"
    case t is Vegetarian:  "Vegetarian"
    case t is GlutenFree:  "Gluten-free"
    case t is DairyFree:   "Dairy-free"
    case t is HighProtein: "High-protein"
    case t is LowCarb:     "Low-carb"
    case t is Keto:        "Keto"
  }
}

// ─── Records ─────────────────────────────────────────────────────────────────

record Ingredient(name: String, grams: Int, caloriesPerGram: Double) {
public:
  def calories(): Int = (grams() as Double * caloriesPerGram()) as Int
  override def toString(): String = "#{name()} #{grams()}g (#{calories().kcalStr()})"
}

record NutritionFacts(calories: Int, carbsG: Int, proteinG: Int, fatG: Int) {
public:
  def plus(o: NutritionFacts): NutritionFacts =
    new NutritionFacts(calories() + o.calories(), carbsG() + o.carbsG(),
                       proteinG() + o.proteinG(), fatG() + o.fatG())
  override def toString(): String =
    "#{calories()} kcal | carbs #{carbsG()}g | protein #{proteinG()}g | fat #{fatG()}g"
}

record Recipe(
  name: String,
  category: MealCategory,
  tags: List[DietaryTag],
  ingredients: List[Ingredient],
  nutrition: NutritionFacts,
  prepMins: Int,
  servings: Int
) {
public:
  def caloriesPerServing(): Int = nutrition().calories() / servings()
  def isTagged(tag: DietaryTag): Boolean =
    tags().any { t -> (t as DietaryTag) == tag }
  def totalPrepInfo(): String =
    if prepMins() < 60 { "#{prepMins()} min" }
    else { "#{prepMins() / 60}h #{prepMins() % 60}min" }
  override def toString(): String =
    "#{name().padEnd(32)} [#{category().label().padEnd(10)}] #{caloriesPerServing().kcalStr().padEnd(12)} #{totalPrepInfo()}"
}

record MealSlot(day: String, meal: MealCategory, recipe: Recipe)

// ─── RecipeBook class ─────────────────────────────────────────────────────────

class RecipeBook {
  var _recipes: List[Recipe]

public:
  def this { _recipes = [] }

  def add(r: Recipe): void { _recipes << r }

  def size(): Int = _recipes.size

  def find(name: String): Recipe? =
    _recipes.find { r -> (r as Recipe).name() == name }

  def byCategory(cat: MealCategory): List[Recipe] =
    _recipes.filter { r -> (r as Recipe).category() == cat }

  def byTag(tag: DietaryTag): List[Recipe] =
    _recipes.filter { r -> (r as Recipe).isTagged(tag) }

  def quickMeals(maxMinutes: Int): List[Recipe] =
    _recipes.filter { r -> (r as Recipe).prepMins() <= maxMinutes }
             .sortedBy { r -> (r as Recipe).prepMins() }

  def lowCalorie(maxKcal: Int): List[Recipe] =
    _recipes.filter { r -> (r as Recipe).caloriesPerServing() <= maxKcal }
             .sortedBy { r -> (r as Recipe).caloriesPerServing() }

  def byCategoryBreakdown(): Map[Object, List[Recipe]] =
    _recipes.groupBy { r -> (r as Recipe).category().label() }

  def avgCalories(): Double {
    if _recipes.size == 0 { return 0.0 }
    val total: Int = _recipes.fold(0) { acc, r -> acc + (r as Recipe).caloriesPerServing() }
    return total as Double / _recipes.size as Double
  }

  def allTags(): List[String] {
    var seen: List[String] = []
    foreach r: Recipe in _recipes {
      foreach t: DietaryTag in r.tags() {
        val lbl: String = t.label()
        if !(seen.any { s -> (s as String) == lbl }) {
          seen << lbl
        }
      }
    }
    return seen.sortedBy { s -> s as String }
  }
}

// ─── MealPlanner class ────────────────────────────────────────────────────────

class MealPlanner {
  var _slots: List[MealSlot]
  val days: List[String]

public:
  def this {
    _slots = []
    days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
  }

  def plan(day: String, meal: MealCategory, recipe: Recipe): void {
    _slots << new MealSlot(day, meal, recipe)
  }

  def weeklyCalories(): Int =
    _slots.fold(0) { acc, s -> acc + (s as MealSlot).recipe().caloriesPerServing() }

  def dailyCalories(day: String): Int =
    _slots.filter { s -> (s as MealSlot).day() == day }
          .fold(0) { acc, s -> acc + (s as MealSlot).recipe().caloriesPerServing() }

  def printWeeklyPlan(): void {
    println("  Day          Meal        Recipe")
    println("  " + "-".repeat(60))
    foreach slot: MealSlot in _slots.sortedBy { s ->
      val d: MealSlot = s as MealSlot
      val dayIdx: Int = days.indexOf(d.day())
      dayIdx * 10 + d.meal().ordinal()
    } {
      val dayStr: String = slot.day().padEnd(12)
      val mealStr: String = slot.meal().label().padEnd(11)
      println("  #{dayStr} #{mealStr} #{slot.recipe().name()}")
    }
  }

  def nutritionSummary(): NutritionFacts {
    var total = new NutritionFacts(0, 0, 0, 0)
    foreach slot: MealSlot in _slots {
      total = total + slot.recipe().nutrition()
    }
    return total
  }
}

// ─── Recipe data ──────────────────────────────────────────────────────────────

val book = new RecipeBook()

// Breakfast recipes
book.add(new Recipe(
  "Overnight Oats", MealCategory::Breakfast,
  [new Vegan(), new GlutenFree()],
