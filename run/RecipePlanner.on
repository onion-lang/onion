  "Avocado Toast", MealCategory::Breakfast,
  [new Vegan(), new DairyFree()],
  [new Ingredient("sourdough bread", 100, 2.5), new Ingredient("avocado", 100, 1.6),
   new Ingredient("cherry tomatoes", 60, 0.2)],
  new NutritionFacts(380, 44, 10, 18), 10, 1))

