// SudokuSolver.on — Backtracking Sudoku solver with multiple puzzles.
// Exercises: Int[][] 2D arrays, backtracking recursion, nullable records,
// ADT case-enum with singleton cases, extension methods on Int and String,
// foreach with ranges, class with many methods, static factory methods,
// string interpolation, collection pipeline (filter/map/fold) on typed List,
// list append (<<), pattern matching, select on ADT enum.

// ── Difficulty ADT ────────────────────────────────────────────────────────────
enum Difficulty {
  case Easy
  case Medium
  case Hard
  case Expert
public:
  def label(): String = select this {
    case d is Easy:   "Easy"
    case d is Medium: "Medium"
    case d is Hard:   "Hard"
    case d is Expert: "Expert"
  }
  def tag(): String = select this {
    case d is Easy:   "[E]"
    case d is Medium: "[M]"
    case d is Hard:   "[H]"
    case d is Expert: "[X]"
  }
}

// ── Cell: position of an empty cell ──────────────────────────────────────────
record Cell(row: Int, col: Int)

// ── Puzzle metadata ───────────────────────────────────────────────────────────
record PuzzleMeta(name: String, difficulty: Difficulty, author: String)

// ── SolveResult: what happened when solving a puzzle ─────────────────────────
record SolveResult(
  name: String,
  difficulty: String,
  givens: Int,
  solved: Boolean,
  verified: Boolean
)

// ── Extension on Int ──────────────────────────────────────────────────────────
extension Int {
  def cellChar(): String = if self == 0 { "." } else { "" + self }
  def padLeft(width: Int): String {
    var s: String = "" + self
    while s.length() < width { s = " " + s }
    return s
  }
}

extension String {
  def padRight(width: Int): String {
    var s: String = self
    while s.length() < width { s = s + " " }
    return s
  }
  def rep(n: Int): String {
    var s: String = ""
    var i: Int = 0
    while i < n { s = s + self; i = i + 1 }
    return s
  }
}

// ── SudokuGrid class ──────────────────────────────────────────────────────────
class SudokuGrid {
public:
  var grid: Int[][]
  var meta: PuzzleMeta

  def this(meta: PuzzleMeta, cells: Int[][]) {
    this.meta = meta
    this.grid = cells
  }

  static def deepCopy(src: Int[][]): Int[][] {
    val result: Int[][] = new Int[9][9]
    foreach r: Int in 0..<9 {
      foreach c: Int in 0..<9 {
        result[r][c] = src[r][c]
      }
    }
    return result
  }

  def countGivens(): Int {
    var count: Int = 0
    foreach r: Int in 0..<9 {
      foreach c: Int in 0..<9 {
        if grid[r][c] != 0 { count = count + 1 }
      }
    }
    return count
  }

  def isValidInRow(row: Int, num: Int): Boolean {
    foreach c: Int in 0..<9 {
      if grid[row][c] == num { return false }
    }
    return true
  }

  def isValidInCol(col: Int, num: Int): Boolean {
    foreach r: Int in 0..<9 {
      if grid[r][col] == num { return false }
    }
    return true
  }

  def isValidInBox(boxRow: Int, boxCol: Int, num: Int): Boolean {
    foreach r: Int in 0..<3 {
      foreach c: Int in 0..<3 {
        if grid[boxRow + r][boxCol + c] == num { return false }
      }
    }
    return true
  }

  def isValidPlacement(row: Int, col: Int, num: Int): Boolean {
    return isValidInRow(row, num) &&
           isValidInCol(col, num) &&
           isValidInBox(row - row % 3, col - col % 3, num)
  }

  def findEmpty(): Cell? {
    foreach r: Int in 0..<9 {
      foreach c: Int in 0..<9 {
        if grid[r][c] == 0 { return new Cell(r, c) }
      }
    }
    return null
  }

  // Backtracking solver: try each digit 1-9 in the first empty cell.
  // Returns true when the board is fully and validly filled.
  def solve(): Boolean {
    val empty: Cell? = findEmpty()
    if empty == null { return true }
    val cell: Cell = empty as Cell
    val row: Int = cell.row()
    val col: Int = cell.col()
    foreach num: Int in 1..9 {
      if isValidPlacement(row, col, num) {
        grid[row][col] = num
        if solve() { return true }
        grid[row][col] = 0
      }
    }
    return false
  }

  // Verify that the solved grid satisfies all Sudoku constraints.
  def verifySolution(): Boolean {
    foreach r: Int in 0..<9 {
      val seen: Int[] = new Int[10]
      foreach c: Int in 0..<9 {
        val v: Int = grid[r][c]
        if v < 1 || v > 9 { return false }
        if seen[v] != 0 { return false }
        seen[v] = 1
      }
    }
    foreach c: Int in 0..<9 {
      val seen: Int[] = new Int[10]
      foreach r: Int in 0..<9 {
        val v: Int = grid[r][c]
        if v < 1 || v > 9 { return false }
        if seen[v] != 0 { return false }
        seen[v] = 1
      }
    }
    foreach boxR: Int in 0..<3 {
      foreach boxC: Int in 0..<3 {
        val seen: Int[] = new Int[10]
        foreach r: Int in 0..<3 {
          foreach c: Int in 0..<3 {
            val v: Int = grid[boxR * 3 + r][boxC * 3 + c]
            if v < 1 || v > 9 { return false }
            if seen[v] != 0 { return false }
            seen[v] = 1
          }
        }
      }
    }
    return true
  }

  def display(label: String): void {
    IO::println("+-------+-------+-------+  " + label)
    foreach r: Int in 0..<9 {
      var line: String = "| "
      foreach c: Int in 0..<9 {
        line = line + grid[r][c].cellChar() + " "
        if c == 2 || c == 5 { line = line + "| " }
      }
      IO::println(line + "|")
      if r == 2 || r == 5 {
        IO::println("+-------+-------+-------+")
      }
    }
    IO::println("+-------+-------+-------+")
  }
}

// ── Puzzle factory ────────────────────────────────────────────────────────────
class Puzzles {
public:
  // Easy puzzle — 36 givens (Wikibooks "Sudoku" example)
  static def easy(): SudokuGrid {
    val g: Int[][] = new Int[9][9]
    g[0][0]=5; g[0][1]=3; g[0][4]=7
    g[1][0]=6; g[1][3]=1; g[1][4]=9; g[1][5]=5
    g[2][1]=9; g[2][2]=8; g[2][7]=6
    g[3][0]=8; g[3][4]=6; g[3][8]=3
    g[4][0]=4; g[4][3]=8; g[4][5]=3; g[4][8]=1
    g[5][0]=7; g[5][4]=2; g[5][8]=6
    g[6][1]=6; g[6][6]=2; g[6][7]=8
    g[7][3]=4; g[7][4]=1; g[7][5]=9; g[7][8]=5
    g[8][4]=8; g[8][7]=7; g[8][8]=9
    return new SudokuGrid(new PuzzleMeta("Classic Intro", new Easy(), "Wikibooks"), g)
  }

  // Medium puzzle — 27 givens
  static def medium(): SudokuGrid {
    val g: Int[][] = new Int[9][9]
    g[0][0]=1; g[0][5]=7; g[0][6]=9
    g[1][1]=3; g[1][8]=6
    g[2][2]=6; g[2][3]=3; g[2][7]=8
    g[3][0]=8; g[3][5]=6
    g[4][1]=9; g[4][4]=4; g[4][7]=3
    g[5][3]=5; g[5][8]=7
    g[6][1]=6; g[6][5]=5; g[6][6]=4
    g[7][0]=2; g[7][7]=9
    g[8][2]=4; g[8][3]=1; g[8][8]=8
    return new SudokuGrid(new PuzzleMeta("Daily Medium", new Medium(), "Sudoku.com"), g)
  }

  // Hard puzzle — 17 givens (Norvig's hardest benchmark, verified unique solution)
  // "4.....8.5.3..........7......2.....6.....8.4......1.......6.3.7.5..2.....1.4......"
  static def hard(): SudokuGrid {
    val g: Int[][] = new Int[9][9]
    g[0][0]=4; g[0][6]=8; g[0][8]=5
    g[1][1]=3
    g[2][3]=7
    g[3][2]=2; g[3][7]=6
    g[4][5]=8; g[4][7]=4
    g[5][4]=1
    g[6][6]=6; g[6][8]=3
    g[7][1]=7; g[7][3]=5; g[7][6]=2
    g[8][3]=1; g[8][5]=4
    return new SudokuGrid(new PuzzleMeta("Norvig Hard", new Hard(), "Peter Norvig"), g)
  }

  // Expert puzzle — 21 givens (Arto Inkala "World's Hardest Sudoku", 2010)
  static def expert(): SudokuGrid {
    val g: Int[][] = new Int[9][9]
    g[0][0]=8
    g[1][2]=3; g[1][3]=6
    g[2][1]=7; g[2][4]=9; g[2][6]=2
    g[3][1]=5; g[3][5]=7
    g[4][4]=4; g[4][5]=5; g[4][6]=7
    g[5][3]=1; g[5][7]=3
    g[6][2]=1; g[6][7]=6; g[6][8]=8
    g[7][2]=8; g[7][3]=5; g[7][7]=1
    g[8][1]=9; g[8][6]=4
    return new SudokuGrid(new PuzzleMeta("World Hardest", new Expert(), "Arto Inkala"), g)
  }
}

// ── Statistics tracker ────────────────────────────────────────────────────────
class Stats {
public:
  var results: List[SolveResult]

  def this() { this.results = [] }

  def add(r: SolveResult): void { results << r }

  def totalSolved(): Int {
    return results.filter { r => r.solved() }.size
  }

  def allVerified(): Boolean {
    return results
      .filter { r => r.solved() }
      .filter { r => !r.verified() }
      .size == 0
  }

  def printSummary(): void {
    val total: Int = results.size
    val solved: Int = totalSolved()
    IO::println("")
    IO::println("━".rep(45))
    IO::println("  SUMMARY: " + solved + " of " + total + " puzzles solved" +
                "  |  All verified: " + allVerified())
    IO::println("")
    IO::println("  #   Puzzle              Diff    Givens  Status")
    IO::println("  " + "-".rep(41))
    var idx: Int = 1
    foreach r: SolveResult in results {
      val status: String = if r.solved() { if r.verified() { "SOLVED [PASS]" } else { "SOLVED [UNVERIFIED]" } } else { "FAILED" }
      IO::println("  " + idx.padLeft(2) + "  " +
                  r.name().padRight(18) + "  " +
                  r.difficulty().padRight(7) + "  " +
                  r.givens().padLeft(4) + "    " +
                  status)
      idx = idx + 1
    }
    IO::println("━".rep(45))
  }
}

// ── Solver runner ─────────────────────────────────────────────────────────────
def runPuzzle(puzzle: SudokuGrid, stats: Stats): void {
  val m: PuzzleMeta = puzzle.meta
  val givens: Int = puzzle.countGivens()
  val sep: String = "─".rep(43)
  IO::println("")
  IO::println("┌" + sep + "┐")
  IO::println("│  " + m.name().padRight(28) + m.difficulty().tag() + "          │")
  IO::println("│  by " + m.author().padRight(37) + "│")
  IO::println("│  " + givens + " givens | " + (81 - givens) + " to fill" + " ".rep(24) + "│")
  IO::println("└" + sep + "┘")
  puzzle.display("Given puzzle")
  val solved: Boolean = puzzle.solve()
  if solved {
    puzzle.display("Solution")
    val ok: Boolean = puzzle.verifySolution()
    IO::println("  Verify: " + (if ok { "PASS" } else { "FAIL" }))
    stats.add(new SolveResult(m.name(), m.difficulty().label(), givens, true, ok))
  } else {
    IO::println("  Result: NO SOLUTION FOUND")
    stats.add(new SolveResult(m.name(), m.difficulty().label(), givens, false, false))
  }
}

// ── Main ──────────────────────────────────────────────────────────────────────
IO::println("┌─────────────────────────────────────────┐")
IO::println("│        SUDOKU SOLVER  v1.0              │")
IO::println("│  Constraint checking + backtracking     │")
IO::println("└─────────────────────────────────────────┘")

val stats: Stats = new Stats()

runPuzzle(Puzzles::easy(),   stats)
runPuzzle(Puzzles::medium(), stats)
runPuzzle(Puzzles::hard(),   stats)
runPuzzle(Puzzles::expert(), stats)

stats.printSummary()
