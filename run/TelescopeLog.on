// TelescopeLog.on — amateur-astronomer observation log, analysis, and reporting.
// Exercises: from re"..." records with Int/String groups, data-carrying enums,
// ADT enums, records with methods, extension methods (Int/Double), collection
// pipelines (filter/map/fold/groupBy/sortedBy/distinct/partition/find/any),
// select/exhaustive pattern matching, nullable + null-narrowing, closures,
// string interpolation, try/catch, foreach (list & map k,v), recursion.

// ─── extensions ──────────────────────────────────────────────────────────────

extension Int {
  def repeatStr(ch: String): String {
    var s: String = ""
    var i: Int = 0
    while i < self { s = s + ch; i++ }
    return s
  }
  def pct(den: Int): String {
    if den == 0 { return "0%" }
    return "" + (self * 100 / den) + "%"
  }
}

extension Double {
  def round2(): Double {
    val factor: Long = 100L
    return (self * factor.doubleValue()).longValue().doubleValue() / factor.doubleValue()
  }
}

// ─── ObjectType: data-carrying enum ──────────────────────────────────────────

enum ObjectType(symbol: String, tag: String) {
  Star("★", "star"),
  Planet("●", "planet"),
  Galaxy("⬡", "galaxy"),
  Nebula("☁", "nebula"),
  Cluster("✦", "cluster"),
  Comet("☄", "comet"),
  Unknown("?", "unknown")
public:
  def label(): String = "#{symbol()} #{tag()}"
}

// ─── Seeing: Antoniadi scale 1–5 ─────────────────────────────────────────────

enum Seeing(code: Int, summary: String) {
  Perfect(1, "no quivering"),
  Good(2,  "slight undulations"),
  Average(3, "moderate quivering"),
  Poor(4,  "constant undulations"),
  Terrible(5, "barely usable")
public:
  def stars(): String = (6 - code()).repeatStr("★")
  static def fromCode(c: Int): Seeing = select c {
    case 1: Seeing::Perfect
    case 2: Seeing::Good
    case 3: Seeing::Average
    case 4: Seeing::Poor
    else:   Seeing::Terrible
  }
}

// ─── ObsOutcome: ADT ─────────────────────────────────────────────────────────

enum ObsOutcome {
  case Hit(notes: String)
  case Miss(reason: String)
  case Partial(pct: Int, notes: String)
public:
  def tag(): String = select this {
    case h is Hit:     "HIT"
    case m is Miss:    "MISS"
    case p is Partial: "PART"
  }
  def shortNote(): String = select this {
    case h is Hit:     h.notes()
    case m is Miss:    "failed: " + m.reason()
    case p is Partial: p.pct() + "% — " + p.notes()
  }
  def isSuccess(): Boolean = select this {
    case h is Hit:     true
    case m is Miss:    false
    case p is Partial: p.pct() >= 50
  }
  static def of(tag: String, notes: String): ObsOutcome = select tag {
    case "HIT":  new Hit(notes)
    case "MISS": new Miss(notes)
    else:        new Partial(70, notes)
  }
}

// ─── CatalogEntry ─────────────────────────────────────────────────────────────

record CatalogEntry(
  id:        String,
  name:      String,
  objType:   ObjectType,
  magnitude: Double,
  constell:  String
) {
public:
  def label(): String = "#{id()} #{name()} [#{objType().symbol()}] mag=#{magnitude()} (#{constell()})"
  def isTelescopic(): Boolean = magnitude() > 5.5
  def isDeepSky(): Boolean = select objType() {
    case ObjectType::Galaxy:  true
    case ObjectType::Nebula:  true
    case ObjectType::Cluster: true
    else: false
  }
}

// ─── RawObs: parsed from "YYYY-MM-DD,ID,DURATION,SEEING_CODE,TAG,NOTES" ──────

record RawObs(
  date:        String,
  catalogId:   String,
  durationMin: Int,
  seeingCode:  Int,
  resultTag:   String,
  notes:       String
) from re"(\d{4}-\d{2}-\d{2}),([A-Z][A-Z0-9]+),(\d+),(\d),(HIT|MISS|PART),(.*)"

example { RawObs::parse("2024-03-15,M42,45,1,HIT,Excellent detail") != null }
example { RawObs::parse("bad-line") == null }

// ─── Observation ─────────────────────────────────────────────────────────────

record Observation(
  date:        String,
  entry:       CatalogEntry,
  durationMin: Int,
  seeing:      Seeing,
  outcome:     ObsOutcome
) {
public:
  def month(): String = date().substring(0, 7)
  def year():  String = date().substring(0, 4)
  def hitScore(): Int = select outcome() {
    case h is Hit:     if seeing().code() <= 2 { 5 } else { 3 }
    case p is Partial: 2
    case m is Miss:    0
  }
  def label(): String =
    "#{date()} #{entry().id()} (#{entry().objType().symbol()}) " +
    "#{durationMin()}min see=#{seeing().stars()} → #{outcome().tag()}"
}

// ─── catalog data ─────────────────────────────────────────────────────────────

val catalog: List[CatalogEntry] = [
  new CatalogEntry("M42",   "Orion Nebula",       ObjectType::Nebula,    4.0,  "Ori"),
