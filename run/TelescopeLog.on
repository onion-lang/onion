// ─── parse log lines ──────────────────────────────────────────────────────────

def findEntry(id: String): CatalogEntry? =
  catalog.find { e -> (e as CatalogEntry).id() == id }

def parseObs(line: String): Observation? {
  val raw: RawObs? = RawObs::parse(line)
  if raw == null { return null }
  val raw2: RawObs = raw as RawObs
  val entry: CatalogEntry? = findEntry(raw2.catalogId())
  if entry == null { return null }
  return new Observation(
    raw2.date(),
    entry as CatalogEntry,
    raw2.durationMin(),
    Seeing::fromCode(raw2.seeingCode()),
    ObsOutcome::of(raw2.resultTag(), raw2.notes())
  )
}

val observations: List[Observation] = rawLines
  .map    { line -> parseObs(line as String) }
  .filter { o    -> o != null }
  .map    { o    -> o as Observation }

// ─── display helper ───────────────────────────────────────────────────────────

def printHeader(title: String): void {
  IO::println("")
  IO::println(title)
  IO::println(80.repeatStr("-"))
}

// ─── 1. Raw log dump ──────────────────────────────────────────────────────────

printHeader("=== All Observations ===")
IO::println("  Parsed " + observations.size + " / " + rawLines.size + " lines")
foreach obs: Observation in observations {
  IO::println("  " + obs.label())
}

// ─── 2. Success / failure breakdown ──────────────────────────────────────────

printHeader("=== Success / Failure Breakdown ===")
val partSF   = observations.partition { o -> (o as Observation).outcome().isSuccess() }
val hits     = partSF[0] as List[Object]
val misses   = partSF[1] as List[Object]
IO::println("  Total:   " + observations.size)
IO::println("  Success: " + hits.size + "  (" + hits.size.pct(observations.size) + ")")
IO::println("  Failure: " + misses.size + "  (" + misses.size.pct(observations.size) + ")")

// ─── 3. By object type ────────────────────────────────────────────────────────

printHeader("=== Observations by Object Type ===")
val byType = observations.groupBy { o -> (o as Observation).entry().objType().symbol() }
foreach (sym, obsList) in byType {
  val ol = obsList as List[Observation]
  val ok = ol.filter { o -> (o as Observation).outcome().isSuccess() }
  IO::println("  " + sym + "  " + ol.size + " obs,  " + ok.size + " hits  (" + ok.size.pct(ol.size) + ")")
}

// ─── 4. Monthly summary ───────────────────────────────────────────────────────

printHeader("=== Monthly Summary ===")
val byMonth = observations.groupBy { o -> (o as Observation).month() }
val months: List[String] = byMonth.keys().sortedBy { k -> k as String }
foreach m: String in months {
  val mo = byMonth.get(m) as List[Observation]
  val mins = mo.fold(0) { acc, o -> (acc as Int) + (o as Observation).durationMin() }
  val ok2  = mo.filter { o -> (o as Observation).outcome().isSuccess() }
  IO::println("  " + m + "  " + mo.size + " obs / " + mins + " min / " + ok2.size + " hits")
}

// ─── 5. Top targets by cumulative hit score ───────────────────────────────────

printHeader("=== Top Targets by Hit Score ===")
val byTarget = observations.groupBy { o -> (o as Observation).entry().id() }
val targetIds: List[String] = byTarget.keys()
  .map { k -> k as String }
  .sortedBy { id ->
    val ol2 = byTarget.get(id) as List[Observation]
    0 - ol2.fold(0) { acc, o -> (acc as Int) + (o as Observation).hitScore() }
  }
foreach tid: String in targetIds {
  val ol3 = byTarget.get(tid) as List[Observation]
  val score = ol3.fold(0) { acc, o -> (acc as Int) + (o as Observation).hitScore() }
  val found: CatalogEntry? = findEntry(tid)
  val name: String = if found != null { (found as CatalogEntry).name() } else { tid }
  IO::println("  " + tid + "  " + name + "  score=" + score + "  (" + ol3.size + " obs)")
}

// ─── 6. Seeing distribution ──────────────────────────────────────────────────

printHeader("=== Seeing Condition Distribution ===")
val bySeeingCode = observations.groupBy { o -> "" + (o as Observation).seeing().code() }
val seeingKeys: List[String] = bySeeingCode.keys().sortedBy { k -> k as String }
foreach sk: String in seeingKeys {
  val sl = bySeeingCode.get(sk) as List[Observation]
  val seeing = sl[0].seeing()
  IO::println("  " + seeing.stars() + "  Antoniadi " + sk + " (" + seeing.summary() + ") — " + sl.size + " sessions")
}

// ─── 7. Longest sessions (top 5) ─────────────────────────────────────────────

printHeader("=== Five Longest Sessions ===")
val byDuration: List[Observation] = observations.sortedBy { o -> 0 - (o as Observation).durationMin() }
var rank: Int = 0
foreach obs2: Observation in byDuration {
  if rank >= 5 { break }
  IO::println("  #" + (rank + 1) + "  " + obs2.durationMin() + "min  " + obs2.entry().name() + "  " + obs2.date())
  rank++
}

// ─── 8. Deep-sky vs. solar-system ────────────────────────────────────────────

printHeader("=== Deep-Sky vs. Solar-System ===")
val partDS   = observations.partition { o -> (o as Observation).entry().isDeepSky() }
val deepSky  = partDS[0] as List[Object]
val solarSys = partDS[1] as List[Object]
val dsHits   = deepSky.filter  { o -> (o as Observation).outcome().isSuccess() }
val ssHits   = solarSys.filter { o -> (o as Observation).outcome().isSuccess() }
IO::println("  Deep-sky    : " + deepSky.size  + " obs,  " + dsHits.size  + " hits  (" + dsHits.size.pct(deepSky.size)   + ")")
IO::println("  Solar-system: " + solarSys.size + " obs,  " + ssHits.size  + " hits  (" + ssHits.size.pct(solarSys.size)  + ")")

// ─── 9. Catalog summary ───────────────────────────────────────────────────────

printHeader("=== Catalog (sorted by magnitude) ===")
foreach e: CatalogEntry in catalog.sortedBy { e -> (e as CatalogEntry).magnitude() } {
  IO::println("  " + e.label())
}

// ─── 10. Observed vs. unobserved ─────────────────────────────────────────────

printHeader("=== Coverage ===")
val seenIds: List[String] = observations.map { o -> (o as Observation).entry().id() }.distinct()
IO::println("  Observed  : " + seenIds.size + " of " + catalog.size + " catalog objects")
val unseen: List[String] = catalog
  .filter { e -> !seenIds.any { sid -> (sid as String) == (e as CatalogEntry).id() } }
  .map    { e -> (e as CatalogEntry).name() }
IO::println("  Unobserved: " + unseen.toString())

// ─── 11. Best night (most successful observations) ───────────────────────────

printHeader("=== Best Night ===")
val byDate = observations.groupBy { o -> (o as Observation).date() }
var bestDate: String = ""
var bestCount: Int = 0
foreach (dt, obsList2) in byDate {
  val ol4 = obsList2 as List[Observation]
  val hitCount = ol4.filter { o -> (o as Observation).outcome().isSuccess() }.size
  if hitCount > bestCount {
    bestCount = hitCount
    bestDate  = dt as String
  }
}
IO::println("  Best night: " + bestDate + " with " + bestCount + " successful observations")
val bestNightObs = (byDate.get(bestDate) as List[Observation])
  .filter { o -> (o as Observation).outcome().isSuccess() }
foreach b: Observation in bestNightObs {
  IO::println("    " + b.entry().name() + " — " + b.outcome().shortNote())
}

// ─── 12. Recursion: Fibonacci approximation of max observation streak ─────────

def streak(obs: List[Observation], idx: Int, current: Int, best: Int): Int {
  if idx >= obs.size { return if current > best { current } else { best } }
  val o: Observation = obs[idx] as Observation
  val b2: Int = if current > best { current } else { best }
  if o.outcome().isSuccess() {
    return streak(obs, idx + 1, current + 1, b2)
  } else {
    return streak(obs, idx + 1, 0, b2)
  }
}

printHeader("=== Longest Success Streak ===")
val streakLen = streak(observations, 0, 0, 0)
IO::println("  Longest consecutive-success run: " + streakLen + " observations")

IO::println("")
IO::println("=== TelescopeLog complete (" + observations.size + " observations) ===")
