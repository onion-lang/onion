{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Onion",
  "scopeName": "source.onion",
  "patterns": [
    { "include": "#comments" },
    { "include": "#quoted-identifiers" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#scheme-strings" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.onion",
          "match": "//.*$"
        },
        {
          "name": "comment.block.onion",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.onion",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.onion",
              "match": "\\\\."
            },
            {
              "name": "meta.template.expression.onion",
              "begin": "#\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.onion" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.onion" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "scheme-strings": {
      "comment": "Scheme-prefixed RAW string literals: <prefix>\"raw\" desugars to <prefix>(\"raw\"). Raw means a backslash does not escape for the value, but it still does not terminate the literal, so a body escape has to be consumed as a unit. Listed after #keywords/#storage on purpose: the lexer pushes a keyword prefix back (return\"x\" stays keyword + string), and matching keywords first reproduces that.",
      "patterns": [
        {
          "comment": "re\"...\" is a regex literal, so the body is highlighted as a pattern.",
          "name": "string.regexp.onion",
          "begin": "\\b(re)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "entity.name.function.scheme.onion" },
            "2": { "name": "punctuation.definition.string.begin.onion" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.onion" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.regexp.onion",
              "match": "\\\\."
            },
            {
              "name": "constant.other.character-class.set.regexp.onion",
              "match": "\\[\\^?\\]?(\\\\.|[^\\]])*\\]"
            },
            {
              "name": "keyword.operator.quantifier.regexp.onion",
              "match": "[*+?]|\\{[0-9]+(,[0-9]*)?\\}"
            },
            {
              "name": "keyword.operator.or.regexp.onion",
              "match": "\\|"
            },
            {
              "name": "punctuation.definition.group.regexp.onion",
              "match": "\\((\\?[:=!<])?|\\)"
            }
          ]
        },
        {
          "comment": "Any other prefix: file\"...\", http\"...\", json\"...\", sql\"...\", or one the user defined.",
          "name": "string.quoted.double.raw.onion",
          "begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "entity.name.function.scheme.onion" },
            "2": { "name": "punctuation.definition.string.begin.onion" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.onion" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.onion",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "quoted-identifiers": {
      "comment": "Backtick-escaped identifier, which lets a reserved word be used as a name.",
      "patterns": [
        {
          "name": "variable.other.quoted.onion",
          "match": "`[^`]+`"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.onion",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.onion",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.onion",
          "match": "\\b0[xX][0-9a-fA-F_]+[lL]?\\b"
        },
        {
          "name": "constant.numeric.binary.onion",
          "match": "\\b0[bB][01_]+[lL]?\\b"
        },
        {
          "name": "constant.numeric.float.onion",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.integer.onion",
          "match": "\\b[0-9][0-9_]*[lLfFdD]?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.onion",
          "match": "\\b(if|else|while|for|foreach|in|return|break|continue|try|catch|finally|throw|throws|select|case|when|is|do|goto)\\b"
        },
        {
          "name": "keyword.control.monad.onion",
          "match": "\\b(ret)\\b"
        },
        {
          "name": "keyword.other.import.onion",
          "match": "\\b(import|module)\\b"
        },
        {
          "name": "keyword.operator.new.onion",
          "match": "\\b(new)\\b"
        },
        {
          "name": "keyword.operator.cast.onion",
          "match": "\\b(as)\\b"
        },
        {
          "name": "keyword.operator.word.onion",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.other.onion",
          "match": "\\b(extends|conforms|forward)\\b"
        },
        {
          "comment": "Soft keywords. Each is a perfectly good identifier elsewhere, so every rule is pinned to the one shape the parser's lookahead accepts; a bare `tool` or `shape` variable must stay uncoloured.",
          "name": "storage.type.tool.onion",
          "match": "\\b(tool)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*\\()"
        },
        {
          "name": "keyword.other.requires.onion",
          "match": "\\b(requires)\\b(?=\\s*\\{)"
        },
        {
          "name": "storage.type.shape.onion",
          "match": "\\b(shape)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*=)"
        },
        {
          "name": "keyword.other.derive.onion",
          "match": "\\b(derive)\\b(?=!)"
        },
        {
          "name": "keyword.other.law.onion",
          "match": "\\b(law)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*[({])"
        },
        {
          "name": "keyword.other.example.onion",
          "match": "\\b(example)\\b(?=\\s*(\\{|[a-zA-Z_][a-zA-Z0-9_]*\\s*\\{))"
        },
        {
          "comment": "`from` only introduces a pattern-attached record, which is always a scheme literal.",
          "name": "keyword.other.from.onion",
          "match": "\\b(from)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*\")"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.onion",
          "match": "\\b(class|interface|trait|instance|enum|record|extension|type)\\b"
        },
        {
          "name": "storage.modifier.onion",
          "match": "\\b(public|private|protected|internal|static|final|abstract|sealed|override|synchronized|const|volatile)\\b"
        },
        {
          "name": "storage.type.function.onion",
          "match": "\\b(def)\\b"
        },
        {
          "name": "storage.type.variable.onion",
          "match": "\\b(var|val)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.onion",
          "match": "\\b(Int|Long|Short|Byte|Float|Double|Boolean|Char|Unit|void|Void)\\b"
        },
        {
          "name": "support.type.builtin.onion",
          "match": "\\b(String|Object|Array|List|Map|Set|Option|Result|Future)\\b"
        },
        {
          "name": "support.class.onion",
          "match": "\\b(IO|Strings|Rand|Assert|Timing|Files|DateTime|Http|Json|Regex|Math)\\b"
        },
        {
          "name": "entity.name.type.onion",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.onion",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.onion",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.safe-access.onion",
          "match": "\\?\\.|\\?\\[|\\?:|!!"
        },
        {
          "comment": "Must precede the logical and bitwise rules, which would otherwise eat the `|`.",
          "name": "keyword.operator.pipeline.onion",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.onion",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.onion",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.range.onion",
          "match": "(\\.\\.<|\\.\\.)"
        },
        {
          "name": "keyword.operator.arithmetic.onion",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.onion",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|>>>=|=)"
        },
        {
          "name": "keyword.operator.bitwise.onion",
          "match": "(&|\\||\\^|~|<<|>>>|>>)"
        },
        {
          "name": "keyword.operator.access.onion",
          "match": "(::|\\.)"
        },
        {
          "name": "keyword.operator.arrow.onion",
          "match": "(->|=>|<-)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.onion",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.this.onion",
          "match": "\\b(this|self|super)\\b"
        }
      ]
    }
  }
}
